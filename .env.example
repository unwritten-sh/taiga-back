# Environment variables read by docker/config.py.
# The Docker image copies docker/config.py to settings/config.py, so these
# variables only apply to the Docker image (docker/Dockerfile).
# Local development on the host does NOT read them: it uses settings/common.py
# plus settings/config.py (copied from settings/config.py.dev.example by `make dev`).
# Never commit a real .env file (.env is in .gitignore).

# --- Generic ---
DEBUG=False
# Required. Generate a long random value per installation.
TAIGA_SECRET_KEY=
TAIGA_SITES_SCHEME=http
TAIGA_SITES_DOMAIN=localhost:9000
# Optional URL subpath, for example /taiga
TAIGA_SUBPATH=
LANGUAGE_CODE=en-us
# True keeps the username prefix in new project slugs
DEFAULT_PROJECT_SLUG_PREFIX=False
PUBLIC_REGISTER_ENABLED=False

# --- PostgreSQL ---
POSTGRES_DB=taiga
POSTGRES_USER=taiga
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_DISABLE_SERVER_SIDE_CURSORS=False

# --- Sessions ---
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- RabbitMQ (Celery broker and events push backend) ---
RABBITMQ_USER=taiga
RABBITMQ_PASS=
# Hosts used to build the URLs when the *_URL variables are empty
TAIGA_ASYNC_RABBITMQ_HOST=taiga-async-rabbitmq
TAIGA_EVENTS_RABBITMQ_HOST=taiga-events-rabbitmq
# Full URLs, override the values built from the variables above
CELERY_BROKER_URL=
EVENTS_PUSH_BACKEND_URL=
CELERY_ENABLED=True
CELERY_TIMEZONE=Europe/Madrid

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=system@taiga.io
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Webhooks ---
WEBHOOKS_ENABLED=True
WEBHOOKS_ALLOW_PRIVATE_ADDRESS=False
WEBHOOKS_ALLOW_REDIRECTS=False

# --- Telemetry (Rudder, taiga/telemetry/tasks.py) ---
ENABLE_TELEMETRY=True

# --- Contribs (plugins from requirements-contribs.txt) ---
ENABLE_SLACK=False
# GitHub and GitLab login only work when PUBLIC_REGISTER_ENABLED=True
ENABLE_GITHUB_AUTH=False
GITHUB_API_CLIENT_ID=
GITHUB_API_CLIENT_SECRET=
ENABLE_GITLAB_AUTH=False
GITLAB_API_CLIENT_ID=
GITLAB_API_CLIENT_SECRET=
GITLAB_URL=

# --- Importers ---
ENABLE_GITHUB_IMPORTER=False
GITHUB_IMPORTER_CLIENT_ID=
GITHUB_IMPORTER_CLIENT_SECRET=
ENABLE_JIRA_IMPORTER=False
JIRA_IMPORTER_CONSUMER_KEY=
JIRA_IMPORTER_CERT=
JIRA_IMPORTER_PUB_CERT=
ENABLE_TRELLO_IMPORTER=False
TRELLO_IMPORTER_API_KEY=
TRELLO_IMPORTER_SECRET_KEY=
