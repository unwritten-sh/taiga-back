st(_(\"'project' must be an integer value.\"))\n48\t\n49\t        if project_id:\n50\t            queryset = queryset.filter(status__project_id=project_id)\n51\t\n52\t        return super().filter_queryset(request, queryset, view)\n53\t\n54\t\n55\tclass AssignedUsersFilter(filters.BaseRelatedFieldsFilter):\n56\t    filter_name = 'assigned_users'\n57\t    exclude_param_name = 'exclude_assigned_users'\n58\t\n59\t    def _get_queryparams(self, params, mode=''):\n60\t        param_name = self.exclude_param_name if mode == 'exclude' else self.param_name or \\\n61\t                                                                       self.filter_name\n62\t        raw_value = params.get(param_name, None)\n63\t        if raw_value:\n64\t            value = self._prepare_filter_data(raw_value)\n65\t            UserStoryModel = apps.get_model(\"userstories\", \"UserStory\")\n66\t\n67\t            if None in value:\n68\t                value.remove(None)\n69\t                assigned_users_ids = UserStoryModel.objects.order_by().filter(\n70\t                    assigned_users__isnull=True,\n71\t                    id=OuterRef('pk')).values('pk')\n72\t\n73\t                assigned_user_filter_none = Q(pk__in=Subquery(assigned_users_ids))\n74\t                assigned_to_filter_none = Q(assigned_to__isnull=True)\n75\t\n76\t                return (get_assigned_users_filter(UserStoryModel, value)\n77\t                        | Q(assigned_user_filter_none, assigned_to_filter_none))\n78\t            else:\n79\t                return get_assigned_users_filter(UserStoryModel, value)\n80\t\n81\t        return None\n82\t\n83\t\n84\tclass UserStoriesRoleFilter(filters.BaseRelatedFieldsFilter):\n85\t    filter_name = \"role_id\"\n86\t    param_name = \"role\"\n87\t    exclude_param_name = 'exclude_role'\n88\t\n89\t    def filter_queryset(self, request, queryset, view):\n90\t        Membership = apps.get_model('projects', 'Membership')\n91\t\n92\t        operations = {\n93\t            \