{"duration_api_ms":110922,"stop_reason":"tool_use","session_id":"c1b4c1b3-1b18-42b7-bcd9-1825e3fd448d","total_cost_usd":0.8395977999999998,"usage":{"input_tokens":14,"cache_creation_input_tokens":66663,"cache_read_input_tokens":328189,"output_tokens":12030,"output_tokens_details":{"thinking_tokens":704},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":66663,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":10140,"cache_read_input_tokens":65001,"cache_creation_input_tokens":1662,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1662},"type":"message"}],"speed":"standard","fallback_credit":null},"modelUsage":{"claude-opus-5-5":{"inputTokens":14,"outputTokens":12030,"cacheReadInputTokens":328189,"cacheCreationInputTokens":66663,"webSearchRequests":0,"costUSD":0.8395977999999998,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":704,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":66663,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":8,"subtype":"success","api_error_status":null,"result":"{\"project\":{\"name\":\"Taiga Backend (taiga-back)\",\"one_liner\":\"Django REST API backend of Taiga, an open-source agile project management platform (Scrum and Kanban).\",\"value_proposition\":\"Taiga lets agile teams plan and track work with backlogs, sprints, Kanban boards, epics, user stories, tasks, issues and wikis. This repository is the API server that stores all project data, enforces permissions, sends notifications and webhooks, and imports projects from other tools (Jira, Trello, Asana, GitHub). Self-hosters run it with Docker; the public SaaS is tree.taiga.io.\",\"users\":[\"Project members (developers, product owners, scrum masters) using the Taiga web front end through this API\",\"Project administrators who configure roles, memberships, statuses and custom attributes\",\"Instance administrators who self-host Taiga (Django admin, sample data, management commands)\",\"External systems: Git hosting webhooks (GitHub, GitLab, Bitbucket, Gogs) and webhook consumers\",\"Front-end and third-party API clients (application tokens)\"],\"use_cases\":[{\"name\":\"Authentication and accounts\",\"description\":\"Login, registration, JWT refresh tokens, password recovery, invitation acceptance and user profile management.\",\"entry_points\":[\"taiga/routers.py: /api/v1/auth -> taiga/auth/api.py AuthViewSet\",\"/api/v1/users -> taiga/users/api.py UsersViewSet\",\"taiga/auth/tokens.py\",\"taiga/auth/token_denylist/\"]},{\"name\":\"Project and membership management\",\"description\":\"Create projects from templates (Scrum/Kanban), manage memberships, invitations, roles, statuses, points, swimlanes and due dates.\",\"entry_points\":[\"/api/v1/projects -> taiga/projects/api.py ProjectViewSet\",\"/api/v1/memberships, /api/v1/invitations\",\"/api/v1/project-templates\",\"taiga/projects/models.py\"]},{\"name\":\"Backlog, sprints and Kanban\",\"description\":\"Manage user stories, milestones (sprints), tasks, ordering in backlog and Kanban, epics and tags.\",\"entry_points\":[\"taiga/projects/userstories/\",\"taiga/projects/milestones/\",\"taiga/projects/tasks/\",\"taiga/projects/epics/\",\"tests/integration/test_userstories_update_kanban_order.py\"]},{\"name\":\"Issues, wiki and attachments\",\"description\":\"Track issues with priorities/severities, write wiki pages with Markdown rendering, upload attachments.\",\"entry_points\":[\"taiga/projects/issues/\",\"taiga/projects/wiki/\",\"taiga/projects/attachments/\",\"taiga/mdrender/\"]},{\"name\":\"Notifications, history and timeline\",\"description\":\"Record change history of every object, notify watchers by email and web notifications, build user and project timelines.\",\"entry_points\":[\"taiga/projects/history/\",\"taiga/projects/notifications/\",\"taiga/timeline/\",\"/api/v1/web-notifications\",\"/api/v1/notify-policies\"]},{\"name\":\"Real-time events and webhooks\",\"description\":\"Push change events to taiga-events (via PostgreSQL or RabbitMQ backend) and send outgoing webhooks to configured URLs.\",\"entry_points\":[\"taiga/events/events.py\",\"taiga/events/backends/rabbitmq.py\",\"taiga/events/backends/postgresql.py\",\"taiga/webhooks/\"]},{\"name\":\"Git hosting integrations (incoming hooks)\",\"description\":\"Receive push/issue events from GitHub, GitLab, Bitbucket and Gogs to change status of stories, tasks and issues from commit messages.\",\"entry_points\":[\"taiga/hooks/github/\",\"taiga/hooks/gitlab/\",\"taiga/hooks/bitbucket/\",\"taiga/hooks/gogs/\"]},{\"name\":\"Import and export\",\"description\":\"Import projects from Jira, Trello, Asana, GitHub and Pivotal; export and import Taiga project dumps.\",\"entry_points\":[\"taiga/importers/jira/\",\"taiga/importers/trello/\",\"taiga/importers/asana/\",\"taiga/importers/github/\",\"taiga/export_import/\"]},{\"name\":\"Search, stats and telemetry\",\"description\":\"Search inside a project, compute project/system stats, send daily anonymous telemetry via Rudder (Celery beat).\",\"entry_points\":[\"taiga/searches/\",\"taiga/stats/\",\"taiga/telemetry/tasks.py\",\"taiga/celery.py: beat_schedule send-telemetry-once-a-day\"]},{\"name\":\"Local sample data\",\"description\":\"Reset the database and load an initial admin user, project templates and generated sample data.\",\"entry_points\":[\"regenerate.sh\",\"taiga/projects/management/commands/sample_data.py\",\"manage.py loaddata initial_user / initial_project_templates\"]}],\"glossary\":[{\"term\":\"US / user story\",\"meaning\":\"Unit of backlog work (taiga/projects/userstories).\"},{\"term\":\"Milestone\",\"meaning\":\"A sprint in Scrum projects (taiga/projects/milestones).\"},{\"term\":\"Epic\",\"meaning\":\"Group of related user stories (taiga/projects/epics).\"},{\"term\":\"Swimlane\",\"meaning\":\"Horizontal lane on a Kanban board (/api/v1/swimlanes).\"},{\"term\":\"Points\",\"meaning\":\"Story-point estimation values per role.\"},{\"term\":\"Fan / watcher / vote / like\",\"meaning\":\"Ways a user follows or supports a project or item (taiga/projects/votes, likes, notifications).\"},{\"term\":\"OCC\",\"meaning\":\"Optimistic concurrency control on edits (taiga/projects/occ).\"},{\"term\":\"Timeline\",\"meaning\":\"Activity feed for users and projects (taiga/timeline).\"},{\"term\":\"Taiga events\",\"meaning\":\"Separate real-time service that receives pushes from taiga/events backends (not in this repository).\"},{\"term\":\"Contribs\",\"meaning\":\"Optional plugins (Slack, GitHub/GitLab auth, protected) installed from requirements-contribs.txt.\"},{\"term\":\"Kaleidos INC\",\"meaning\":\"Company that owns the Taiga copyright (license headers, CONTRIBUTING.md).\"},{\"term\":\"INSTANCE_TYPE\",\"meaning\":\"Setting naming the installation type, 'SRC' in settings/common.py (used by telemetry).\"}]},\"stack\":{\"languages\":[\"Python 3.10 (.python-version, CI); Docker image uses Python 3.11\",\"Shell\"],\"frameworks\":[\"Django 3.2.25 (requirements.txt)\",\"Taiga's own REST layer in taiga/base/api (DRF-like ViewSets and routers)\",\"Celery 5.5.3\",\"gunicorn 23\",\"django-jinja\",\"pytest 7.2.1 + pytest-django + factory-boy 3.2.1\"],\"datastores\":[\"PostgreSQL (settings/common.py DATABASES, CI uses postgres:13)\",\"Django local-memory cache (settings/common.py CACHES)\",\"Local filesystem media (MEDIA_ROOT)\"],\"external_services\":[\"RabbitMQ as Celery broker and events push backend (docker/config.py, CI service)\",\"taiga-events real-time service (separate, not in repository)\",\"SMTP email (docker/config.py EMAIL_*)\",\"Rudder telemetry (taiga/telemetry/tasks.py)\",\"Jira, Trello, Asana, GitHub APIs (taiga/importers)\",\"GitHub, GitLab, Bitbucket, Gogs incoming webhooks (taiga/hooks)\",\"Coveralls (CI)\"]},\"architecture\":{\"components\":[{\"name\":\"API web app\",\"kind\":\"web/api\",\"path\":\"taiga/ (taiga/urls.py, taiga/routers.py, taiga/wsgi.py)\",\"tech\":\"Django 3.2 + gunicorn\",\"description\":\"REST API under /api/v1/ with about 80 router registrations, plus Django admin at /admin/ and optional front sitemap. Started by docker/entrypoint.sh (migrate, loaddata, gunicorn on :8000).\"},{\"name\":\"Celery worker and beat\",\"kind\":\"worker/scheduler\",\"path\":\"taiga/celery.py, docker/async_entrypoint.sh\",\"tech\":\"Celery 5 with RabbitMQ broker\",\"description\":\"Runs async tasks (bulk emails, exports, imports, telemetry, token flush). Beat schedule is built in taiga/celery.py. Disabled in tests (CELERY_ENABLED=False).\"},{\"name\":\"Domain apps\",\"kind\":\"library\",\"path\":\"taiga/projects, taiga/users, taiga/auth, taiga/timeline, taiga/webhooks, taiga/hooks, taiga/importers, taiga/export_import, taiga/searches, taiga/stats\",\"tech\":\"Django apps\",\"description\":\"Models, services, serializers, validators, permissions and API viewsets per domain.\"},{\"name\":\"Base framework\",\"kind\":\"library\",\"path\":\"taiga/base\",\"tech\":\"Python\",\"description\":\"Own REST framework layer (api, routers, filters, throttling, exceptions), DB helpers, mail connectors, management commands.\"},{\"name\":\"Events push\",\"kind\":\"integration\",\"path\":\"taiga/events\",\"tech\":\"PostgreSQL NOTIFY or RabbitMQ backends\",\"description\":\"Publishes change events consumed by the separate taiga-events service.\"},{\"name\":\"Settings\",\"kind\":\"config\",\"path\":\"settings/ (common.py, config.py.dev.example, config.py.prod.example), docker/config.py, tests/config.py\",\"tech\":\"Django settings modules\",\"description\":\"common.py holds defaults; docker/config.py reads environment variables and is copied to settings/config.py in the image; tests/config.py is the pytest settings.\"},{\"name\":\"PostgreSQL\",\"kind\":\"database\",\"path\":\"settings/common.py DATABASES\",\"tech\":\"PostgreSQL 13 in CI\",\"description\":\"Main data store, also used for DB sessions and the postgresql events backend.\"},{\"name\":\"RabbitMQ\",\"kind\":\"queue\",\"path\":\"docker/config.py CELERY_BROKER_URL, EVENTS_PUSH_BACKEND_URL\",\"tech\":\"AMQP\",\"description\":\"Celery broker and events transport in the Docker deployment.\"},{\"name\":\"Docker image\",\"kind\":\"build artifact\",\"path\":\"docker/Dockerfile\",\"tech\":\"python:3.11-slim\",\"description\":\"Single image for API (entrypoint.sh) and async worker (async_entrypoint.sh). No compose file in this repository.\"},{\"name\":\"Tests\",\"kind\":\"tests\",\"path\":\"tests/ (unit, integration, integration/resources_permissions)\",\"tech\":\"pytest + pytest-django + factory-boy\",\"description\":\"About 120 test files; need a running PostgreSQL.\"}],\"mermaid\":\"flowchart LR\\n  client[\\\"Taiga front / API clients\\\"] --> api[\\\"Django API (gunicorn)\\\"]\\n  githooks[\\\"Git hosting webhooks\\\"] --> api\\n  api --> pg[(\\\"PostgreSQL\\\")]\\n  api --> rmq[\\\"RabbitMQ\\\"]\\n  rmq --> worker[\\\"Celery worker + beat\\\"]\\n  worker --> pg\\n  api --> events[\\\"taiga-events (external)\\\"]\\n  rmq --> events\\n  worker --> smtp[\\\"SMTP email\\\"]\\n  worker --> rudder[\\\"Rudder telemetry\\\"]\\n  api --> importers[\\\"Jira / Trello / Asana / GitHub APIs\\\"]\\n  api --> outhooks[\\\"Outgoing webhooks\\\"]\"},\"workflows\":{\"setup\":\"./scripts/install\",\"run_local\":null,\"test\":\"pytest\",\"lint\":\"tox -e flake8\",\"build\":null,\"deploy\":null},\"requirements\":[{\"id\":\"agents-file\",\"status\":\"fail\",\"evidence\":[\"No AGENTS.md or CLAUDE.md at repository root\"],\"gap\":\"No agent entry file exists.\",\"plan\":\"Create AGENTS.md (<150 lines) with what this is, commands (make setup, make dev, make check-fast, make check), layout (taiga/, settings/, tests/, docker/, scripts/), conventions (conventional commits, MPL header, flake8 max-line 120), verification, never-do list, links to docs/. Create CLAUDE.md containing only `@AGENTS.md`.\"},{\"id\":\"agents-file-accurate\",\"status\":\"fail\",\"evidence\":[\"No AGENTS.md to check\"],\"gap\":\"Nothing to verify yet.\",\"plan\":\"Only reference Makefile targets created in the same change and relative links to docs that are created (docs/architecture.md, docs/product.md, docs/local-dev.md, docs/deploy.md, docs/observability.md).\"},{\"id\":\"architecture\",\"status\":\"fail\",\"evidence\":[\"docs/ only holds update-dependencies.md\"],\"gap\":\"No architecture document.\",\"plan\":\"Create docs/architecture.md with the Mermaid flowchart (API, Celery, PostgreSQL, RabbitMQ, taiga-events, SMTP, importers, hooks), a section per component with folders (taiga/routers.py, taiga/celery.py, taiga/events/backends, settings/, docker/), and state that taiga-events and the front end live in other repositories.\"},{\"id\":\"product\",\"status\":\"partial\",\"evidence\":[\"README.md has 47 lines and only links to external docs\"],\"gap\":\"No docs/product.md describing value, users and use cases tied to code.\",\"plan\":\"Create docs/product.md with value proposition, roles, the use cases with entry points (routers.py prefixes, app folders, regenerate.sh) and the glossary (user story, milestone, epic, swimlane, OCC, timeline, contribs).\"},{\"id\":\"decisions\",\"status\":\"fail\",\"evidence\":[\"No docs/decisions/ or docs/adr/\"],\"gap\":\"No decision records.\",\"plan\":\"Create docs/decisions/0001-record-architecture-decisions.md and 0002 for an inferred decision, for example Celery with RabbitMQ and pickle serializer, or pluggable events backends (taiga/events/backends), marked 'Inferred from the code, to be confirmed by the team.'\"},{\"id\":\"implementation-log\",\"status\":\"partial\",\"evidence\":[\"CHANGELOG.md exists (26 KB), no docs/harness/log.md\"],\"gap\":\"No harness implementation log.\",\"plan\":\"Create docs/harness/log.md with a first dated entry (2026-11-01) and tell agents in AGENTS.md to append one entry per significant change.\"},{\"id\":\"agreements\",\"status\":\"pass\",\"evidence\":[\"CONTRIBUTING.md: conventional commits, DCO + license, Weblate for translations\"],\"gap\":\"None for the check. It does not state branch or review rules or a definition of done.\",\"plan\":\"nothing (optionally add a short section on PR flow and definition of done including make check-fast, marked as proposed).\"},{\"id\":\"task-runner\",\"status\":\"fail\",\"evidence\":[\"No Makefile, justfile or Taskfile; tox.ini and scripts/install, scripts/upgrade exist\"],\"gap\":\"No single task entry point.\",\"plan\":\"Add a Makefile with help (default), setup (wrap ./scripts/install), dev (.venv/bin/python manage.py runserver), db-reset (./regenerate.sh -y), test (.venv/bin/pytest), lint (.venv/bin/flake8 .; add flake8 to dev deps or use tox -e flake8), check-fast, check, each with a ## comment.\"},{\"id\":\"fast-gate\",\"status\":\"fail\",\"evidence\":[\"No check-fast target\"],\"gap\":\"No fast gate; tests need PostgreSQL (tests/config.py DATABASES localhost taiga/taiga).\",\"plan\":\"Add `check-fast`: flake8 plus `pytest tests/unit -q`. Verify which unit tests need the DB (pytest-django marks); the target must work after `make setup` with the compose PostgreSQL running. Skip existing failing tests with a reason and record them in docs/harness/log.md.\"},{\"id\":\"full-gate\",\"status\":\"fail\",\"evidence\":[\"No check target; CI runs coverage run ... -m pytest in .github/workflows/tests-and-coverall.yml\"],\"gap\":\"No full gate matching CI.\",\"plan\":\"Add `check`: lint + `python manage.py makemigrations --check --dry-run` (settings tests.config) + full pytest with the same coverage command as CI. Make CI call `make check`.\"},{\"id\":\"tests\",\"status\":\"pass\",\"evidence\":[\"tests/unit (15 files), tests/integration (~70 files), tests/integration/resources_permissions; pytest.ini sets DJANGO_SETTINGS_MODULE=tests.config\"],\"gap\":\"None for the check. Tests require a PostgreSQL database.\",\"plan\":\"nothing (document in AGENTS.md how to run one test: `.venv/bin/pytest tests/unit/test_slug.py::...`).\"},{\"id\":\"ci\",\"status\":\"partial\",\"evidence\":[\".github/workflows/tests-and-coverall.yml runs on push and pull_request to main with postgres:13 and rabbitmq services, calls pytest directly\"],\"gap\":\"CI does not call the task runner and does not run flake8.\",\"plan\":\"Change the test step to `make check` (keep coverage and Coveralls), add a job step running `npx -y uw-harness verify` with Node 20. Keep the postgres and rabbitmq services and the GITHUB_WORKFLOW DB switch in tests/config.py.\"},{\"id\":\"hooks\",\"status\":\"fail\",\"evidence\":[\"No .pre-commit-config.yaml, .husky, lefthook.yml or .githooks\"],\"gap\":\"No git hooks.\",\"plan\":\"Add .pre-commit-config.yaml with a flake8 hook and a pre-push local hook running `make check-fast`; install it from `make setup` (pre-commit install --hook-type pre-push). Add pre-commit to requirements-devel.in.\"},{\"id\":\"local-env\",\"status\":\"fail\",\"evidence\":[\"No compose file or devcontainer; settings/config.py.dev.example and regenerate.sh exist\"],\"gap\":\"Data stores must be installed by hand and there is no dev target.\",\"plan\":\"Add compose.yaml with postgres:13 (user/pass/db taiga as in settings/common.py and tests/config.py) and rabbitmq; Makefile `dev` (copy settings/config.py.dev.example to settings/config.py if missing, runserver) and `db-reset` (./regenerate.sh -y with defaults). Write docs/local-dev.md (prerequisites: Python 3.10, libpq, libmagic, gettext; first run; reset; debugging; admin/123123 sample user).\"},{\"id\":\"env-example\",\"status\":\"fail\",\"evidence\":[\"No .env.example\",\"No .env tracked (git ls-files)\",\"settings/common.py:249 hard-codes SECRET_KEY = \\\"aw3+t2r(8(0kkrhg8)gx6i96v5^kv%6cfep9wxfom0%7dy0m9e\\\"\",\"settings/common.py DATABASES PASSWORD 'taiga'; docker/config.py defaults EMAIL_HOST_PASSWORD 'password'\"],\"gap\":\"No example env file, and the default settings contain a hard-coded SECRET_KEY and passwords that the secret scan will flag even after .env.example exists.\",\"plan\":\"Create .env.example listing every os.getenv variable of docker/config.py (POSTGRES_*, TAIGA_SECRET_KEY, TAIGA_SITES_*, RABBITMQ_*, CELERY_*, EMAIL_*, ENABLE_* importers/contribs, WEBHOOKS_*, ENABLE_TELEMETRY) with safe empty values. Report the hard-coded SECRET_KEY in settings/common.py to a human; do not change settings behaviour silently.\"},{\"id\":\"toolchain-pinned\",\"status\":\"pass\",\"evidence\":[\".python-version: 3.10\",\"CI matrix python-version 3.10\"],\"gap\":\"Docker image uses python:3.11-slim, which differs from the pinned 3.10.\",\"plan\":\"nothing (mention the 3.10 vs 3.11 difference in docs/local-dev.md and AGENTS.md).\"},{\"id\":\"deploy-explicit\",\"status\":\"partial\",\"evidence\":[\"docker/Dockerfile, docker/entrypoint.sh (migrate, loaddata, gunicorn :8000), docker/async_entrypoint.sh (celery worker -B)\",\"No deploy workflow in .github/workflows\"],\"gap\":\"No deploy document; how images are built, published and deployed (tree.taiga.io, Docker Hub) is not visible in the repository.\",\"plan\":\"Create docs/deploy.md with what the repo shows (image build, entrypoints, env vars from docker/config.py, migrations on start) and uw-harness TODO blocks for registry, environments, release process, rollback and who deploys.\"},{\"id\":\"observability\",\"status\":\"fail\",\"evidence\":[\"settings/common.py LOGGING dict\",\"gunicorn --access-logfile - and --log-level=info in docker/entrypoint.sh\",\"sentry-sdk in requirements.txt but no sentry_sdk usage in taiga/, settings/ or docker/\",\"Telemetry via Rudder in taiga/telemetry/tasks.py\"],\"gap\":\"No observability document; no health endpoint or error reporting is configured in the code.\",\"plan\":\"Create docs/observability.md: logging config (settings/common.py LOGGING, stdout in Docker), gunicorn access logs, Celery logs, no health endpoint (suggest /api/v1/ answer as liveness), sentry-sdk installed but unused, plus TODO blocks for where logs, dashboards and alerts live.\"},{\"id\":\"skills\",\"status\":\"fail\",\"evidence\":[\"No .agents/skills or .claude/skills\"],\"gap\":\"No skills.\",\"plan\":\"Create .agents/skills/implement-change, debug-local (compose DB, regenerate.sh, runserver, pytest -k, pdb), add-api-endpoint (viewset in app api.py + register in taiga/routers.py + permissions + integration test in tests/integration/resources_permissions), and deploy as a pointer to docs/deploy.md TODOs. Symlink .claude/skills -> .agents/skills.\"}],\"questions\":[{\"requirement\":\"deploy-explicit\",\"question\":\"How does a merged change reach production (tree.taiga.io and the public taiga-back Docker image): who builds and pushes the image, to which registry, and from which repository or pipeline?\",\"why\":\"No deploy workflow or registry is visible; docker/Dockerfile is the only artifact.\"},{\"requirement\":\"deploy-explicit\",\"question\":\"Which environments exist (staging, production, on-premise customers) and how is a release rolled back, given that docker/entrypoint.sh runs migrations on start?\",\"why\":\"Rollback with automatic migrations needs a human-defined procedure.\"},{\"requirement\":\"observability\",\"question\":\"Where are production logs, metrics and alerts for the API and Celery workers, and is Sentry (sentry-sdk is a dependency) configured somewhere outside this repository?\",\"why\":\"The code has no Sentry init and no health endpoint; log location is not visible.\"},{\"requirement\":\"observability\",\"question\":\"What is the signal that production is broken (health check URL, key metric, alert channel)?\",\"why\":\"Needed for the 'how to tell something is wrong' section.\"},{\"requirement\":\"agreements\",\"question\":\"What is the team's definition of done and review rule (number of approvals, who can merge to main, squash or merge commits)?\",\"why\":\"History shows merge commits from PRs and conventional commits, but no written review rule.\"},{\"requirement\":\"env-example\",\"question\":\"Is the SECRET_KEY hard-coded in settings/common.py used by any real installation, and should it be replaced by an environment variable?\",\"why\":\"It is a secret-looking value in tracked code; only the team can decide on rotation and change.\"},{\"requirement\":\"local-env\",\"question\":\"Which local setup do developers actually use today (local PostgreSQL, the taiga-docker repository, or something else), and should the new compose.yaml include RabbitMQ and taiga-events?\",\"why\":\"The repository shows no compose file; the dev flow is not documented.\"}],\"risks\":[\"Tests need a running PostgreSQL (tests/config.py: localhost, user/pass taiga; or postgres/postgres when GITHUB_WORKFLOW is set). The fast gate will fail without the database.\",\"Hard-coded SECRET_KEY in settings/common.py line 249 and default DB/email passwords: the env-example secret scan will report partial until a human decides.\",\"Django 3.2.25 is end-of-life; several pins exist only to stay compatible (bleach<5, django-picklefield<3.3, easy-thumbnails<2.9). Upgrades can break installation.\",\"Python mismatch: .python-version and CI use 3.10, Docker image uses 3.11.\",\"System libraries needed to install requirements (libpq-dev for psycopg2, libmagic for python-magic, cairo for cairosvg, gettext for compilemessages) are not documented.\",\"flake8 is not in requirements-devel.txt; lint only runs through tox (tox -e flake8), and CI does not lint at all, so the current code may not pass flake8.\",\"requirements-contribs.txt installs plugins from GitHub over the network; it must stay out of the gates.\",\"Celery uses pickle serialization (settings/common.py, docker/config.py); a security-sensitive decision to document, not change.\",\"sentry-sdk and rudder-sdk-python (pre-release 1.0.0b1) are dependencies; sentry is not initialised in code, which may mislead the observability doc.\",\"regenerate.sh drops the database and is interactive; never run it in a gate without -y and a local DB.\",\"11 test files contain no tests (stubs such as tests/models.py); do not count them as coverage.\"],\"notes_for_apply\":\"Runtime: Python 3.10 (.python-version, CI). Install with ./scripts/install, which creates .venv and installs requirements.txt + requirements-devel.txt; add a Makefile wrapping it instead of changing it. Requirements are pip-tools compiled (*.in -> *.txt via scripts/upgrade): if you add dev tools (flake8, pre-commit), add them to requirements-devel.in and regenerate requirements-devel.txt with pip-compile, keeping the `-c requirements.txt` constraint. Tests use pytest with DJANGO_SETTINGS_MODULE=tests.config (pytest.ini) and need PostgreSQL on localhost:5432 with db/user/password taiga; provide compose.yaml with postgres:13 matching those values so `make check-fast` works locally. CI sets GITHUB_WORKFLOW so tests/config.py switches to postgres/postgres; keep that behaviour and keep the rabbitmq service in CI. Full gate should reproduce the CI command: `coverage run --source=taiga --omit='*tests*,*commands*,*migrations*,*admin*,*.jinja,*dashboard*,*settings*,*wsgi*,*questions*,*documents*' -m pytest -v --tb=native --pythonwarnings=default`. Lint with flake8 using setup.cfg (max-line-length 120, excludes tests, migrations, management); run it once before putting it in the fast gate and record existing violations rather than mass-reformatting. Local run: copy settings/config.py.dev.example to settings/config.py (gitignored, check .gitignore) and use `python manage.py runserver`; regenerate.sh -y loads admin/123123 and sample data. Do not touch: migrations folders, taiga/locale (*.po managed by Weblate), the MPL license headers, docker/config.py env semantics, requirements-contribs.txt, the hard-coded SECRET_KEY (report it instead). Commit style is conventional commits (CONTRIBUTING.md, recent history: fix:, test:, chore:). Write all new docs in simple English without em-dashes.\"}","structured_output":{"project":{"name":"Taiga Backend (taiga-back)","one_liner":"Django REST API backend of Taiga, an open-source agile project management platform (Scrum and Kanban).","value_proposition":"Taiga lets agile teams plan and track work with backlogs, sprints, Kanban boards, epics, user stories, tasks, issues and wikis. This repository is the API server that stores all project data, enforces permissions, sends notifications and webhooks, and imports projects from other tools (Jira, Trello, Asana, GitHub). Self-hosters run it with Docker; the public SaaS is tree.taiga.io.","users":["Project members (developers, product owners, scrum masters) using the Taiga web front end through this API","Project administrators who configure roles, memberships, statuses and custom attributes","Instance administrators who self-host Taiga (Django admin, sample data, management commands)","External systems: Git hosting webhooks (GitHub, GitLab, Bitbucket, Gogs) and webhook consumers","Front-end and third-party API clients (application tokens)"],"use_cases":[{"name":"Authentication and accounts","description":"Login, registration, JWT refresh tokens, password recovery, invitation acceptance and user profile management.","entry_points":["taiga/routers.py: /api/v1/auth -> taiga/auth/api.py AuthViewSet","/api/v1/users -> taiga/users/api.py UsersViewSet","taiga/auth/tokens.py","taiga/auth/token_denylist/"]},{"name":"Project and membership management","description":"Create projects from templates (Scrum/Kanban), manage memberships, invitations, roles, statuses, points, swimlanes and due dates.","entry_points":["/api/v1/projects -> taiga/projects/api.py ProjectViewSet","/api/v1/memberships, /api/v1/invitations","/api/v1/project-templates","taiga/projects/models.py"]},{"name":"Backlog, sprints and Kanban","description":"Manage user stories, milestones (sprints), tasks, ordering in backlog and Kanban, epics and tags.","entry_points":["taiga/projects/userstories/","taiga/projects/milestones/","taiga/projects/tasks/","taiga/projects/epics/","tests/integration/test_userstories_update_kanban_order.py"]},{"name":"Issues, wiki and attachments","description":"Track issues with priorities/severities, write wiki pages with Markdown rendering, upload attachments.","entry_points":["taiga/projects/issues/","taiga/projects/wiki/","taiga/projects/attachments/","taiga/mdrender/"]},{"name":"Notifications, history and timeline","description":"Record change history of every object, notify watchers by email and web notifications, build user and project timelines.","entry_points":["taiga/projects/history/","taiga/projects/notifications/","taiga/timeline/","/api/v1/web-notifications","/api/v1/notify-policies"]},{"name":"Real-time events and webhooks","description":"Push change events to taiga-events (via PostgreSQL or RabbitMQ backend) and send outgoing webhooks to configured URLs.","entry_points":["taiga/events/events.py","taiga/events/backends/rabbitmq.py","taiga/events/backends/postgresql.py","taiga/webhooks/"]},{"name":"Git hosting integrations (incoming hooks)","description":"Receive push/issue events from GitHub, GitLab, Bitbucket and Gogs to change status of stories, tasks and issues from commit messages.","entry_points":["taiga/hooks/github/","taiga/hooks/gitlab/","taiga/hooks/bitbucket/","taiga/hooks/gogs/"]},{"name":"Import and export","description":"Import projects from Jira, Trello, Asana, GitHub and Pivotal; export and import Taiga project dumps.","entry_points":["taiga/importers/jira/","taiga/importers/trello/","taiga/importers/asana/","taiga/importers/github/","taiga/export_import/"]},{"name":"Search, stats and telemetry","description":"Search inside a project, compute project/system stats, send daily anonymous telemetry via Rudder (Celery beat).","entry_points":["taiga/searches/","taiga/stats/","taiga/telemetry/tasks.py","taiga/celery.py: beat_schedule send-telemetry-once-a-day"]},{"name":"Local sample data","description":"Reset the database and load an initial admin user, project templates and generated sample data.","entry_points":["regenerate.sh","taiga/projects/management/commands/sample_data.py","manage.py loaddata initial_user / initial_project_templates"]}],"glossary":[{"term":"US / user story","meaning":"Unit of backlog work (taiga/projects/userstories)."},{"term":"Milestone","meaning":"A sprint in Scrum projects (taiga/projects/milestones)."},{"term":"Epic","meaning":"Group of related user stories (taiga/projects/epics)."},{"term":"Swimlane","meaning":"Horizontal lane on a Kanban board (/api/v1/swimlanes)."},{"term":"Points","meaning":"Story-point estimation values per role."},{"term":"Fan / watcher / vote / like","meaning":"Ways a user follows or supports a project or item (taiga/projects/votes, likes, notifications)."},{"term":"OCC","meaning":"Optimistic concurrency control on edits (taiga/projects/occ)."},{"term":"Timeline","meaning":"Activity feed for users and projects (taiga/timeline)."},{"term":"Taiga events","meaning":"Separate real-time service that receives pushes from taiga/events backends (not in this repository)."},{"term":"Contribs","meaning":"Optional plugins (Slack, GitHub/GitLab auth, protected) installed from requirements-contribs.txt."},{"term":"Kaleidos INC","meaning":"Company that owns the Taiga copyright (license headers, CONTRIBUTING.md)."},{"term":"INSTANCE_TYPE","meaning":"Setting naming the installation type, 'SRC' in settings/common.py (used by telemetry)."}]},"stack":{"languages":["Python 3.10 (.python-version, CI); Docker image uses Python 3.11","Shell"],"frameworks":["Django 3.2.25 (requirements.txt)","Taiga's own REST layer in taiga/base/api (DRF-like ViewSets and routers)","Celery 5.5.3","gunicorn 23","django-jinja","pytest 7.2.1 + pytest-django + factory-boy 3.2.1"],"datastores":["PostgreSQL (settings/common.py DATABASES, CI uses postgres:13)","Django local-memory cache (settings/common.py CACHES)","Local filesystem media (MEDIA_ROOT)"],"external_services":["RabbitMQ as Celery broker and events push backend (docker/config.py, CI service)","taiga-events real-time service (separate, not in repository)","SMTP email (docker/config.py EMAIL_*)","Rudder telemetry (taiga/telemetry/tasks.py)","Jira, Trello, Asana, GitHub APIs (taiga/importers)","GitHub, GitLab, Bitbucket, Gogs incoming webhooks (taiga/hooks)","Coveralls (CI)"]},"architecture":{"components":[{"name":"API web app","kind":"web/api","path":"taiga/ (taiga/urls.py, taiga/routers.py, taiga/wsgi.py)","tech":"Django 3.2 + gunicorn","description":"REST API under /api/v1/ with about 80 router registrations, plus Django admin at /admin/ and optional front sitemap. Started by docker/entrypoint.sh (migrate, loaddata, gunicorn on :8000)."},{"name":"Celery worker and beat","kind":"worker/scheduler","path":"taiga/celery.py, docker/async_entrypoint.sh","tech":"Celery 5 with RabbitMQ broker","description":"Runs async tasks (bulk emails, exports, imports, telemetry, token flush). Beat schedule is built in taiga/celery.py. Disabled in tests (CELERY_ENABLED=False)."},{"name":"Domain apps","kind":"library","path":"taiga/projects, taiga/users, taiga/auth, taiga/timeline, taiga/webhooks, taiga/hooks, taiga/importers, taiga/export_import, taiga/searches, taiga/stats","tech":"Django apps","description":"Models, services, serializers, validators, permissions and API viewsets per domain."},{"name":"Base framework","kind":"library","path":"taiga/base","tech":"Python","description":"Own REST framework layer (api, routers, filters, throttling, exceptions), DB helpers, mail connectors, management commands."},{"name":"Events push","kind":"integration","path":"taiga/events","tech":"PostgreSQL NOTIFY or RabbitMQ backends","description":"Publishes change events consumed by the separate taiga-events service."},{"name":"Settings","kind":"config","path":"settings/ (common.py, config.py.dev.example, config.py.prod.example), docker/config.py, tests/config.py","tech":"Django settings modules","description":"common.py holds defaults; docker/config.py reads environment variables and is copied to settings/config.py in the image; tests/config.py is the pytest settings."},{"name":"PostgreSQL","kind":"database","path":"settings/common.py DATABASES","tech":"PostgreSQL 13 in CI","description":"Main data store, also used for DB sessions and the postgresql events backend."},{"name":"RabbitMQ","kind":"queue","path":"docker/config.py CELERY_BROKER_URL, EVENTS_PUSH_BACKEND_URL","tech":"AMQP","description":"Celery broker and events transport in the Docker deployment."},{"name":"Docker image","kind":"build artifact","path":"docker/Dockerfile","tech":"python:3.11-slim","description":"Single image for API (entrypoint.sh) and async worker (async_entrypoint.sh). No compose file in this repository."},{"name":"Tests","kind":"tests","path":"tests/ (unit, integration, integration/resources_permissions)","tech":"pytest + pytest-django + factory-boy","description":"About 120 test files; need a running PostgreSQL."}],"mermaid":"flowchart LR\n  client[\"Taiga front / API clients\"] --> api[\"Django API (gunicorn)\"]\n  githooks[\"Git hosting webhooks\"] --> api\n  api --> pg[(\"PostgreSQL\")]\n  api --> rmq[\"RabbitMQ\"]\n  rmq --> worker[\"Celery worker + beat\"]\n  worker --> pg\n  api --> events[\"taiga-events (external)\"]\n  rmq --> events\n  worker --> smtp[\"SMTP email\"]\n  worker --> rudder[\"Rudder telemetry\"]\n  api --> importers[\"Jira / Trello / Asana / GitHub APIs\"]\n  api --> outhooks[\"Outgoing webhooks\"]"},"workflows":{"setup":"./scripts/install","run_local":null,"test":"pytest","lint":"tox -e flake8","build":null,"deploy":null},"requirements":[{"id":"agents-file","status":"fail","evidence":["No AGENTS.md or CLAUDE.md at repository root"],"gap":"No agent entry file exists.","plan":"Create AGENTS.md (<150 lines) with what this is, commands (make setup, make dev, make check-fast, make check), layout (taiga/, settings/, tests/, docker/, scripts/), conventions (conventional commits, MPL header, flake8 max-line 120), verification, never-do list, links to docs/. Create CLAUDE.md containing only `@AGENTS.md`."},{"id":"agents-file-accurate","status":"fail","evidence":["No AGENTS.md to check"],"gap":"Nothing to verify yet.","plan":"Only reference Makefile targets created in the same change and relative links to docs that are created (docs/architecture.md, docs/product.md, docs/local-dev.md, docs/deploy.md, docs/observability.md)."},{"id":"architecture","status":"fail","evidence":["docs/ only holds update-dependencies.md"],"gap":"No architecture document.","plan":"Create docs/architecture.md with the Mermaid flowchart (API, Celery, PostgreSQL, RabbitMQ, taiga-events, SMTP, importers, hooks), a section per component with folders (taiga/routers.py, taiga/celery.py, taiga/events/backends, settings/, docker/), and state that taiga-events and the front end live in other repositories."},{"id":"product","status":"partial","evidence":["README.md has 47 lines and only links to external docs"],"gap":"No docs/product.md describing value, users and use cases tied to code.","plan":"Create docs/product.md with value proposition, roles, the use cases with entry points (routers.py prefixes, app folders, regenerate.sh) and the glossary (user story, milestone, epic, swimlane, OCC, timeline, contribs)."},{"id":"decisions","status":"fail","evidence":["No docs/decisions/ or docs/adr/"],"gap":"No decision records.","plan":"Create docs/decisions/0001-record-architecture-decisions.md and 0002 for an inferred decision, for example Celery with RabbitMQ and pickle serializer, or pluggable events backends (taiga/events/backends), marked 'Inferred from the code, to be confirmed by the team.'"},{"id":"implementation-log","status":"partial","evidence":["CHANGELOG.md exists (26 KB), no docs/harness/log.md"],"gap":"No harness implementation log.","plan":"Create docs/harness/log.md with a first dated entry (2026-11-01) and tell agents in AGENTS.md to append one entry per significant change."},{"id":"agreements","status":"pass","evidence":["CONTRIBUTING.md: conventional commits, DCO + license, Weblate for translations"],"gap":"None for the check. It does not state branch or review rules or a definition of done.","plan":"nothing (optionally add a short section on PR flow and definition of done including make check-fast, marked as proposed)."},{"id":"task-runner","status":"fail","evidence":["No Makefile, justfile or Taskfile; tox.ini and scripts/install, scripts/upgrade exist"],"gap":"No single task entry point.","plan":"Add a Makefile with help (default), setup (wrap ./scripts/install), dev (.venv/bin/python manage.py runserver), db-reset (./regenerate.sh -y), test (.venv/bin/pytest), lint (.venv/bin/flake8 .; add flake8 to dev deps or use tox -e flake8), check-fast, check, each with a ## comment."},{"id":"fast-gate","status":"fail","evidence":["No check-fast target"],"gap":"No fast gate; tests need PostgreSQL (tests/config.py DATABASES localhost taiga/taiga).","plan":"Add `check-fast`: flake8 plus `pytest tests/unit -q`. Verify which unit tests need the DB (pytest-django marks); the target must work after `make setup` with the compose PostgreSQL running. Skip existing failing tests with a reason and record them in docs/harness/log.md."},{"id":"full-gate","status":"fail","evidence":["No check target; CI runs coverage run ... -m pytest in .github/workflows/tests-and-coverall.yml"],"gap":"No full gate matching CI.","plan":"Add `check`: lint + `python manage.py makemigrations --check --dry-run` (settings tests.config) + full pytest with the same coverage command as CI. Make CI call `make check`."},{"id":"tests","status":"pass","evidence":["tests/unit (15 files), tests/integration (~70 files), tests/integration/resources_permissions; pytest.ini sets DJANGO_SETTINGS_MODULE=tests.config"],"gap":"None for the check. Tests require a PostgreSQL database.","plan":"nothing (document in AGENTS.md how to run one test: `.venv/bin/pytest tests/unit/test_slug.py::...`)."},{"id":"ci","status":"partial","evidence":[".github/workflows/tests-and-coverall.yml runs on push and pull_request to main with postgres:13 and rabbitmq services, calls pytest directly"],"gap":"CI does not call the task runner and does not run flake8.","plan":"Change the test step to `make check` (keep coverage and Coveralls), add a job step running `npx -y uw-harness verify` with Node 20. Keep the postgres and rabbitmq services and the GITHUB_WORKFLOW DB switch in tests/config.py."},{"id":"hooks","status":"fail","evidence":["No .pre-commit-config.yaml, .husky, lefthook.yml or .githooks"],"gap":"No git hooks.","plan":"Add .pre-commit-config.yaml with a flake8 hook and a pre-push local hook running `make check-fast`; install it from `make setup` (pre-commit install --hook-type pre-push). Add pre-commit to requirements-devel.in."},{"id":"local-env","status":"fail","evidence":["No compose file or devcontainer; settings/config.py.dev.example and regenerate.sh exist"],"gap":"Data stores must be installed by hand and there is no dev target.","plan":"Add compose.yaml with postgres:13 (user/pass/db taiga as in settings/common.py and tests/config.py) and rabbitmq; Makefile `dev` (copy settings/config.py.dev.example to settings/config.py if missing, runserver) and `db-reset` (./regenerate.sh -y with defaults). Write docs/local-dev.md (prerequisites: Python 3.10, libpq, libmagic, gettext; first run; reset; debugging; admin/123123 sample user)."},{"id":"env-example","status":"fail","evidence":["No .env.example","No .env tracked (git ls-files)","settings/common.py:249 hard-codes SECRET_KEY = \"aw3+t2r(8(0kkrhg8)gx6i96v5^kv%6cfep9wxfom0%7dy0m9e\"","settings/common.py DATABASES PASSWORD 'taiga'; docker/config.py defaults EMAIL_HOST_PASSWORD 'password'"],"gap":"No example env file, and the default settings contain a hard-coded SECRET_KEY and passwords that the secret scan will flag even after .env.example exists.","plan":"Create .env.example listing every os.getenv variable of docker/config.py (POSTGRES_*, TAIGA_SECRET_KEY, TAIGA_SITES_*, RABBITMQ_*, CELERY_*, EMAIL_*, ENABLE_* importers/contribs, WEBHOOKS_*, ENABLE_TELEMETRY) with safe empty values. Report the hard-coded SECRET_KEY in settings/common.py to a human; do not change settings behaviour silently."},{"id":"toolchain-pinned","status":"pass","evidence":[".python-version: 3.10","CI matrix python-version 3.10"],"gap":"Docker image uses python:3.11-slim, which differs from the pinned 3.10.","plan":"nothing (mention the 3.10 vs 3.11 difference in docs/local-dev.md and AGENTS.md)."},{"id":"deploy-explicit","status":"partial","evidence":["docker/Dockerfile, docker/entrypoint.sh (migrate, loaddata, gunicorn :8000), docker/async_entrypoint.sh (celery worker -B)","No deploy workflow in .github/workflows"],"gap":"No deploy document; how images are built, published and deployed (tree.taiga.io, Docker Hub) is not visible in the repository.","plan":"Create docs/deploy.md with what the repo shows (image build, entrypoints, env vars from docker/config.py, migrations on start) and uw-harness TODO blocks for registry, environments, release process, rollback and who deploys."},{"id":"observability","status":"fail","evidence":["settings/common.py LOGGING dict","gunicorn --access-logfile - and --log-level=info in docker/entrypoint.sh","sentry-sdk in requirements.txt but no sentry_sdk usage in taiga/, settings/ or docker/","Telemetry via Rudder in taiga/telemetry/tasks.py"],"gap":"No observability document; no health endpoint or error reporting is configured in the code.","plan":"Create docs/observability.md: logging config (settings/common.py LOGGING, stdout in Docker), gunicorn access logs, Celery logs, no health endpoint (suggest /api/v1/ answer as liveness), sentry-sdk installed but unused, plus TODO blocks for where logs, dashboards and alerts live."},{"id":"skills","status":"fail","evidence":["No .agents/skills or .claude/skills"],"gap":"No skills.","plan":"Create .agents/skills/implement-change, debug-local (compose DB, regenerate.sh, runserver, pytest -k, pdb), add-api-endpoint (viewset in app api.py + register in taiga/routers.py + permissions + integration test in tests/integration/resources_permissions), and deploy as a pointer to docs/deploy.md TODOs. Symlink .claude/skills -> .agents/skills."}],"questions":[{"requirement":"deploy-explicit","question":"How does a merged change reach production (tree.taiga.io and the public taiga-back Docker image): who builds and pushes the image, to which registry, and from which repository or pipeline?","why":"No deploy workflow or registry is visible; docker/Dockerfile is the only artifact."},{"requirement":"deploy-explicit","question":"Which environments exist (staging, production, on-premise customers) and how is a release rolled back, given that docker/entrypoint.sh runs migrations on start?","why":"Rollback with automatic migrations needs a human-defined procedure."},{"requirement":"observability","question":"Where are production logs, metrics and alerts for the API and Celery workers, and is Sentry (sentry-sdk is a dependency) configured somewhere outside this repository?","why":"The code has no Sentry init and no health endpoint; log location is not visible."},{"requirement":"observability","question":"What is the signal that production is broken (health check URL, key metric, alert channel)?","why":"Needed for the 'how to tell something is wrong' section."},{"requirement":"agreements","question":"What is the team's definition of done and review rule (number of approvals, who can merge to main, squash or merge commits)?","why":"History shows merge commits from PRs and conventional commits, but no written review rule."},{"requirement":"env-example","question":"Is the SECRET_KEY hard-coded in settings/common.py used by any real installation, and should it be replaced by an environment variable?","why":"It is a secret-looking value in tracked code; only the team can decide on rotation and change."},{"requirement":"local-env","question":"Which local setup do developers actually use today (local PostgreSQL, the taiga-docker repository, or something else), and should the new compose.yaml include RabbitMQ and taiga-events?","why":"The repository shows no compose file; the dev flow is not documented."}],"risks":["Tests need a running PostgreSQL (tests/config.py: localhost, user/pass taiga; or postgres/postgres when GITHUB_WORKFLOW is set). The fast gate will fail without the database.","Hard-coded SECRET_KEY in settings/common.py line 249 and default DB/email passwords: the env-example secret scan will report partial until a human decides.","Django 3.2.25 is end-of-life; several pins exist only to stay compatible (bleach<5, django-picklefield<3.3, easy-thumbnails<2.9). Upgrades can break installation.","Python mismatch: .python-version and CI use 3.10, Docker image uses 3.11.","System libraries needed to install requirements (libpq-dev for psycopg2, libmagic for python-magic, cairo for cairosvg, gettext for compilemessages) are not documented.","flake8 is not in requirements-devel.txt; lint only runs through tox (tox -e flake8), and CI does not lint at all, so the current code may not pass flake8.","requirements-contribs.txt installs plugins from GitHub over the network; it must stay out of the gates.","Celery uses pickle serialization (settings/common.py, docker/config.py); a security-sensitive decision to document, not change.","sentry-sdk and rudder-sdk-python (pre-release 1.0.0b1) are dependencies; sentry is not initialised in code, which may mislead the observability doc.","regenerate.sh drops the database and is interactive; never run it in a gate without -y and a local DB.","11 test files contain no tests (stubs such as tests/models.py); do not count them as coverage."],"notes_for_apply":"Runtime: Python 3.10 (.python-version, CI). Install with ./scripts/install, which creates .venv and installs requirements.txt + requirements-devel.txt; add a Makefile wrapping it instead of changing it. Requirements are pip-tools compiled (*.in -> *.txt via scripts/upgrade): if you add dev tools (flake8, pre-commit), add them to requirements-devel.in and regenerate requirements-devel.txt with pip-compile, keeping the `-c requirements.txt` constraint. Tests use pytest with DJANGO_SETTINGS_MODULE=tests.config (pytest.ini) and need PostgreSQL on localhost:5432 with db/user/password taiga; provide compose.yaml with postgres:13 matching those values so `make check-fast` works locally. CI sets GITHUB_WORKFLOW so tests/config.py switches to postgres/postgres; keep that behaviour and keep the rabbitmq service in CI. Full gate should reproduce the CI command: `coverage run --source=taiga --omit='*tests*,*commands*,*migrations*,*admin*,*.jinja,*dashboard*,*settings*,*wsgi*,*questions*,*documents*' -m pytest -v --tb=native --pythonwarnings=default`. Lint with flake8 using setup.cfg (max-line-length 120, excludes tests, migrations, management); run it once before putting it in the fast gate and record existing violations rather than mass-reformatting. Local run: copy settings/config.py.dev.example to settings/config.py (gitignored, check .gitignore) and use `python manage.py runserver`; regenerate.sh -y loads admin/123123 and sample data. Do not touch: migrations folders, taiga/locale (*.po managed by Weblate), the MPL license headers, docker/config.py env semantics, requirements-contribs.txt, the hard-coded SECRET_KEY (report it instead). Commit style is conventional commits (CONTRIBUTING.md, recent history: fix:, test:, chore:). Write all new docs in simple English without em-dashes."},"ttft_ms":1611,"type":"result","duration_ms":126074,"uuid":"64cb849b-a42b-4a2e-be8f-288e1fc8a392","ttft_stream_ms":1399,"time_to_request_ms":349,"first_content_frame_ms":1399,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":14,"outputTokens":12030,"cacheReadInputTokens":328189,"cacheCreationInputTokens":66663,"webSearchRequests":0,"costUSD":0.8395977999999998,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":704,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":66663,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
