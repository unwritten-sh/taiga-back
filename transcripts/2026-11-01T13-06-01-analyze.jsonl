ct dumps.","entry_points":["taiga/importers/jira/","taiga/importers/trello/","taiga/importers/asana/","taiga/importers/github/","taiga/export_import/"]},{"name":"Search, stats and telemetry","description":"Search inside a project, compute project/system stats, send daily anonymous telemetry via Rudder (Celery beat).","entry_points":["taiga/searches/","taiga/stats/","taiga/telemetry/tasks.py","taiga/celery.py: beat_schedule send-telemetry-once-a-day"]},{"name":"Local sample data","description":"Reset the database and load an initial admin user, project templates and generated sample data.","entry_points":["regenerate.sh","taiga/projects/management/commands/sample_data.py","manage.py loaddata initial_user / initial_project_templates"]}],"glossary":[{"term":"US / user story","meaning":"Unit of backlog work (taiga/projects/userstories)."},{"term":"Milestone","meaning":"A sprint in Scrum projects (taiga/projects/milestones)."},{"term":"Epic","meaning":"Group of related user stories (taiga/projects/epics)."},{"term":"Swimlane","meaning":"Horizontal lane on a Kanban board (/api/v1/swimlanes)."},{"term":"Points","meaning":"Story-point estimation values per role."},{"term":"Fan / watcher / vote / like","meaning":"Ways a user follows or supports a project or item (taiga/projects/votes, likes, notifications)."},{"term":"OCC","meaning":"Optimistic concurrency control on edits (taiga/projects/occ)."},{"term":"Timeline","meaning":"Activity feed for users and projects (taiga/timeline)."},{"term":"Taiga events","meaning":"Separate real-time service that receives pushes from taiga/events backends (not in this repository)."},{"term":"Contribs","meaning":"Optional plugins (Slack, GitHub/GitLab auth, protected) installed from requirements-contribs.txt."},{"term":"Kaleidos INC","meaning":"Company that owns the Taiga copyright (license headers, CONTRIBUTING.md)."},{"term":"INSTANCE_TYPE","meaning":"Setting naming the installation type, 'SRC' in settings/common.py (used by telemetry)."}]}