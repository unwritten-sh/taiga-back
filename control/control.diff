+def test_userstory_statuses_filter_rejects_non_integer_project():
+    request = mock.Mock(QUERY_PARAMS={"project": "abc"})
+    queryset = mock.Mock()
+
+    with pytest.raises(BadRequest):
+        UserStoryStatusesFilter().filter_queryset(request, queryset, view=None)
+
