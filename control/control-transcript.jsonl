st(_(\"'project' must be an integer value.\"))\n48\t\n49\t        if project_id:\n50\t            queryset = queryset.filter(status__project_id=project_id)\n51\t\n52\t        return super().filter_queryset(request, queryset, view)\n53\t\n54\t\n55\tclass AssignedUsersFilter(filters.BaseRelatedFieldsFilter):\n56\t    filter_name = 'assigned_users'\n57\t    exclude_param_name = 'exclude_assigned_users'\n58\t\n59\t    def _get_queryparams(self, params, mode=''):\n60\t        param_name = self.exclude_param_name if mode == 'exclude' else self.param_name or \\\n61\t                                                                       self.filter_name\n62\t        raw_value = params.get(param_name, None)\n63\t        if raw_value:\n64\t            value = self._prepare_filter_data(raw_value)\n65\t            UserStoryModel = apps.get_model(\"userstories\", \"UserStory\")\n66\t\n67\t            if None in value:\n68\t                value.remove(None)\n69\t                assigned_users_ids = UserStoryModel.objects.order_by().filter(\n70\t                    assigned_users__isnull=True,\n71\t                    id=OuterRef('pk')).values('pk')\n72\t\n73\t                assigned_user_filter_none = Q(pk__in=Subquery(assigned_users_ids))\n74\t                assigned_to_filter_none = Q(assigned_to__isnull=True)\n75\t\n76\t                return (get_assigned_users_filter(UserStoryModel, value)\n77\t                        | Q(assigned_user_filter_none, assigned_to_filter_none))\n78\t            else:\n79\t                return get_assigned_users_filter(UserStoryModel, value)\n80\t\n81\t        return None\n82\t\n83\t\n84\tclass UserStoriesRoleFilter(filters.BaseRelatedFieldsFilter):\n85\t    filter_name = \"role_id\"\n86\t    param_name = \"role\"\n87\t    exclude_param_name = 'exclude_role'\n88\t\n89\t    def filter_queryset(self, request, queryset, view):\n90\t        Membership = apps.get_model('projects', 'Membership')\n91\t\n92\t        operations = {\n93\t            \"filter\": self._prepare_filter_query,\n94\t            \"exclude\": self._prepare_exclude_query,\n95\t        }\n96\t\n97\t        for mode, qs_method in operations.items():\n98\t            query = self._get_queryparams(request.QUERY_PARAMS, mode=mode)\n99\t            if query:\n100\t                memberships = Membership.objects.filter(query).exclude(user__isnull=True). \\\n101\t                    values_list(\"user_id\", flat=True)\n102\t                if memberships:\n103\t                    user_story_model = apps.get_model(\"userstories\", \"UserStory\")\n104\t                    queryset = queryset.filter(\n105\t                        qs_method(Q(get_assigned_users_filter(user_story_model, memberships)))\n106\t                    )\n107\t\n108\t        return filters.FilterBackend.filter_queryset(self, request, queryset, view)\n109\t\n110\t\n111\tclass DashboardFilter(filters.FilterBackend):\n112\t    \"\"\"\n113\t    This filter improves performance for dashboard queries.\n114\t    Only search in the user projects\n115\t    \"\"\"\n116\t    filter_name = 'dashboard'\n117\t    param_name = \"dashboard\"\n118\t\n119\t    def _filter_user_projects(self, request):\n120\t        membership_model = apps.get_model('projects', 'Membership')\n121\t        if isinstance(request.user, AnonymousUser):\n122\t            return None\n123\t        else:\n124\t            memberships_project_ids = membership_model.objects.filter(user=request.user).values(\n125\t                'project_id')\n126\t\n127\t        return Subquery(memberships_project_ids)\n128\t\n129\t    def filter_queryset(self, request, queryset, view):\n130\t        if request.QUERY_PARAMS.get(self.param_name, False):\n131\t            user_projects_ids_subquery = self._filter_user_projects(request)\n132\t\n133\t            if user_projects_ids_subquery:\n134\t                queryset = queryset.filter(project_id__in=user_projects_ids_subquery)\n135\t\n136\t        return super().filter_queryset(req