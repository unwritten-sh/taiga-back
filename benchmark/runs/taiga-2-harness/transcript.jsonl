_password_from_recovery_with_valid_token(client):\n    user = f.UserFactory.create(token=\"recovery-token\",\n                                token_expires_at=timezone.now() + datetime.timedelta(minutes=10))\n    user.set_password(\"current-password\")\n    user.save()\n\n    response = client.post(reverse(\"users-change-password-from-recovery\"),\n                           json.dumps({\"token\": \"recovery-token\", \"password\": \"new-password\"}),\n                           content_type=\"application/json\")\n\n    assert response.status_code == 204\n    user.refresh_from_db()\n    assert user.check_password(\"new-password\")\n    assert user.token is None\n    assert user.token_expires_at is None\n\n\ndef test_change_password_from_recovery_full_flow_and_expiration(client, settings):\n    settings.PASSWORD_RECOVERY_TOKEN_LIFETIME = datetime.timedelta(hours=1)\n    user = f.UserFactory.create(username=\"recovery-user\")\n    user.set_password(\"current-password\")\n    user.save()\n\n    client.post(reverse(\"users-password-recovery\"), json.dumps({\"username\": \"recovery-user\"}),\n                content_type=\"application/json\")\n    user.refresh_from_db()\n    token = user.token\n\n    # Simulate that more than the configured lifetime has passed\n    later = timezone.now() + datetime.timedelta(hours=1, seconds=1)\n    with mock.patch(\"taiga.users.api.timezone.now\", return_value=later):\n        response = client.post(reverse(\"users-change-password-from-recovery\"),\n                               json.dumps({\"token\": token, \"password\": \"new-password\"}),\n                               content_type=\"application/json\")\n\n    assert response.status_code == 400\n    user.refresh_from_db()\n    assert user.check_password(\"current-password\")\n    assert user.token == token\n\n\ndef _unknown_token_response(client):\n    return client.post(reverse(\"users-change-password-from-recovery\"),\n                       json.dumps({\"token\": \"unknown-token\", \"password\": \"new-password\"}),\n                       content_type=\"application/json\")\n\n\n@pytest.mark.parametrize(\"token_expires_at\", [\n    pytest.param(lambda: timezone.now() - datetime.timedelta(seconds=1), id=\"expired\"),\n    pytest.param(lambda: None, id=\"legacy-without-expiration\"),\n])\ndef test_change_password_from_recovery_rejects_expired_or_legacy_token(client, token_expires_at):\n    expires_at = token_expires_at()\n    user = f.UserFactory.create(token=\"recovery-token\", token_expires_at=expires_at)\n    user.set_password(\"current-password\")\n    user.save()\n\n    response = client.post(reverse(\"users-change-password-from-recovery\"),\n                           json.dumps({\"token\": \"recovery-token\", \"password\": \"new-password\"}),\n                           content_type=\"application/json\")\n    unknown_response = _unknown_token_response(client)\n\n    assert response.status_code == 400\n    assert response.status_code == unknown_response.status_code\n    assert response.data == unknown_response.data\n    user.refresh_from_db()\n    assert user.check_password(\"current-password\")\n    assert user.token == \"recovery-token\"\n    assert user.token_expires_at == expires_at\n\n\n'''\ns=s.replace(anchor,new+anchor,1)\nopen(p,'w').write(s)\nEOF\ngrep -n \"^import\\|^from unittest\\|^from.*mock\" tests/integration/test_users.py tests/integration/resources_permissions/test_users_resources.py | head -20"}}}
