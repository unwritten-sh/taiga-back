utes=30) <= user.token_expires_at <= after + datetime.timedelta(minutes=30)\n    assert len(mail.outbox) == 1\n\n\ndef test_password_recovery_again_replaces_token_and_expiration(client):\n    old_expiration = timezone.now() + datetime.timedelta(minutes=5)\n    user = f.UserFactory.create(username=\"recovery-user\", token=\"old-token\", token_expires_at=old_expiration)\n\n    response = client.post(reverse(\"users-password-recovery\"), json.dumps({\"username\": \"recovery-user\"}),\n                           content_type=\"application/json\")\n\n    assert response.status_code == 200\n    user.refresh_from_db()\n    assert user.token not in (None, \"old-token\")\n    assert user.token_expires_at > old_expiration\n\n    response = client.post(reverse(\"users-change-password-from-recovery\"),\n                           json.dumps({\"token\": \"old-token\", \"password\": \"new-password\"}),\n                           content_type=\"application/json\")\n    assert response.status_code == 400\n\n\ndef test_change_password_from_recovery_with_valid_token(client):\n    user = f.UserFactory.create(token=\"recovery-token\",\n                                token_expires_at=timezone.now() + datetime.timedelta(minutes=10))\n    user.set_password(\"current-password\")\n    user.save()\n\n    response = client.post(reverse(\"users-change-password-from-recovery\"),\n                           json.dumps({\"token\": \"recovery-token\", \"password\": \"new-password\"}),\n                           content_type=\"application/json\")\n\n    assert response.status_code == 204\n    user.refresh_from_db()\n    assert user.check_password(\"new-password\")\n    assert user.token is None\n    assert user.token_expires_at is None\n\n\ndef test_change_password_from_recovery_full_flow_and_expiration(client, settings):\n    settings.PASSWORD_RECOVERY_TOKEN_LIFETIME = datetime.timedelta(hours=1)\n    user = f.UserFactory.create(username=\"recovery-user\")\n    user.set_password(\"current-password\")\n    user.save()\n\n    client.post(reverse(\"users-password-recovery\"), json.dumps({\"username\": \"recovery-user\"}),\n                content_type=\"application/json\")\n    user.refresh_from_db()\n    token = user.token\n\n    # Simulate that more than the configured lifetime has passed\n    later = timezone.now() + datetime.timedelta(hours=1, seconds=1)\n    with mock.patch(\"taiga.users.api.timezone.now\", return_value=later):\n        response = client.post(reverse(\"users-change-password-from-recovery\"),\n                               json.dumps({\"token\": token, \"password\": \"new-password\"}),\n                               content_type=\"application/json\")\n\n    assert response.status_code == 400\n    user.refresh_from_db()\n    assert user.check_password(\"current-password\")\n    assert user.token == token\n\n\ndef _unknown_token_response(client):\n    return client.post(reverse(\"users-change-password-from-recovery\"),\n                       json.dumps({\"token\": \"unknown-token\", \"password\": \"new-password\"}),\n                       content_type=\"application/json\")\n\n\n@pytest.mark.parametrize(\"token_expires_at\", [\n    pytest.param(lambda: timezone.now() - datetime.timedelta(seconds=1), id=\"expired\"),\n    pytest.param(lambda: None, id=\"legacy-without-expiration\"),\n])\ndef test_change_password_from_recovery_rejects_expired_or_legacy_token(client, token_expires_at):\n    expires_at = token_expires_at()\n    user = f.UserFactory.create(token=\"recovery-token\", token_expires_at=expires_at)\n    user.set_password(\"current-password\")\n    user.save()\n\n    response = client.post(reverse(\"users-change-password-from-recovery\"),\n                           json.dumps({\"token\": \"recovery-token\", \"password\": \"new-password\"}),\n                           content_type=\"application/json\")\n    unknown_response = _unknown_token_response(client)\n\n    assert response.status_code == 400\n    assert response.status_code == unknown_response.status_code\n    assert response.data == unknown_response.data\n    user.refresh_from_db()\n    assert user.check_password(\"current-password\")\n    assert user.token == \"recovery-token\"\n    assert user.token_expires_at == expires_at\n\n\n'''\ns=s.replace(anchor,new+anchor,1)\nopen(p,'w').write(s)\nEOF\ngrep -n \"^import\\|^from unittest\\|^from.*mock\" tests/integration/test_users.py tests/integration/resources_permissions/test_users_resources.py | head -20"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1367,"cache_read_input_tokens":41234,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1367},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4fcdc8a8-cd51-42fd-846a-abc56cbc1d0e","uuid":"fcf7167b-234a-456d-8ba4-d046d0d75586","timestamp":"2026-11-02T00:25:25.204Z","request_id":"req_011Cgd9gdHKQMrwDbJvnh6i1","wire_tool_inputs":{"toolu_01HUeWnp38gHMRv4TG9zNTY2":{"command":"python3 - <<'EOF'\np='tests/integration/resources_permissions/test_users_resources.py'; s=open(p).read()\ns=s.replace('''    new_user = f.UserFactory(token=\"test-token\")\n\n    def reset_token():\n        new_user.token = \"test-token\"\n        new_user.save()''','''    new_user = f.UserFactory(token=\"test-token\", token_expires_at=timezone.now() + timedelta(hours=1))\n\n    def reset_token():\n        new_user.token = \"test-token\"\n        new_user.token_expires_at = timezone.now() + timedelta(hours=1)\n        new_user.save()''',1)\nopen(p,'w').write(s)\np='tests/integration/test_users.py'; s=open(p).read()\ns=s.replace('''    user = f.UserFactory.create(token=\"recovery-token\")\n    user.set_password(\"current-password\")''','''    user = f.UserFactory.create(token=\"recove