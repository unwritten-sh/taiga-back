{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgd4j3Sqn3N7NmSX4bG5F","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B6hQRPUfhn8nUoBnpdDMTF","name":"Write","input":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-1-harness/tests/integration/test_invitation_token_expiration.py","content":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nfrom datetime import timedelta\n\nimport pytest\n\nfrom django.conf import settings\nfrom django.urls import reverse\nfrom django.utils import timezone\n\nfrom taiga.base.utils import json\nfrom taiga.projects.models import Membership\nfrom taiga.projects.services import generate_invitation_token\nfrom taiga.users.models import User\n\nfrom .. import factories as f\n\npytestmark = pytest.mark.django_db\n\n\ndef _assert_valid_expiration(membership, before):\n    assert membership.token\n    assert membership.token_expires_at is not None\n    after = timezone.now()\n    assert before + settings.INVITATION_TOKEN_LIFETIME <= membership.token_expires_at\n    assert membership.token_expires_at <= after + settings.INVITATION_TOKEN_LIFETIME\n\n\ndef _expired_invitation(**kwargs):\n    return f.InvitationFactory(token_expires_at=timezone.now() - timedelta(seconds=1), **kwargs)\n\n\ndef _legacy_invitation(**kwargs):\n    return f.InvitationFactory(token_expires_at=None, **kwargs)\n\n\n#################\n# Issuing\n#################\n\ndef test_invitation_token_lifetime_is_one_week():\n    assert settings.INVITATION_TOKEN_LIFETIME == timedelta(days=7)\n\n\ndef test_generate_invitation_token_returns_token_and_expiration():\n    before = timezone.now()\n    token, token_expires_at = generate_invitation_token()\n    other_token, _ = generate_invitation_token()\n\n    assert token and token != other_token\n    assert before + timedelta(days=7) <= token_expires_at <= timezone.now() + timedelta(days=7)\n\n\ndef test_factories_create_invitations_with_valid_expiration():\n    before = timezone.now()\n    _assert_valid_expiration(f.InvitationFactory(), before)\n    _assert_valid_expiration(f.MembershipFactory(user=None), before)\n\n\ndef test_api_create_invitation_sets_expiration(client, outbox):\n    role = f.RoleFactory.create()\n    f.MembershipFactory(project=role.project, user=role.project.owner, is_admin=True)\n    client.login(role.project.owner)\n\n    before = timezone.now()\n    data = {\"role\": role.pk, \"project\": role.project.pk, \"username\": \"new-guest@email.com\"}\n    response = client.json.post(reverse(\"memberships-list\"), json.dumps(data))\n\n    assert response.status_code == 201, response.data\n    _assert_valid_expiration(Membership.objects.get(email=\"new-guest@email.com\"), before)\n\n\ndef test_api_bulk_create_invitations_sets_expiration(client, outbox):\n    project = f.ProjectFactory()\n    role = f.RoleFactory(project=project)\n    f.MembershipFactory(project=project, user=project.owner, is_admin=True)\n    client.login(project.owner)\n\n    before = timezone.now()\n    data = {\n        \"project_id\": project.id,\n        \"bulk_memberships\": [{\"role_id\": role.pk, \"username\": \"bulk-guest@email.com\"}],\n    }\n    response = client.json.post(reverse(\"memberships-bulk-create\"), json.dumps(data))\n\n    assert response.status_code == 200, response.data\n    _assert_valid_expiration(Membership.objects.get(email=\"bulk-guest@email.com\"), before)\n\n\ndef test_project_import_sets_invitation_expiration(client):\n    user = f.UserFactory.create()\n    client.login(user)\n\n    before = timezone.now()\n    data = {\n        \"name\": \"Imported project\",\n        \"description\": \"Imported project\",\n        \"memberships\": [{\n            \"email\": \"imported-guest@email.com\",\n            \"role\": \"Role\",\n            \"token\": \"123\",\n        }],\n        \"roles\": [{\"name\": \"Role\"}]\n    }\n    response = client.json.post(reverse(\"importer-list\"), json.dumps(data))\n\n    assert response.status_code == 201, response.data\n    _assert_valid_expiration(Membership.objects.get(email=\"imported-guest@email.com\"), before)\n\n\n#################\n# Get invitation by token\n#################\n\ndef test_get_invitation_with_valid_token(client):\n    invitation = f.InvitationFactory()\n    response = client.get(reverse(\"invitations-detail\", kwargs={\"token\": invitation.token}))\n    assert response.status_code == 200, response.data\n\n\n@pytest.mark.parametrize(\"make_invitation\", [_expired_invitation, _legacy_invitation])\ndef test_get_invitation_with_expired_or_legacy_token_returns_404(client, make_invitation):\n    invitation = make_invitation()\n    response = client.get(reverse(\"invitations-detail\", kwargs={\"token\": invitation.token}))\n    assert response.status_code == 404, response.data\n\n\n#################\n# Login and register with invitation token\n#################\n\n@pytest.mark.parametrize(\"make_invitation\", [_expired_invitation, _legacy_invitation])\ndef test_login_with_expired_or_legacy_invitation_token_returns_404(client, settings, make_invitation):\n    settings.PUBLIC_REGISTER_ENABLED = False\n    user = f.UserFactory()\n    invitation = make_invitation()\n\n    auth_data = {\n        \"username\": user.username,\n        \"password\": user.username,\n        \"type\": \"normal\",\n        \"invitation_token\": invitation.token,\n    }\n    response = client.post(reverse(\"auth-list\"), auth_data)\n    invitation.refresh_from_db()\n\n    assert response.status_code == 404, response.data\n    assert invitation.user is None\n\n\ndef test_private_register_with_valid_invitation_token(client):\n    invitation = f.InvitationFactory()\n\n    data = {\n        \"type\": \"private\",\n        \"token\": invitation.token,\n        \"username\": \"newuser\",\n        \"email\": \"newuser@email.com\",\n        \"full_name\": \"New User\",\n        \"password\": \"password\",\n        \"accepted_terms\": True,\n    }\n    response = client.post(reverse(\"auth-register\"), data)\n    invitation.refresh_from_db()\n\n    assert response.status_code == 201, response.data\n    assert invitation.user.username == \"newuser\"\n\n\n@pytest.mark.parametrize(\"make_invitation\", [_expired_invitation, _legacy_invitation])\ndef test_private_register_with_expired_or_legacy_invitation_token_returns_404(client, make_invitation):\n    invitation = make_invitation()\n\n    data = {\n        \"type\": \"private\",\n        \"token\": invitation.token,\n        \"username\": \"newuser\",\n        \"email\": \"newuser@email.com\",\n        \"full_name\": \"New User\",\n        \"password\": \"password\",\n        \"accepted_terms\": True,\n    }\n    response = client.post(reverse(\"auth-register\"), data)\n    invitation.refresh_from_db()\n\n    assert response.status_code == 404, response.data\n    assert invitation.user is None\n    assert not User.objects.filter(username=\"newuser\").exists()\n\n\n#################\n# Resend\n#################\n\n@pytest.mark.parametrize(\"make_invitation\", [f.InvitationFactory, _expired_invitation, _legacy_invitation])\ndef test_resend_invitation_rotates_token_and_refreshes_expiration(client, outbox, make_invitation):\n    invitation = make_invitation()\n    f.MembershipFactory(project=invitation.project, user=invitation.project.owner, is_admin=True)\n    old_token = invitation.token\n    client.login(invitation.project.owner)\n\n    before = timezone.now()\n    response = client.post(reverse(\"memberships-resend-invitation\", kwargs={\"pk\": invitation.pk}))\n    invitation.refresh_from_db()\n\n    assert response.status_code == 204, response.data\n    assert invitation.token != old_token\n    _assert_valid_expiration(invitation, before)