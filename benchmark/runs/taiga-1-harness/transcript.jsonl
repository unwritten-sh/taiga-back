ng_memberships = [m.email for m in new_memberships if not m.user_id]\n185\t\n186\t    confirmed_memberships = (models.Membership.objects.filter(project__is_private=project.is_private,\n187\t                                                              project__owner_id=project.owner_id,\n188\t                                                              user_id__isnull=False)\n189\t                                                      .order_by(\"user_id\")\n190\t                                                      .distinct(\"user_id\")\n191\t                                                      .values_list(\"user_id\", flat=True)) # Just confirmed members\n192\t    pending_memberships = (models.Membership.objects.filter(project__is_private=project.is_private,\n193\t                                                            project__owner_id=project.owner_id,\n194\t                                                            user_id__isnull=True)\n195\t                                                     .order_by(\"email\")\n196\t                                                     .distinct(\"email\")\n197\t                                                     .values_list(\"email\", flat=True))\n198\t\n199\t    total_memberships =  len({*pending_memberships, *new_pending_memberships, *confirmed_memberships, *new_confirmed_memberships})\n200\t    total_pending_memberships = len({*pending_memberships, *new_pending_memberships})\n201\t\n202\t    if project.is_private:\n203\t        max_memberships = project.owner.max_memberships_private_projects\n204\t        error_members_exceeded = _(\"You have reached your current limit of memberships for private projects\")\n205\t    else:\n206\t        max_memberships = project.owner.max_memberships_public_projects\n207\t        error_members_exceeded = _(\"You have reached your current limit of memberships for public projects\")\n208\t\n209\t    if max_memberships is not None and total_memberships > max_memberships:\n210\t  