{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XdF7Wcpn19nLtGomN5VEhj","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t# This Source Code Form is subject to the terms of the Mozilla Public\n3\t# License, v. 2.0. If a copy of the MPL was not distributed with this\n4\t# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n5\t#\n6\t# Copyright (c) 2021-present Kaleidos INC\n7\t\n8\timport uuid\n9\t\n10\tfrom taiga.base.exceptions import ValidationError, WrongArguments\n11\tfrom taiga.base.utils import db\n12\tfrom taiga.users.models import User\n13\tfrom taiga.users.services import get_user_by_username_or_email\n14\t\n15\tfrom django.conf import settings\n16\tfrom django.core.validators import validate_email\n17\tfrom django.utils.translation import gettext as _\n18\t\n19\tfrom .. import models\n20\t\n21\t\n22\tdef get_members_from_bulk(bulk_data, **additional_fields):\n23\t    \"\"\"Convert `bulk_data` into a list of members.\n24\t\n25\t    :param bulk_data: List of members in bulk format.\n26\t    :param additional_fields: Additional fields when instantiating each task.\n27\t\n28\t    :return: List of `Member` instances.\n29\t    \"\"\"\n30\t    members = []\n31\t\n32\t    for data in bulk_data:\n33\t        data_copy = data.copy()\n34\t\n35\t        # Try to find the user\n36\t        username = data_copy.pop(\"username\")\n37\t        try:\n38\t            user = get_user_by_username_or_email(username)\n39\t            data_copy[\"user_id\"] = user.id\n40\t        except WrongArguments:\n41\t            # If not exist, is an invitation. Set the email and a token\n42\t            try:\n43\t                validate_email(username)\n44\t                data_copy[\"email\"] = username\n45\t            except ValidationError:\n46\t                raise WrongArguments(_(\"Malformed email adress.\"))\n47\t\n48\t            if \"token\" not in data_copy.keys():\n49\t                data_copy[\"token\"] = str(uuid.uuid4())\n50\t\n51\t        data_copy.update(additional_fields)\n52\t\n53\t        members.append(models.Membership(**data_copy))\n54\t\n55\t    return members\n56\t\n57\t\n58\tdef create_members_in_bulk(members, callback=None, precall=None):\n59\t    \"\"\"Create members from `bulk_data`.\n60\t\n61\t    :param members: List of dicts `{\"project_id\": <>, \"role_id\": <>, \"username\": <>}`.\n62\t    :param callback: Callback to execute after each task save.\n63\t    :param additional_fields: Additional fields when instantiating each task.\n64\t\n65\t    \"\"\"\n66\t    db.save_in_bulk(members, callback, precall)\n67\t\n68\t\n69\tdef remove_user_from_project(user, project):\n70\t    models.Membership.objects.get(project=project, user=user).delete()\n71\t\n72\t\n73\tdef project_has_valid_admins(project, exclude_user=None):\n74\t    \"\"\"\n75\t    Checks if the project has any owner membership with a user different than the specified\n76\t    \"\"\"\n77\t    admin_memberships = project.memberships.filter(is_admin=True, user__is_active=True)\n78\t    if exclude_user:\n79\t        admin_memberships = admin_memberships.exclude(user=exclude_user)\n80\t\n81\t    return admin_memberships.count() > 0\n82\t\n83\t\n84\tdef can_user_leave_project(user, project):\n85\t    membership = project.memberships.get(user=user)\n86\t    if not membership.is_admin:\n87\t        return True\n88\t\n89\t    # The user can't leave if is the real owner of the project\n90\t    if project.owner == user:\n91\t        return False\n92\t\n93\t    if not project_has_valid_admins(project, exclude_user=user):\n94\t        return False\n95\t\n96\t    return True\n97\t\n98\t\n99\tdef get_max_memberships_for_project(project):\n100\t    \"\"\"Return tha maximun of membersh for a concrete project.\n101\t\n102\t    :param project: A project object.\n103\t\n104\t    :return: a number or null.\n105\t    \"\"\"\n106\t    if project.owner is None:\n107\t        return None\n108\t\n109\t    if project.is_private:\n110\t        return project.owner.max_memberships_private_projects\n111\t    return project.owner.max_memberships_public_projects\n112\t\n113\t\n114\tdef get_total_project_memberships(project):\n115\t    \"\"\"Return tha total of memberships of a project (members and unaccepted invitations).\n116\t\n117\t    :param project: A project object.\n118\t\n119\t    :return: a number.\n120\t    \"\"\"\n121\t    return project.memberships.count()\n122\t\n123\t\n124\tdef check_if_new_member_can_be_created(new_membership):\n125\t    \"\"\"Return if a new mebership could be created.\n126\t\n127\t    :param new_memberships: the new membershhip object (not saved in the database jet)\n128\t\n129\t    :return: {bool, error_mesage, total_memberships} return a tuple (can add new members?, error message, total of members).\n130\t    \"\"\"\n131\t    project = new_membership.project\n132\t\n133\t    if project.owner is None:\n134\t        return False, _(\"Project without owner\"), None\n135\t\n136\t    confirmed_memberships = (models.Membership.objects.filter(project__is_private=project.is_private,\n137\t                                                              project__owner_id=project.owner_id,\n138\t                                                              user_id__isnull=False)\n139\t                                                      .order_by(\"user_id\")\n140\t                                                      .distinct(\"user_id\")\n141\t                                                      .count()) # Just confirmed members\n142\t    pending_memberships = (models.Membership.objects.filter(project__is_private=project.is_private,\n143\t                                                            project__owner_id=project.owner_id,\n144\t                                                            user_id__isnull=True)\n145\t                                                     .order_by(\"email\")\n146\t                                                     .distinct(\"email\")