{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EbfGTzNscSdKUKa6sDLb1c","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t# This Source Code Form is subject to the terms of the Mozilla Public\n3\t# License, v. 2.0. If a copy of the MPL was not distributed with this\n4\t# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n5\t#\n6\t# Copyright (c) 2021-present Kaleidos INC\n7\t\n8\tfrom django.apps import apps\n9\tfrom django.conf import settings\n10\tfrom django.contrib.auth import get_user_model\n11\tfrom django.db import transaction as tx\n12\tfrom django.db import IntegrityError\n13\tfrom django.utils.translation import gettext as _\n14\t\n15\tfrom taiga.base import exceptions as exc\n16\t\n17\tfrom taiga.base.mails import mail_builder\n18\t\n19\t\n20\tdef send_invitation(invitation):\n21\t    \"\"\"Send an invitation email\"\"\"\n22\t    if invitation.user:\n23\t        template = mail_builder.membership_notification\n24\t        email = template(invitation.user, {\"membership\": invitation})\n25\t    else:\n26\t        template = mail_builder.membership_invitation\n27\t        email = template(invitation.email, {\"membership\": invitation})\n28\t\n29\t    email.send()\n30\t\n31\t\n32\tdef find_invited_user(email, default=None):\n33\t    \"\"\"Check if the invited user is already a registered.\n34\t\n35\t    :param email: some user email\n36\t    :param default: Default object to return if user is not found.\n37\t\n38\t    :return: The user if it's found, othwerwise return `default`.\n39\t    \"\"\"\n40\t\n41\t    User = apps.get_model(settings.AUTH_USER_MODEL)\n42\t    qs = User.objects.filter(email__iexact=email)\n43\t\n44\t    if len(qs) > 1:\n45\t        qs = qs.filter(email=email)\n46\t\n47\t    if len(qs) == 0:\n48\t        return default\n49\t\n50\t    return qs[0]\n51\t\n52\t\n53\tdef get_membership_by_token(token:str):\n54\t    \"\"\"\n55\t    Given an invitation token, returns a pending membership instance\n56\t    that matches with specified token.\n57\t\n58\t    Only pending invitations are matched, so already accepted tokens\n59\t    can not be reused to reassign the membership.\n60\t\n61\t    The row is locked to prevent two concurrent requests from\n62\t    accepting the same invitation.\n63\t\n64\t    If not matches with any membership NotFound exception\n65\t    is raised.\n66\t    \"\"\"\n67\t    membership_model = apps.get_model(\"projects\", \"Membership\")\n68\t    # of=(\"self\",): only lock the membership row; locking the\n69\t    # nullable users_user join is not allowed by PostgreSQL\n70\t    qs = (membership_model.objects\n71\t          .select_for_update(of=(\"self\",))\n72\t          .filter(\n73\t              token=token,\n74\t              user_id__isnull=True,\n75\t          ))\n76\t    if len(qs) == 0:\n77\t        raise exc.NotFound(_(\"Token does not match any valid invitation.\"))\n78\t    return qs[0]\n79\t\n80\t\n81\t@tx.atomic\n82\tdef accept_invitation_by_existing_user(token:str, user_id:int):\n83\t    user_model = get_user_model()\n84\t    try:\n85\t        user = user_model.objects.get(id=user_id)\n86\t    except user_model.DoesNotExist:\n87\t        raise exc.NotFound(_(\"User does not exist.\"))\n88\t\n89\t    membership = get_membership_by_token(token)\n90\t    try:\n91\t        membership.user = user\n92\t        # Single use: consume the token so it can not be reused\n93\t        membership.token = None\n94\t        membership.token_expires_at = None\n95\t        membership.save(update_fields=[\"user\", \"token\", \"token_expires_at\"])\n96\t    except IntegrityError:\n97\t        raise exc.IntegrityError(_(\"This user is already a member of the project.\"))\n98\t    return user\n99\t"}]},"parent_tool_use_id":null,"session_id":"9d474e49-5d0c-494f-840a-4c52349766d2","uuid":"4cffcf25-58a5-4830-99ad-28986d449dd5","timestamp":"2026-11-01T23:17:52.002Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-1-harness/taiga/projects/services/invitations.py","content":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nfrom django.apps import apps\nfrom django.conf import settings\nfrom django.contrib.auth import get_user_model\nfrom django.db import transaction as tx\nfrom django.db import IntegrityError\nfrom django.utils.translation import gettext as _\n\nfrom taiga.base import exceptions as exc\n\nfrom taiga.base.mails import mail_builder\n\n\ndef send_invitation(invitation):\n    \"\"\"Send an invitation email\"\"\"\n    if invitation.user:\n        template = mail_builder.membership_notification\n        email = template(invitation.user, {\"membership\": invitation})\n    else:\n        template = mail_builder.membership_invitation\n        email = template(invitation.email, {\"membership\": invitation})\n\n    email.send()\n\n\ndef find_invited_user(email, default=None):\n    \"\"\"Check if the invited user is already a registered.\n\n    :param email: some user email\n    :param default: Default object to return if user is not found.\n\n    :return: The user if it's found, othwerwise return `default`.\n    \"\"\"\n\n    User = apps.get_model(settings.AUTH_USER_MODEL)\n    qs = User.objects.filter(email__iexact=email)\n\n    if len(qs) > 1:\n        qs = qs.filter(email=email)\n\n    if len(qs) == 0:\n        return default\n\n    return qs[0]\n\n\ndef get_membership_by_token(token:str):\n    \"\"\"\n    Given an invitation token, returns a pending membership instance\n    that matches with specified token.\n\n    Only pending invitations are matched, so already accepted tokens\n    can not be reused to reassign the membership.\n\n    The row is locked to prevent two concurrent requests from\n    accepting the same invitation.\n\n    If not matches with any membership NotFound exception\n    is raised.\n    \"\"\"\n    membership_model = apps.get_model(\"projects\", \"Membership\")\n    # of=(\"self\",): only lock the membership row; locking the\n    # nullable users_user join is not allowed by PostgreSQL\n    qs = (membership_model.objects\n          .select_for_update(of=(\"self\",))\n          .filter(\n              token=token,\n              user_id__isnull=True,\n          ))\n    if len(qs) == 0:\n        raise exc.NotFound(_(\"Token does not match any valid invitation.\"))\n    return qs[0]\n\n\n@tx.atomic\ndef accept_invitation_by_existing_user(token:str, user_id:int):\n    user_model = get_user_model()\n    try:\n        user = user_model.objects.get(id=user_id)\n    except user_model.DoesNotExist:\n        raise exc.NotFound(_(\"User does not exist.\"))\n\n    membership = get_membership_by_token(token)\n    try:\n        membership.user = user\n        # Single use: consume the token so it can not be reused\n        membership.token = None\n        membership.token_expires_at = None\n        membership.save(update_fields=[\"user\", \"token\", \"token_expires_at\"])\n    except IntegrityError:\n        raise exc.IntegrityError(_(\"This user is already a member of the project.\"))\n    return user\n","numLines":99,"startLine":1,"totalLines":99}},"tool_result_meta":[{"id":"toolu_01EbfGTzNscSdKUKa6sDLb1c","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
