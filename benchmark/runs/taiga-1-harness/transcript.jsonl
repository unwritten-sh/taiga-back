am email: some user email\n    :param default: Default object to return if user is not found.\n\n    :return: The user if it's found, othwerwise return `default`.\n    \"\"\"\n\n    User = apps.get_model(settings.AUTH_USER_MODEL)\n    qs = User.objects.filter(email__iexact=email)\n\n    if len(qs) > 1:\n        qs = qs.filter(email=email)\n\n    if len(qs) == 0:\n        return default\n\n    return qs[0]\n\n\ndef generate_invitation_token():\n    \"\"\"\n    Return a new invitation token and its expiration date, as a tuple\n    `(token, token_expires_at)`.\n\n    Every place that issues an invitation token must use this function\n    so the token and its expiration date are always set together.\n    \"\"\"\n    token = str(uuid.uuid4())\n    token_expires_at = timezone.now() + settings.INVITATION_TOKEN_LIFETIME\n    return token, token_expires_at\n\n\ndef set_invitation_token(membership):\n    \"\"\"\n    Set a new invitation token and its expiration date on `membership`.\n    The membership is not saved.\n    \"\"\"\n    membership.token, membership.token_expires_at = generate_invitation_token()\n    return membership\n\n\ndef valid_invitations_filter():\n    \"\"\"\n    Return the Q filter that matches pending invitations whose token is\n    still valid. Tokens without an expiration date (issued before\n    expiration existed) are treated as expired.\n    \"\"\"\n    return Q(user_id__isnull=True, token_expires_at__gt=timezone.now())\n\n\ndef get_membership_by_token(token:str):\n    \"\"\"\n    Given an invitation token, returns a pending membership instance\n    that matches with specified token.\n\n    Only pending invitations are matched, so already accepted tokens\n    can not be reused to reassign the membership. Expired tokens, and\n    tokens without an expiration date, do not match either.\n\n    The row is locked to prevent two concurrent requests from\n    accepting the same invitation.\n\n    If not matches with any membership NotFound exception\n    is raised.\n    \"\"\"\n    membership_model = apps.get_model(\"projects\", \"Membership\")\n    # of=(\"self\",): only lock the membership row; locking the\n    # nullable users_user join is not allowed by PostgreSQL\n    qs = (membership_model.objects\n          .select_for_update(of=(\"self\",))\n          .filter(\n              token=token,\n              user_id__isnull=True,\n          ))\n    if len(qs) == 0:\n        raise exc.NotFound(_(\"Token does not match any valid invitation.\"))\n    return qs[0]\n\n\n@tx.atomic\ndef accept_invitation_by_existing_user(token:str, user_id:int):\n    user_model = get_user_model()\n    try:\n        user = user_model.objects.get(id=user_id)\n    except user_model.DoesNotExist:\n        raise exc.NotFound(_(\"User does not exist.\"))\n\n    membership = get_membership_by_token(token)\n    try:\n        membership.user = user\n        # Single use: consume the token so it can not be reused\n        membership.token = None\n        membership.token_expires_at = None\n        membership.save(update_fields=[\"user\", \"token\", \"token_expires_at\"])\n    except IntegrityError:\n        raise exc.IntegrityError(_(\"This user is already a member of the project.\"))\n    return user\n","structuredPatch":[{"oldStart":101,"oldLines":10,"newStart":101,"newLines":7,"lines":["     # nullable users_user join is not allowed by PostgreSQL","     qs = (membership_model.objects","           .select_for_update(of=(\"self\",))","-          .filter(","-              token=token,","-              user_id__isnull=True,","-          ))","+          .filter(valid_invitations_filter(), token=token))","     if len(qs) == 0:","         raise exc.NotFound(_(\"Token does not match any valid invitation.\"))","     return qs[0]"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01TAgMAxD539Wrpy2eVzE8LK","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
