@@ -0,0 +1,221 @@
+# -*- coding: utf-8 -*-
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+#
+# Copyright (c) 2021-present Kaleidos INC
+
+from datetime import timedelta
+
+import pytest
+
+from django.conf import settings
+from django.urls import reverse
+from django.utils import timezone
+
+from taiga.base.utils import json
+from taiga.projects.models import Membership
+from taiga.projects.services import generate_invitation_token
+from taiga.users.models import User
+
+from .. import factories as f
+
+pytestmark = pytest.mark.django_db
+
+
+def _assert_valid_expiration(membership, before):
+    assert membership.token
+    assert membership.token_expires_at is not None
+    after = timezone.now()
+    assert before + settings.INVITATION_TOKEN_LIFETIME <= membership.token_expires_at
+    assert membership.token_expires_at <= after + settings.INVITATION_TOKEN_LIFETIME
+
+
+def _expired_invitation(**kwargs):
+    return f.InvitationFactory(token_expires_at=timezone.now() - timedelta(seconds=1), **kwargs)
+
+
+def _legacy_invitation(**kwargs):
+    return f.InvitationFactory(token_expires_at=None, **kwargs)
+
+
+#################
+# Issuing
+#################
+
+def test_invitation_token_lifetime_is_one_week():
+    assert settings.INVITATION_TOKEN_LIFETIME == timedelta(days=7)
+
+
+def test_generate_invitation_token_returns_token_and_expiration():
+    before = timezone.now()
+    token, token_expires_at = generate_invitation_token()
+    other_token, _ = generate_invitation_token()
+
+    assert token and token != other_token
+    assert before + timedelta(days=7) <= token_expires_at <= timezone.now() + timedelta(days=7)
+
+
+def test_factories_create_invitations_with_valid_expiration():
+    before = timezone.now()
+    _assert_valid_expiration(f.InvitationFactory(), before)
+    _assert_valid_expiration(f.MembershipFactory(user=None), before)
+
+
+def test_api_create_invitation_sets_expiration(client, outbox):
+    role = f.RoleFactory.create()
+    f.MembershipFactory(project=role.project, user=role.project.owner, is_admin=True)
+    client.login(role.project.owner)
+
+    before = timezone.now()
+    data = {"role": role.pk, "project": role.project.pk, "username": "new-guest@email.com"}
+    response = client.json.post(reverse("memberships-list"), json.dumps(data))
+
+    assert response.status_code == 201, response.data
+    _assert_valid_expiration(Membership.objects.get(email="new-guest@email.com"), before)
+
+
+def test_api_bulk_create_invitations_sets_expiration(client, outbox):
+    project = f.ProjectFactory()
+    role = f.RoleFactory(project=project)
+    f.MembershipFactory(project=project, user=project.owner, is_admin=True)
+    client.login(project.owner)
+
+    before = timezone.now()
+    data = {
+        "project_id": project.id,
+        "bulk_memberships": [{"role_id": role.pk, "username": "bulk-guest@email.com"}],
+    }
+    response = client.json.post(reverse("memberships-bulk-create"), json.dumps(data))
+
+    assert response.status_code == 200, response.data
+    _assert_valid_expiration(Membership.objects.get(email="bulk-guest@email.com"), before)
+
+
+def test_project_import_sets_invitation_expiration(client):
+    user = f.UserFactory.create()
+    client.login(user)
+
+    before = timezone.now()
+    data = {
+        "name": "Imported project",
+        "description": "Imported project",
+        "memberships": [{
+            "email": "imported-guest@email.com",
+            "role": "Role",
+            "token": "123",
+        }],
+        "roles": [{"name": "Role"}]
+    }
+    response = client.json.post(reverse("importer-list"), json.dumps(data))
+
+    assert response.status_code == 201, response.data
+    _assert_valid_expiration(Membership.objects.get(email="imported-guest@email.com"), before)
+
+
+#################
+# Get invitation by token
+#################
+
+def test_get_invitation_with_valid_token(client):
+    invitation = f.InvitationFactory()
+    response = client.get(reverse("invitations-detail", kwargs={"token": invitation.token}))
+    assert response.status_code == 200, response.data
+
+
+@pytest.mark.parametrize("make_invitation", [_expired_invitation, _legacy_invitation])
+def test_get_invitation_with_expired_or_legacy_token_returns_404(client, make_invitation):
+    invitation = make_invitation()
+    response = client.get(reverse("invitations-detail", kwargs={"token": invitation.token}))
+    assert response.status_code == 404, response.data
+
+
+#################
+# Login and register with invitation token
+#################
+
+@pytest.mark.parametrize("make_invitation", [_expired_invitation, _legacy_invitation])
+def test_login_with_expired_or_legacy_invitation_token_returns_404(client, settings, make_invitation):
+    settings.PUBLIC_REGISTER_ENABLED = False
+    user = f.UserFactory()
+    invitation = make_invitation()
+
+    auth_data = {
+        "username": user.username,
+        "password": user.username,
+        "type": "normal",
+        "invitation_token": invitation.token,
+    }
+    response = client.post(reverse("auth-list"), auth_data)
+    invitation.refresh_from_db()
+
+    assert response.status_code == 404, response.data
+    assert invitation.user is None
+
+
+def test_private_register_with_valid_invitation_token(client):
+    invitation = f.InvitationFactory()
+
+    data = {
+        "type": "private",
+        "token": invitation.token,
+        "username": "newuser",
+        "email": "newuser@email.com",
+        "full_name": "New User",
+        "password": "password",
+        "accepted_terms": True,
+    }
+    response = client.post(reverse("auth-register"), data)
+    invitation.refresh_from_db()
+
+    assert response.status_code == 201, response.data
+    assert invitation.user.username == "newuser"
+
+
+@pytest.mark.parametrize("make_invitation", [_expired_invitation, _legacy_invitation])
+def test_private_register_with_expired_or_legacy_invitation_token_returns_404(client, make_invitation):
+    invitation = make_invitation()
+
+    data = {
+        "type": "private",
+        "token": invitation.token,
+        "username": "newuser",
+        "email": "newuser@email.com",
+        "full_name": "New User",
+        "password": "password",
+        "accepted_terms": True,
+    }
+    response = client.post(reverse("auth-register"), data)
+    invitation.refresh_from_db()
+
+    assert response.status_code == 404, response.data
+    assert invitation.user is None
+    assert not User.objects.filter(username="newuser").exists()
+
+
+#################
+# Resend
+#################
+
+@pytest.mark.parametrize("make_invitation", [f.InvitationFactory, _expired_invitation, _legacy_invitation])
+def test_resend_invitation_rotates_token_and_refreshes_expiration(client, outbox, make_invitation):
+    invitation = make_invitation()
+    f.MembershipFactory(project=invitation.project, user=invitation.project.owner, is_admin=True)
+    old_token = invitation.token
+    client.login(invitation.project.owner)
+
+    before = timezone.now()
+    response = client.post(reverse("memberships-resend-invitation", kwargs={"pk": invitation.pk}))
+    invitation.refresh_from_db()
+
+    assert response.status_code == 204, response.data
+    assert invitation.token != old_token
+    _assert_valid_expiration(invitation, before)
+    assert len(outbox) == 1
+    assert invitation.token in outbox[0].body
+
+    client.logout()
+    response = client.get(reverse("invitations-detail", kwargs={"token": old_token}))
+    assert response.status_code == 404
+    response = client.get(reverse("invitations-detail", kwargs={"token": invitation.token}))
+    assert response.status_code == 200, response.data
