+def generate_invitation_token():
+    """
+    Return a new invitation token and its expiration date, as a tuple
+    `(token, token_expires_at)`.
+
+    Every place that issues an invitation token must use this function
+    so the token and its expiration date are always set together.
+    """
+    token = str(uuid.uuid4())
+    token_expires_at = timezone.now() + settings.INVITATION_TOKEN_LIFETIME
+    return token, token_expires_at
+
+
+def set_invitation_token(membership):
+    """
+    Set a new invitation token and its expiration date on `membership`.
+    The membership is not saved.
+    """
+    membership.token, membership.token_expires_at = generate_invitation_token()
+    return membership
+
+
+def valid_invitations_filter():
+    """
+    Return the Q filter that matches pending invitations whose token is
+    still valid. Tokens without an expiration date (issued before
+    expiration existed) are treated as expired.
+    """
+    return Q(user_id__isnull=True, token_expires_at__gt=timezone.now())
