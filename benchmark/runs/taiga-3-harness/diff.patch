+# -*- coding: utf-8 -*-
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+#
+# Copyright (c) 2021-present Kaleidos INC
+
+from unittest import mock
+
+import pytest
+
+from taiga.importers.github import importer as github_importer
+from taiga.importers.github.importer import GithubImporter
+from taiga.projects.attachments.models import Attachment
+from taiga.projects.issues.models import Issue
+from taiga.projects.userstories.models import UserStory
+
+from .. import factories as f
+
+pytestmark = pytest.mark.django_db
+
+ASSET_1 = "https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111"
+ASSET_2 = "https://github.com/user-attachments/assets/22222222-2222-2222-2222-222222222222"
+CREATED_DATE = "2024-01-02T03:04:05Z"
+
+
+def _signed_url(github_url):
+    return "https://private-user-images.invalid/{}.png?jwt=token&x=1".format(github_url.rsplit("/", 1)[-1])
+
+
+def _render_markdown(markdown, repository_full_name):
+    github_url = markdown[len("![image]("):-1]
+    # GitHub escapes "&" in attributes; the importer must unescape it.
+    return '<p><a href="x"><img src="{}" alt="image"></a></p>'.format(
+        _signed_url(github_url).replace("&", "&amp;"))
+
+
+def _build_importer(client=None):
+    with mock.patch.object(github_importer, "GithubClient") as client_cls:
+        client_cls.return_value = client or mock.Mock()
+        client_cls.return_value.get.return_value = {"id": 1}
+        return GithubImporter(f.UserFactory.create(), "token")
+
+
+def _client(download=None):
+    client = mock.Mock()
+    client.render_markdown.side_effect = _render_markdown
+    client.download.side_effect = download or (
+        lambda url: (b"png-bytes", {"Content-Type": "image/png",
+                                    "Content-Disposition": 'attachment; filename="../dir/screenshot.png"'}))
+    return client
+
+
+def test_import_inline_images_replaces_urls_with_local_attachments():
+    client = _client()
+    importer = _build_importer(client)
+    issue = f.IssueFactory.create()
+    markdown = ("Before ![one]({a}) middle ![again]({a})\n"
+                '<img width="10" src="{b}" />').format(a=ASSET_1, b=ASSET_2)
+
+    result = importer._import_inline_images(markdown, issue, "owner/repo", CREATED_DATE)
+
+    attachments = list(Attachment.objects.filter(object_id=issue.id).order_by("id"))
+    assert len(attachments) == 2
+    assert client.render_markdown.call_count == 2
+    client.render_markdown.assert_any_call("![image]({})".format(ASSET_1), "owner/repo")
+    client.download.assert_any_call(_signed_url(ASSET_1))
+
+    first = attachments[0]
+    assert first.name == "screenshot.png"
+    assert first.size == len(b"png-bytes")
+    assert first.owner == issue.owner
+    assert first.project == issue.project
+    assert first.content_object == issue
+    assert first.is_deprecated is False
+    assert first.created_date.isoformat().startswith("2024-01-02T03:04:05")
+    assert first.attached_file.read() == b"png-bytes"
+
+    url_1 = "{}#_taiga-refresh=issue:{}".format(attachments[0].attached_file.url, attachments[0].id)
+    url_2 = "{}#_taiga-refresh=issue:{}".format(attachments[1].attached_file.url, attachments[1].id)
+    assert result == ('Before ![one]({a}) middle ![again]({a})\n'
+                      '<img width="10" src="{b}" />').format(a=url_1, b=url_2)
+    assert "github.com" not in result
+
+
+def test_import_inline_images_without_content_disposition_uses_asset_id():
+    client = _client(download=lambda url: (b"jpeg", {"content-type": "image/jpeg; charset=binary"}))
+    importer = _build_importer(client)
+    us = f.UserStoryFactory.create()
+
+    result = importer._import_inline_images("![x]({})".format(ASSET_1), us, "owner/repo", CREATED_DATE)
+
+    attachment = Attachment.objects.get(object_id=us.id)
+    assert attachment.name == "github-attachment-11111111-1111-1111-1111-111111111111.jpg"
+    assert "#_taiga-refresh=userstory:{}".format(attachment.id) in result
+
+
+def test_import_inline_images_keeps_link_of_failed_images():
+    def download(url):
+        if "11111111" in url:
+            raise Exception("Attachment download unavailable: 404")
+        return b"<html>", {"Content-Type": "text/html"}
+
+    client = _client(download=download)
+    importer = _build_importer(client)
+    issue = f.IssueFactory.create()
+    markdown = "![a]({}) ![b]({})".format(ASSET_1, ASSET_2)
+
+    with mock.patch.object(github_importer.logger, "warning") as warning:
+        result = importer._import_inline_images(markdown, issue, "owner/repo", CREATED_DATE)
+
+    assert result == markdown
+    assert warning.call_count == 2
+    assert not Attachment.objects.filter(object_id=issue.id).exists()
+
+
+def test_import_inline_images_keeps_link_when_render_has_no_image():
+    client = _client()
+    client.render_markdown.side_effect = lambda markdown, repo: "<p>nothing</p>"
+    importer = _build_importer(client)
+    issue = f.IssueFactory.create()
+    markdown = "![a]({})".format(ASSET_1)
+
+    with mock.patch.object(github_importer.logger, "warning") as warning:
+        assert importer._import_inline_images(markdown, issue, "owner/repo", CREATED_DATE) == markdown
+
+    warning.assert_called_once()
+    client.download.assert_not_called()
+
+
+def test_import_inline_images_without_images_does_not_call_github():
+    client = _client()
+    importer = _build_importer(client)
+    issue = f.IssueFactory.create()
+
+    assert importer._import_inline_images("plain text", issue, "owner/repo", CREATED_DATE) == "plain text"
+    client.render_markdown.assert_not_called()
+
+
+def _github_issue(body):
+    return {
+        "number": 7,
+        "title": "Issue with image",
+        "body": body,
+        "state": "open",
+        "labels": [],
+        "assignee": None,
+        "assignees": [],
+        "milestone": None,
+        "user": {"id": 999},
+        "html_url": "https://github.com/owner/repo/issues/7",
+        "created_at": CREATED_DATE,
+        "updated_at": "2024-01-03T03:04:05Z",
+    }
+
+
+@pytest.mark.parametrize("kind", ["user_stories", "issues"])
+def test_import_rewrites_description_with_local_images(kind):
+    client = _client(download=lambda url: (
+        (b"png", {"Content-Type": "image/png"}) if "11111111" in url
+        else (_ for _ in ()).throw(Exception("boom"))))
+    importer = _build_importer(client)
+    body = "Look ![a]({}) and ![b]({})".format(ASSET_1, ASSET_2)
+    client.get.side_effect = lambda path, params=None: [_github_issue(body)]
+
+    project = f.ProjectFactory.create()
+    if kind == "user_stories":
+        f.UserStoryStatusFactory.create(project=project, name="open")
+        importer._import_user_stories_data(project, {"full_name": "owner/repo"}, {})
+        obj = UserStory.objects.get(project=project, ref=7)
+    else:
+        f.IssueStatusFactory.create(project=project, name="open")
+        importer._import_issues_data(project, {"full_name": "owner/repo"}, {})
+        obj = Issue.objects.get(project=project, ref=7)
+
+    attachment = Attachment.objects.get(object_id=obj.id, project=project)
+    local_url = "{}#_taiga-refresh={}:{}".format(
+        attachment.attached_file.url, attachment.content_type.model, attachment.id)
+    assert obj.description == "Look ![a]({}) and ![b]({})".format(local_url, ASSET_2)
+    assert obj.modified_date.isoformat().startswith("2024-01-03T03:04:05")
