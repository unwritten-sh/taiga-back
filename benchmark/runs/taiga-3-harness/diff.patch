+    def _import_inline_images(self, markdown, obj, repository_full_name, created_date):
+        """
+        Download the GitHub inline images (user-attachments) found in
+        `markdown`, store them as attachments of `obj` and return the markdown
+        with the GitHub URLs replaced by the Taiga attachment URLs. If an image
+        can not be imported, its original URL is kept.
+        """
+        replacements = {}
+        for github_url in extract_github_inline_image_urls(markdown):
+            try:
+                replacements[github_url] = self._import_inline_image(
+                    github_url, obj, repository_full_name, created_date
+                )
+            except Exception as e:
+                logger.warning(
+                    "Unable to import GitHub inline image %s for %s %s: %s",
+                    github_url, obj.__class__.__name__, obj.id, e,
+                )
+
+        if not replacements:
+            return markdown
+        return _replace_github_inline_image_urls(markdown, replacements)
+
+    def _import_description_inline_images(self, obj, repository_full_name, created_date):
+        """
+        Import the inline images of `obj.description` and return the fields
+        to update (only the description, and only when it changed).
+        """
+        description = self._import_inline_images(obj.description, obj, repository_full_name, created_date)
+        if description == obj.description:
+            return {}
+        obj.description = description
+        return {"description": description}
+
+    def _import_inline_image(self, github_url, obj, repository_full_name, created_date):
+        html = self._client.render_markdown("![image]({})".format(github_url), repository_full_name)
+        signed_url = _first_image_src(html)
+        if not signed_url:
+            raise ValueError("no image found in the rendered markdown")
+
+        content, headers = self._client.download(signed_url)
+        content_type = (_get_header(headers, "Content-Type") or "").split(";")[0].strip().lower()
+        if not content_type.startswith("image/"):
+            raise ValueError("unexpected content type {!r}".format(content_type))
+
+        filename = _filename_from_content_disposition(_get_header(headers, "Content-Disposition"))
+        if not filename:
+            asset_id = github_url.rstrip("/").rsplit("/", 1)[-1]
+            filename = "github-attachment-{}{}".format(asset_id, mimetypes.guess_extension(content_type) or "")
+
+        attachment = Attachment(
+            owner=obj.owner,
+            project=obj.project,
+            content_type=ContentType.objects.get_for_model(obj),
+            object_id=obj.id,
+            name=filename,
+            size=len(content),
+            created_date=created_date,
+            is_deprecated=False,
+        )
+        attachment.attached_file.save(filename, ContentFile(content), save=True)
+
+        return "{}#{}".format(attachment.attached_file.url,
+                              attachments_services.generate_refresh_fragment(attachment))
+
