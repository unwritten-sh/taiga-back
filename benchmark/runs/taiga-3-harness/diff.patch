+def _replace_github_inline_image_urls(markdown, replacements):
+    def replace(match):
+        url = match.group("url")
+        new_url = replacements.get(url)
+        if new_url is None:
+            return match.group(0)
+        start, end = match.span("url")
+        offset = match.start(0)
+        text = match.group(0)
+        return text[:start - offset] + new_url + text[end - offset:]
+
+    for pattern in (GITHUB_INLINE_IMAGE_RE, GITHUB_INLINE_IMAGE_HTML_RE):
+        markdown = pattern.sub(replace, markdown)
+    return markdown
+
+
+class _FirstImageSrcParser(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.src = None
+
+    def handle_starttag(self, tag, attrs):
+        if self.src is None and tag == "img":
+            src = dict(attrs).get("src")
+            if src:
+                self.src = src
+
+    handle_startendtag = handle_starttag
+
+
+def _first_image_src(html):
+    parser = _FirstImageSrcParser()
+    parser.feed(html or "")
+    parser.close()
+    return parser.src
+
+
+def _get_header(headers, name):
+    if headers is None:
+        return None
+    value = headers.get(name)
+    if value is None:
+        lower_name = name.lower()
+        for key, header_value in headers.items():
+            if key.lower() == lower_name:
+                return header_value
+    return value
+
+
+def _filename_from_content_disposition(value):
+    if not value:
+        return None
+    message = Message()
+    message["Content-Disposition"] = value
+    filename = message.get_filename()
+    if not filename:
+        return None
+    filename = posixpath.basename(filename.replace("\\", "/")).strip()
+    if filename in ("", ".", ".."):
+        return None
+    return filename
+
