{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgdFUxqAnDH6ebg81Fc8q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NJZLdrJ7dVTGNkV596dYdn","name":"Write","input":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-3-harness/tests/integration/test_importers_github_inline_images.py","content":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nfrom unittest import mock\n\nimport pytest\n\nfrom taiga.importers.github import importer as github_importer\nfrom taiga.importers.github.importer import GithubImporter\nfrom taiga.projects.attachments.models import Attachment\nfrom taiga.projects.issues.models import Issue\nfrom taiga.projects.userstories.models import UserStory\n\nfrom .. import factories as f\n\npytestmark = pytest.mark.django_db\n\nASSET_1 = \"https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111\"\nASSET_2 = \"https://github.com/user-attachments/assets/22222222-2222-2222-2222-222222222222\"\nCREATED_DATE = \"2024-01-02T03:04:05Z\"\n\n\ndef _signed_url(github_url):\n    return \"https://private-user-images.invalid/{}.png?jwt=token&x=1\".format(github_url.rsplit(\"/\", 1)[-1])\n\n\ndef _render_markdown(markdown, repository_full_name):\n    github_url = markdown[len(\"![image](\"):-1]\n    # GitHub escapes \"&\" in attributes; the importer must unescape it.\n    return '<p><a href=\"x\"><img src=\"{}\" alt=\"image\"></a></p>'.format(\n        _signed_url(github_url).replace(\"&\", \"&amp;\"))\n\n\ndef _build_importer(client=None):\n    with mock.patch.object(github_importer, \"GithubClient\") as client_cls:\n        client_cls.return_value = client or mock.Mock()\n        client_cls.return_value.get.return_value = {\"id\": 1}\n        return GithubImporter(f.UserFactory.create(), \"token\")\n\n\ndef _client(download=None):\n    client = mock.Mock()\n    client.render_markdown.side_effect = _render_markdown\n    client.download.side_effect = download or (\n        lambda url: (b\"png-bytes\", {\"Content-Type\": \"image/png\",\n                                    \"Content-Disposition\": 'attachment; filename=\"../dir/screenshot.png\"'}))\n    return client\n\n\ndef test_import_inline_images_replaces_urls_with_local_attachments():\n    client = _client()\n    importer = _build_importer(client)\n    issue = f.IssueFactory.create()\n    markdown = (\"Before ![one]({a}) middle ![again]({a})\\n\"\n                '<img width=\"10\" src=\"{b}\" />').format(a=ASSET_1, b=ASSET_2)\n\n    result = importer._import_inline_images(markdown, issue, \"owner/repo\", CREATED_DATE)\n\n    attachments = list(Attachment.objects.filter(object_id=issue.id).order_by(\"id\"))\n    assert len(attachments) == 2\n    assert client.render_markdown.call_count == 2\n    client.render_markdown.assert_any_call(\"![image]({})\".format(ASSET_1), \"owner/repo\")\n    client.download.assert_any_call(_signed_url(ASSET_1))\n\n    first = attachments[0]\n    assert first.name == \"screenshot.png\"\n    assert first.size == len(b\"png-bytes\")\n    assert first.owner == issue.owner\n    assert first.project == issue.project\n    assert first.content_object == issue\n    assert first.is_deprecated is False\n    assert first.created_date.isoformat().startswith(\"2024-01-02T03:04:05\")\n    assert first.attached_file.read() == b\"png-bytes\"\n\n    url_1 = \"{}#_taiga-refresh=issue:{}\".format(attachments[0].attached_file.url, attachments[0].id)\n    url_2 = \"{}#_taiga-refresh=issue:{}\".format(attachments[1].attached_file.url, attachments[1].id)\n    assert result == ('Before ![one]({a}) middle ![again]({a})\\n'\n                      '<img width=\"10\" src=\"{b}\" />').format(a=url_1, b=url_2)\n    assert \"github.com\" not in result\n\n\ndef test_import_inline_images_without_content_disposition_uses_asset_id():\n    client = _client(download=lambda url: (b\"jpeg\", {\"content-type\": \"image/jpeg; charset=binary\"}))\n    importer = _build_importer(client)\n    us = f.UserStoryFactory.create()\n\n    result = importer._import_inline_images(\"![x]({})\".format(ASSET_1), us, \"owner/repo\", CREATED_DATE)\n\n    attachment = Attachment.objects.get(object_id=us.id)\n    assert attachment.name == \"github-attachment-11111111-1111-1111-1111-111111111111.jpg\"\n    assert \"#_taiga-refresh=userstory:{}\".format(attachment.id) in result\n\n\ndef test_import_inline_images_keeps_link_of_failed_images():\n    def download(url):\n        if \"11111111\" in url:\n            raise Exception(\"Attachment download unavailable: 404\")\n        return b\"<html>\", {\"Content-Type\": \"text/html\"}\n\n    client = _client(download=download)\n    importer = _build_importer(client)\n    issue = f.IssueFactory.create()\n    markdown = \"![a]({}) ![b]({})\".format(ASSET_1, ASSET_2)\n\n    with mock.patch.object(github_importer.logger, \"warning\") as warning:\n        result = importer._import_inline_images(markdown, issue, \"owner/repo\", CREATED_DATE)\n\n    assert result == markdown\n    assert warning.call_count == 2\n    assert not Attachment.objects.filter(object_id=issue.id).exists()\n\n\ndef test_import_inline_images_keeps_link_when_render_has_no_image():\n    client = _client()\n    client.render_markdown.side_effect = lambda markdown, repo: \"<p>nothing</p>\"\n    importer = _build_importer(client)\n    issue = f.IssueFactory.create()\n    markdown = \"![a]({})\".format(ASSET_1)\n\n    with mock.patch.object(github_importer.logger, \"warning\") as warning:\n        assert importer._import_inline_images(markdown, issue, \"owner/repo\", CREATED_DATE) == markdown\n\n    warning.assert_called_once()\n    client.download.assert_not_called()\n\n\ndef test_import_inline_images_without_images_does_not_call_github():\n    client = _client()\n    importer = _build_importer(client)\n    issue = f.IssueFactory.create()\n\n    assert importer._import_inline_images(\"plain text\", issue, \"owner/repo\", CREATED_DATE) == \"plain text\"\n    client.render_markdown.assert_not_called()\n\n\ndef _github_issue(body):\n    return {\n        \"number\": 7,\n        \"title\": \"Issue with image\",\n        \"body\": body,\n        \"state\": \"open\",\n        \"labels\": [],\n        \"assignee\": None,\n        \"assignees\": [],\n        \"milestone\": None,\n        \"user\": {\"id\": 999},\n        \"html_url\": \"https://github.com/owner/repo/issues/7\",\n        \"created_at\": CREATED_DATE,\n        \"updated_at\": \"2024-01-03T03:04:05Z\",\n    }\n\n\n@pytest.mark.parametrize(\"kind\", [\"user_stories\", \"issues\"])\ndef test_import_rewrites_description_with_local_images(kind):\n    client = _client(download=lambda url: (\n        (b\"png\", {\"Content-Type\": \"image/png\"}) if \"11111111\" in url\n        else (_ for _ in ()).throw(Exception(\"boom\"))))\n    importer = _build_importer(client)\n    body = \"Look ![a]({}) and ![b]({})\".format(ASSET_1, ASSET_2)\n    client.get.side_effect = lambda path, params=None: [_github_issue(body)]\n\n    project = f.ProjectFactory.create()\n    if kind == \"user_stories\":\n        f.UserStoryStatusFactory.create(project=project, slug=\"open\")\n        importer._import_user_stories_data(project, {\"full_name\": \"owner/repo\"}, {})\n        obj = UserStory.objects.get(project=project, ref=7)\n    else:\n        f.IssueStatusFactory.create(project=project, slug=\"open\")\n        importer._import_issues_data(project, {\"full_name\": \"owner/repo\"}, {})\n        obj = Issue.objects.get(project=project, ref=7)\n\n    attachment = Attachment.objects.get(object_id=obj.id, project=project)\n    local_url = \"{}#_taiga-refresh={}:{}\".format(\n        attachment.attached_file.url, attachment.content_type.model, attachment.id)\n    assert obj.description == \"Look ![a]({}) and ![b]({})\".format(local_url, ASSET_2)\n    assert obj.modified_date.isoformat().startswith(\"2024-01-03T03:04:05\")\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":876,"cache_read_input_tokens":47931,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":876},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"baa3384c-479d-4a62-80cd-aa42e3f5ff18","uuid":"73a6009b-9904-446b-ae46-4b9f8fe2a768","timestamp":"2026-11-02T01:41:35.772Z","request_id":"req_011CgdFUxc2p1fsPNfKsLSvQ","wire_tool_inputs":{"toolu_01NJZLdrJ7dVTGNkV596dYdn":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-3-harness/tests/integration/test_importers_github_inline_images.py","content":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nfrom unittest import mock\n\nimport pytest\n\nfrom taiga.importers.github import importer as github_importer\nfrom taiga.importers.github.importer import GithubImporter\nfrom taiga.projects.attachments.models import Attachment\nfrom taiga.projects.issues.models import Issue\nfrom taiga.projects.userstories.models import UserStory\n\nfrom .. import factories as f\n\npytestmark = pytest.mark.django_db\n\nASSET_1 = \"https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111\"\nASSET_2 = \"https://github.com/user-attachments/assets/22222222-2222-2222-2222-222222222222\"\nCREATED_DATE = \"2024-01-02T03:04:05Z\"\n\n\ndef _signed_url(github_url):\n    return \"https://priva