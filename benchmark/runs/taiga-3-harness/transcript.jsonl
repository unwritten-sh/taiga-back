irst.project == issue.project\n    assert first.content_object == issue\n    assert first.is_deprecated is False\n    assert first.created_date.isoformat().startswith(\"2024-01-02T03:04:05\")\n    assert first.attached_file.read() == b\"png-bytes\"\n\n    url_1 = \"{}#_taiga-refresh=issue:{}\".format(attachments[0].attached_file.url, attachments[0].id)\n    url_2 = \"{}#_taiga-refresh=issue:{}\".format(attachments[1].attached_file.url, attachments[1].id)\n    assert result == ('Before ![one]({a}) middle ![again]({a})\\n'\n                      '<img width=\"10\" src=\"{b}\" />').format(a=url_1, b=url_2)\n    assert \"github.com\" not in result\n\n\ndef test_import_inline_images_without_content_disposition_uses_asset_id():\n    client = _client(download=lambda url: (b\"jpeg\", {\"content-type\": \"image/jpeg; charset=binary\"}))\n    importer = _build_importer(client)\n    us = f.UserStoryFactory.create()\n\n    result = importer._import_inline_images(\"![x]({})\".format(ASSET_1), us, \"owner/repo\", CREATED_DATE)\n\n    attachment = Attachment.objects.get(object_id=us.id)\n    assert attachment.name == \"github-attachment-11111111-1111-1111-1111-111111111111.jpg\"\n    assert \"#_taiga-refresh=userstory:{}\".format(attachment.id) in result\n\n\ndef test_import_inline_images_keeps_link_of_failed_images():\n    def download(url):\n        if \"11111111\" in url:\n            raise Exception(\"Attachment download unavailable: 404\")\n        return b\"<html>\", {\"Content-Type\": \"text/html\"}\n\n    client = _client(download=download)\n    importer = _build_importer(client)\n    issue = f.IssueFactory.create()\n    markdown = \"![a]({}) ![b]({})\".format(ASSET_1, ASSET_2)\n\n    with mock.patch.object(github_importer.logger, \"warning\") as warning:\n        result = importer._import_inline_images(markdown, issue, \"owner/repo\", CREATED_DATE)\n\n    assert result == markdown\n    assert warning.call_count == 2\n    assert not Attachment.objects.filter(object_id=issue.id).exists()\n\n\ndef test_import_inline_images_keeps_link_when_render_has_no_image():\n    client = _client()\n    client.render_markdown.side_effect = lambda markdown, repo: \"<p>nothing</p>\"\n    importer = _build_importer(client)\n    issue = f.IssueFactory.create()\n    markdown = \"![a]({})\".format(ASSET_1)\n\n    with mock.patch.object(github_importer.logger, \"warning\") as warning:\n        assert importer._import_inline_images(markdown, issue, \"owner/repo\", CREATED_DATE) == markdown\n\n    warning.assert_called_once()\n    client.download.assert_not_called()\n\n\ndef test_import_inline_images_without_images_does_not_call_github():\n    client = _client()\n    importer = _build_importer(client)\n    issue = f.IssueFactory.create()\n\n    assert importer._import_inline_images(\"plain text\", issue, \"owner/repo\", CREATED_DATE) == \"plain text\"\n    client.render_markdown.assert_not_called()\n\n\ndef _github_issue(body):\n    return {\n        \"number\": 7,\n        \"title\": \"Issue with image\",\n        \"body\": body,\n        \"state\": \"open\",\n        \"labels\": [],\n        \"assignee\": None,\n        \"assignees\": [],\n        \"milestone\": None,\n        \"user\": {\"id\": 999},\n        \"html_url\": \"https://github.com/owner/repo/issues/7\",\n        \"created_at\": CREATED_DATE,\n        \"updated_at\": \"2024-01-03T03:04:05Z\",\n    }\n\n\n@pytest.mark.parametrize(\"kind\", [\"user_stories\", \"issues\"])\ndef test_import_rewrites_description_with_local_images(kind):\n    client = _client(download=lambda url: (\n        (b\"png\", {\"Content-Type\": \"image/png\"}) if \"11111111\" in url\n        else (_ for _ in ()).throw(Exception(\"boom\"))))\n    importer = _build_importer(client)\n    body = \"Look ![a]({}) and ![b]({})\".format(ASSET_1, ASSET_2)\n    client.get.side_effect = lambda path, params=None: [_github_issue(body)]\n\n    project = f.ProjectFactory.create()\n    if kind == \"user_stories\":\n        f.UserStoryStatusFactory.create(project=project, slug=\"open\")\n        importer._import_user_stories_data(project, {\"full_name\": \"owner/repo\"}, {})\n        obj = UserStory.objects.get(project=project, ref=7)\n    else:\n        f.IssueStatusFactory.create(project=project, slug=\"open\")\n        importer._import_issues_data(project, {\"full_name\": \"owner/repo\"}, {})\n        obj = Issue.objects.get(project=project, ref=7)\n\n    attachment = Attachment.objects.get(object_id=obj.id, project=project)\n    local_url = \"{}#_taiga-refresh={}:{}\".format(\n        attachment.attached_file.url, attachment.content_type.model, attachment.id)\n    assert obj.description == \"Look ![a]({}) and ![b]({})\".format(local_url, ASSET_2)\n    assert obj.modified_date.isoformat().startswith(\"2024-01-03T03:04:05\")\n"}}}
