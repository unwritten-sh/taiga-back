+def generate_invitation_token():
+    """
+    Generate a new invitation token and its expiration date.
+
+    Every place that issues an invitation token must use this function,
+    so the token and its expiration date are always set together.
+
+    :return: A tuple `(token, token_expires_at)`.
+    """
+    return str(uuid.uuid4()), timezone.now() + INVITATION_TOKEN_LIFETIME
+
+
+def set_invitation_token(membership):
+    """
+    Issue a new invitation token (and its expiration date) for a membership.
+    The membership is not saved.
+    """
+    membership.token, membership.token_expires_at = generate_invitation_token()
+    return membership
+
+
+def rotate_invitation_token(membership):
+    """
+    Issue a new invitation token for a pending membership and save it.
+    Previous tokens stop working.
+    """
+    set_invitation_token(membership)
+    membership.save(update_fields=["token", "token_expires_at"])
+    return membership
+
