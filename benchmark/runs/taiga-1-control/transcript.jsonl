nerate_invitation_token()[0] != token\n\n\ndef test_get_members_from_bulk_sets_token_expiration():\n    data = [{\"role_id\": \"1\", \"username\": \"member1@email.com\"}]\n    before = timezone.now()\n    members = services.get_members_from_bulk(data, project_id=1)\n    after = timezone.now()\n\n    _assert_valid_expiration(members[0], before, after)\n\n\ndef test_api_create_invitation_sets_token_expiration(client):\n    membership = f.MembershipFactory(is_admin=True)\n    role = f.RoleFactory.create(project=membership.project)\n\n    client.login(membership.user)\n    url = reverse(\"memberships-list\")\n    data = {\"role\": role.pk, \"project\": role.project.pk, \"username\": \"new-user@email.com\"}\n    before = timezone.now()\n    response = client.json.post(url, json.dumps(data))\n    after = timezone.now()\n\n    assert response.status_code == 201, response.data\n    invitation = Membership.objects.get(id=response.data[\"id\"])\n    assert invitation.user is None\n    _assert_valid_expiration(invitation, before, after)\n\n\ndef test_api_create_invitation_ignores_client_token(client):\n    membership = f.MembershipFactory(is_admin=True)\n    role = f.RoleFactory.create(project=membership.project)\n\n    client.login(membership.user)\n    url = reverse(\"memberships-list\")\n    far_future = timezone.now() + datetime.timedelta(days=3650)\n    data = {\"role\": role.pk, \"project\": role.project.pk, \"username\": \"new-user@email.com\",\n            \"token\": \"client-token\", \"token_expires_at\": far_future.isoformat()}\n    before = timezone.now()\n    response = client.json.post(url, json.dumps(data))\n    after = timezone.now()\n\n    assert response.status_code == 201, response.data\n    invitation = Membership.objects.get(id=response.data[\"id\"])\n    assert invitation.token != \"client-token\"\n    _assert_valid_expiration(invitation, before, after)\n\n\ndef test_api_create_bulk_invitations_sets_token_expiration(client):\n    membership = f.MembershipFactory(is_admin=True)\n    role = f.RoleFactory.create(project=membership.project, permissions=[\"view_project\"])\n\n    client.login(membership.user)\n    url = reverse(\"memberships-bulk-create\")\n    data = {\n        \"project_id\": membership.project.id,\n        \"bulk_memberships\": [{\"role_id\": role.pk, \"username\": \"new-user@email.com\"}],\n    }\n    before = timezone.now()\n    response = client.json.post(url, json.dumps(data))\n    after = timezone.now()\n\n    assert response.status_code == 200, response.data\n    invitation = Membership.objects.get(project=membership.project, email=\"new-user@email.com\")\n    _assert_valid_expiration(invitation, before, after)\n\n\ndef test_api_get_invitation_by_valid_token(client):\n    invitation = f.MembershipFactory(user=None)\n    url = reverse(\"invitations-detail\", kwargs={\"token\": invitation.token})\n\n    response = client.get(url)\n\n    assert response.status_code == 200, response.data\n    assert response.data[\"id\"] == invitation.id\n\n\n@pytest.mark.parametrize(\"token_expires_at\", [\n    timezone.now() - datetime.timedelta(seconds=1),  # expired\n    None,  # legacy token, issued without an expiration date\n])\ndef test_api_get_invitation_by_expired_token(client, token_expires_at):\n    invitation = f.MembershipFactory(user=None, token_expires_at=token_expires_at)\n    url = reverse(\"invitations-detail\", kwargs={\"token\": invitation.token})\n\n    response = client.get(url)\n\n    assert response.status_code == 404, response.data\n\n\ndef test_api_resend_invitation_rotates_token(client, outbox):\n    invitation = f.create_invitation(user=None, token_expires_at=timezone.now() + datetime.timedelta(minutes=1))\n    f.MembershipFactory(project=invitation.project, user=invitation.project.owner, is_admin=True)\n    old_token = invitation.token\n\n    client.login(invitation.project.owner)\n    url = reverse(\"memberships-resend-invitation\", kwargs={\"pk\": invitation.pk})\n    before = timezone.now()\n    response = client.post(url)\n    after = timezone.now()\n\n    assert response.status_code == 204\n    invitation.refresh_from_db()\n    assert invitation.token != old_token\n    _assert_valid_expiration(invitation, before, after)\n\n    # The new token is sent in the email\n    assert len(outbox) == 1\n    assert invitation.token in outbox[0].body\n\n    # The old link does not work anymore, the new one works\n    client.logout()\n    response = client.get(reverse(\"invitations-detail\", kwargs={\"token\": old_token}))\n    assert response.status_code == 404\n    response = client.get(reverse(\"invitations-detail\", kwargs={\"token\": invitation.token}))\n    assert response.status_code == 200\n\n\n@pytest.mark.parametrize(\"token_expires_at\", [\n    timezone.now() - datetime.timedelta(seconds=1),  # expired\n    None,  # legacy token, issued without an expiration date\n])\ndef test_api_resend_expired_invitation_gives_a_new_valid_token(client, outbox, token_expires_at):\n    invitation = f.create_invitation(user=None, token_expires_at=token_expires_at)\n    f.MembershipFactory(project=invitation.project, user=invitation.project.owner, is_admin=True)\n    old_token = invitation.token\n\n    client.login(invitation.project.owner)\n    url = reverse(\"memberships-resend-invitation\", kwargs={\"pk\": invitation.pk})\n    response = client.post(url)\n\n    assert response.status_code == 204\n    invitation.refresh_from_db()\n    assert invitation.token != old_token\n    assert invitation.token_expires_at > timezone.now()\n\n    client.logout()\n    response = client.get(reverse(\"invitations-detail\", kwargs={\"token\": invitation.token}))\n    assert response.status_code == 200\n'''\nopen(p,'w').write(s)\n\np='tests/integration/test_importer_api.py'\ns=open(p).read()\na='''    assert Membership.objects.filter(email=\"with-uuid@email.com\", token=\"123\").count() == 0\n'''\nb=a+'''    invitation = Membership.objects.get(email=\"with-uuid@email.com\")\n    a