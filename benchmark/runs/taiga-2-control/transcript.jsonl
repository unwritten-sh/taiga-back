ation/json\",\n    )\n    after = timezone.now()\n\n    assert response.status_code == 200\n    assert len(mail.outbox) == 1\n    user.refresh_from_db()\n    assert user.token is not None\n    assert user.token in mail.outbox[0].body\n    assert before + datetime.timedelta(minutes=30) <= user.token_expires_at\n    assert user.token_expires_at <= after + datetime.timedelta(minutes=30)\n\n\ndef test_password_recovery_default_token_lifetime_is_one_hour():\n    assert settings.PASSWORD_RECOVERY_TOKEN_LIFETIME == datetime.timedelta(hours=1)\n\n\ndef test_password_recovery_requested_again_replaces_token_and_expiration_date(client):\n    old_expires_at = timezone.now() + datetime.timedelta(minutes=5)\n    user = f.UserFactory.create(username=\"recovery-user\", token=\"old-recovery-token\",\n                                token_expires_at=old_expires_at)\n\n    response = client.post(\n        reverse(\"users-password-recovery\"),\n        json.dumps({\"username\": \"recovery-user\"}),\n        content_type=\"application/json\",\n    )\n\n    assert response.status_code == 200\n    user.refresh_from_db()\n    assert user.token not in (None, \"old-recovery-token\")\n    assert user.token_expires_at > old_expires_at\n\n    response = client.post(\n        reverse(\"users-change-password-from-recovery\"),\n        json.dumps({\"token\": \"old-recovery-token\", \"password\": \"new-password\"}),\n        content_type=\"application/json\",\n    )\n    assert response.status_code == 400\n\n\ndef test_change_password_from_recovery_with_valid_token(client):\n    user = f.UserFactory.create(token=\"recovery-token\",\n                                token_expires_at=timezone.now() + datetime.timedelta(minutes=10))\n    user.set_password(\"current-password\")\n    user.save()\n\n    response = client.post(\n        reverse(\"users-change-password-from-recovery\"),\n        json.dumps({\"token\": \"recovery-token\", \"password\": \"new-password\"}),\n        content_type=\"application/