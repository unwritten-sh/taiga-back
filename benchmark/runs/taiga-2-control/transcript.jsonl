a = {}\n50\t\n51\t    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n52\t    assert response.status_code == 405\n53\t\n54\t    client.login(user)\n55\t\n56\t    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n57\t    assert response.status_code == 405\n58\t\n59\t\n60\t##############################\n61\t## Test sanitize full name\n62\t##############################\n63\t\n64\tINVALID_NAMES = [\n65\t    \"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod\",\n66\t    \"an <script>evil()</script> example\",\n67\t    \"http://testdomain.com\",\n68\t    \"https://testdomain.com\",\n69\t    \"Visit http://testdomain.com\",\n70\t]\n71\t\n72\t@pytest.mark.parametrize(\"full_name\", INVALID_NAMES)\n73\tdef test_sanitize_invalid_user_full_name(client, full_name):\n74\t    user = f.UserFactory.create(full_name=\"test_name\")\n75\t    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n76\t\n77\t    client.login(user)\n78\t    data = {\"full_name\": full_name}\n79\t    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n80\t    assert response.status_code == 400\n81\t\n82\tVALID_NAMES = [\n83\t    \"martin seamus mcfly\"\n84\t]\n85\t\n86\t@pytest.mark.parametrize(\"full_name\", VALID_NAMES)\n87\tdef test_sanitize_valid_user_full_name(client, full_name):\n88\t    user = f.UserFactory.create(full_name=\"test_name\")\n89\t    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n90\t\n91\t    client.login(user)\n92\t    data = {\"full_name\": full_name}\n93\t    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n94\t    assert response.status_code == 200\n95\t\n96\t\n97\t##############################\n98\t## Change email\n99\t##############################\n100\t\n101\tdef test_update_user_with_same_email(client):\n102\t    user = f.UserFactory.create(email=\"same@email.com\")\n103\t    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n104\t    data = {\"email\": \"same@email.com\"}\n105\t\n106\t    client.login(user)\n107\t    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n108\t\n109\t    assert response.status_code == 400\n110\t    assert response.data['_error_message'] == 'Duplicated email'\n111\t\n112\t    user.refresh_from_db()\n113\t    assert user.email == \"same@email.com\"\n114\t\n115\t\n116\tdef test_update_user_with_duplicated_email(client):\n117\t    f.UserFactory.create(email=\"one@email.com\")\n118\t    user = f.UserFactory.create(email=\"two@email.com\")\n119\t    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n120\t    data = {\"email\": \"one@email.com\"}\n121\t\n122\t    client.login(user)\n123\t    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n124\t\n125\t    assert response.status_code == 400\n126\t    assert response.data['_error_message'] == 'Duplicated email'\n127\t\n128\t    user.refresh_from_db()\n129\t    assert user.email == \"two@email.com\"\n130\t\n131\t\n132\tdef test_update_user_with_invalid_email(client):\n133\t    user = f.UserFactory.create(email=\"my@email.com\")\n134\t    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n135\t    data = {\"email\": \"my@email\"}\n136\t\n137\t    client.login(user)\n138\t    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n139\t\n140\t    assert response.status_code == 400\n141\t    assert response.data['_error_message'] == 'Invalid email'\n142\t\n143\t    user.refresh_from_db()\n144\t    assert user.email == \"my@email.com\"\n145\t\n146\t\n147\tdef test_update_user_with_unallowed_domain_email(client, settings):\n148\t    settings.USER_EMAIL_ALLOWED_DOMAINS = ['email.com']\n149\t    user = f.UserFactory.create(email=\"my@email.com\")\n150\t    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n151\t    data = {\"email\": \"my@invalid-email.com\"}\n152\t\n153\t    client.login(user)\n154\t    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n155\t\n156\t    assert response.status_code == 400\n157\t    assert response.data['_error_message'] == 'Invalid email'\n158\t\n159\t    user.refresh_from_db()\n160\t    assert user.email == \"my@email.com\"\n161\t\n162\tdef test_update_user_with_allowed_domain_email(client, settings):\n163\t    settings.USER_EMAIL_ALLOWED_DOMAINS = ['email.com']\n164\t\n165\t    user = f.UserFactory.create(email=\"old@email.com\")\n166\t    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n167\t    data = {\"email\": \"new@email.com\"}\n168\t\n169\t    client.login(user)\n170\t    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n171\t\n172\t    assert response.status_code == 200\n173\t\n174\t    user.refresh_from_db()\n175\t    assert user.email == \"old@email.com\"\n176\t    assert user.email_token is not None\n177\t    assert user.new_email == \"new@email.com\"\n178\t\n179\t\n180\tdef test_update_user_with_valid_email(client):\n181\t    user = f.UserFactory.create(email=\"old@email.com\")\n182\t    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n183\t    data = {\"email\": \"new@email.com\"}\n184\t\n185\t    client.login(user)\n186\t    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n187\t\n188\t    assert response.status_code == 200\n189\t    user.refresh_from_db()\n190\t    assert user.email == \"old@email.com\"\n191\t    assert user.email_token is not None\n192\t    assert user.new_email == \"new@email.com\"\n193\t\n194\t\n195\tdef test_change_password_invalidates_password_recovery_token(client):\n196\t    user = f.UserFactory.create()\n197\t    user.set_password(\"current-password\")\n198\t    user.token = \"recovery-token\"\n199\t    user.save()\n200\t\n201\t    client.login(user)\n202\t    url = reverse('users-change-password')\n203\t    data = {\n204\t        \"current_password\": \"current-password\",\n205\t        \"password\": \"new-password\",\n206\t    }\n207\t\n208\t    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n209\t\n210\t    assert response.status_code == 204\n211\t    user.refresh_from_db()\n212\t    assert user.check_password(\"new-password\")\n213\t    assert user.token is None\n214\t\n215\t    recovery_url = reverse('users-change-password-from-recovery')\n216\t    recovery_data = {\"token\": \"recovery-token\", \"password\": \"another-password\"}\n217\t    response = client.post(recovery_url, json.dumps(recovery_data), content_type=\"application/json\")\n218\t\n219\t    assert response.status_code == 400\n220\t    user.refresh_from_db()\n221\t    assert user.check_password(\"new-password\")\n222\t\n223\t\n224\t@pytest.mark.parametrize((\"password_length\", \"status_code\"), [(128, 204), (129, 400)])\n225\tdef test_change_password_max_length(client, password_length, status_code):\n226\t    user = f.UserFactory.create()\n227\t    user.set_password(\"current-password\")\n228\t    user.save()\n229\t    client.login(user)\n230\t\n231\t    response = client.post(\n232\t        reverse('users-change-password'),\n233\t        json.dumps({\"current_password\": \"current-password\", \"password\": \"p\" * password_length}),\n234\t        content_type=\"application/json\",\n235\t    )\n236\t\n237\t    assert response.status_code == status_code\n238\t    user.refresh_from_db()\n239\t    assert user.check_password(\"p\" * password_length if status_code == 204 else \"current-password\")\n240\t\n241\t\n242\t@pytest.mark.parametrize((\"password_length\", \"status_code\"), [(128, 204), (129, 400)])\n243\tdef test_recovery_password_max_length(client, password_length, status_code):\n244\t    user = f.UserFactory.create(token=\"recovery-token\")\n245\t    user.set_password(\"current-password\")\n246\t    user.save()\n247\t\n248\t    response = client.post(\n249\t        reverse('users-change-password-from-recovery'),\n250\t        json.dumps({\"token\": \"recovery-token\", \"password\": \"p\" * password_length}),\n251\t        content_type=\"application/json\",\n252\t    )\n253\t\n254\t    assert response.status_code == status_code\n255\t    user.refresh_from_db()\n256\t    assert user.check_password(\"p\" * password_length if status_code == 204 else \"current-password\")\n257\t\n258\t\n259\tdef test_password_recovery_returns_200_for_unknown_username(client):\n260\t    response = client.post(\n261\t        reverse(\"users-password-recovery\"),\n262\t        json.dumps({\"username\": \"unknown-user\"}),\n263\t        content_type=\"application/json\",\n264\t    )\n265\t\n266\t    assert response.status_code == 200\n267\t    assert response.data == {\n268\t        \"detail\": \"If an account exists for the given username or email, \"\n269\t        \"you'll receive an email with a link to set a new password.\"\n270\t    }\n271\t    assert len(mail.outbox) == 0\n272\t\n273\t\n274\tdef test_password_recovery_returns_200_for_unknown_email(client):\n275\t    response = client.post(\n276\t        reverse(\"users-password-recovery\"),\n277\t        json.dumps({\"username\": \"unknown@email.com\"}),\n278\t        content_type=\"application/json\",\n279\t    )\n280\t\n281\t    assert response.status_code == 200\n282\t    assert response.data == {\n283\t        \"detail\": \"If an account exists for the given username or email, \"\n284\t        \"you'll receive an email with a link to set a new password.\"\n285\t    }\n286\t    assert len(mail.outbox) == 0\n287\t\n288\t\n289\tdef test_password_recovery_without_username_returns_400(client):\n290\t    response = client.post(\n291\t        reverse(\"users-password-recovery\"),\n292\t        json.dumps({}),\n293\t        content_type=\"application/json\",\n294\t    )\n295\t\n296\t    assert response.status_code == 400\n297\t\n298\t\n299\tdef test_validate_requested_email_change(client):\n300\t    user = f.UserFactory.create(email=\"old@email.com\", email_token=\"change_email_token\", new_email=\"new@email.com\")\n301\t    url = reverse('users-change-email')\n302\t    data = {\"email_token\": \"change_email_token\"}\n303\t\n304\t    client.login(user)\n305\t    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n306\t\n307\t    assert response.status_code == 204\n308\t    user.refresh_from_db()\n309\t    assert user.email_token is None\n310\t    assert user.new_email is None\n311\t    assert user.email == \"new@email.com\"\n312\t\n313\t\n314\tdef test_validate_requested_email_change_invalidates_password_recovery_token(client):\n315\t    user = f.UserFactory.create(\n316\t        email=\"old@email.com\",\n317\t        email_token=\"change_email_token\",\n318\t        new_email=\"new@email.com\",\n319\t        token=\"recovery-token\",\n320\t    )\n321\t    user.set_password(\"current-password\")\n322\t    user.save()\n323\t\n324\t    client.login(user)\n325\t    url = reverse('users-change-email')\n326\t    data = {\"email_token\": \"change_email_token\"}\n327\t\n328\t    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n329\t\n330\t    assert response.status_code == 204\n331\t    user.refresh_from_db()\n332\t    assert user.email == \"new@email.com\"\n333\t    assert user.email_token is None\n334\t    assert user.token is None\n335\t\n336\t    recovery_url = reverse('users-change-password-from-recovery')\n337\t    recovery_data = {\"token\": \"recovery-token\", \"password\": \"new-password\"}\n338\t    response = client.post(recovery_url, json.dumps(recovery_data), content_type=\"application/json\")\n339\t\n340\t    assert response.status_code == 400"}]},"parent_tool_use_id":null,"session_id":"4dbed559-4109-490c-a8e2-32272a58235f","uuid":"269edd82-90c1-49a9-b897-f0c09ce91d40","timestamp":"2026-11-02T05:23:36.737Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-2-control/tests/integration/test_users.py","content":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nimport pytest\nimport datetime\nfrom tempfile import NamedTemporaryFile\n\nfrom django.conf import settings\nfrom django.contrib.contenttypes.models import ContentType\nfrom django.core import mail\nfrom django.urls import reverse\nfrom django.core.files import File\nfrom django.core.cache import cache as default_cache\n\nfrom .. import factories as f\nfrom ..utils import DUMMY_BMP_DATA\n\nfrom taiga.base.utils import json\nfrom taiga.base.utils.thumbnails import get_thumbnail_url\nfrom taiga.base.utils.dicts import into_namedtuple\nfrom taiga.users import models\nfrom taiga.users.serializers import LikedObjectSerializer, VotedObjectSerializer\nfrom taiga.auth.tokens import AccessToken, CancelToken\nfrom taiga.permissions.choices import MEMBERS_PERMISSIONS, ANON_PERMISSIONS\nfrom taiga.projects import choices as project_choices\nfrom taiga.users.services import get_watched_list, get_voted_list, get_liked_list\nfrom taiga.projects.notifications.choices import NotifyLevel\nfrom taiga.projects.notifications.models import NotifyPolicy\n\nfrom easy_thumbnails.files import generate_all_aliases, get_thumbnailer\n\nimport os\n\npytestmark = pytest.mark.django_db\n\n\n##############################\n## Create user\n##############################\n\ndef test_users_create_through_standard_api(client):\n    user = f.UserFactory.create(is_superuser=True)\n\n    url = reverse('users-list')\n    data = {}\n\n    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n    assert response.status_code == 405\n\n    client.login(user)\n\n    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n    assert response.status_code == 405\n\n\n##############################\n## Test sanitize full name\n##############################\n\nINVALID_NAMES = [\n    \"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod\",\n    \"an <script>evil()</script> example\",\n    \"http://testdomain.com\",\n    \"https://testdomain.com\",\n    \"Visit http://testdomain.com\",\n]\n\n@pytest.mark.parametrize(\"full_name\", INVALID_NAMES)\ndef test_sanitize_invalid_user_full_name(client, full_name):\n    user = f.UserFactory.create(full_name=\"test_name\")\n    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n\n    client.login(user)\n    data = {\"full_name\": full_name}\n    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n    assert response.status_code == 400\n\nVALID_NAMES = [\n    \"martin seamus mcfly\"\n]\n\n@pytest.mark.parametrize(\"full_name\", VALID_NAMES)\ndef test_sanitize_valid_user_full_name(client, full_name):\n    user = f.UserFactory.create(full_name=\"test_name\")\n    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n\n    client.login(user)\n    data = {\"full_name\": full_name}\n    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n    assert response.status_code == 200\n\n\n##############################\n## Change email\n##############################\n\ndef test_update_user_with_same_email(client):\n    user = f.UserFactory.create(email=\"same@email.com\")\n    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n    data = {\"email\": \"same@email.com\"}\n\n    client.login(user)\n    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n\n    assert response.status_code == 400\n    assert response.data['_error_message'] == 'Duplicated email'\n\n    user.refresh_from_db()\n    assert user.email == \"same@email.com\"\n\n\ndef test_update_user_with_duplicated_email(client):\n    f.UserFactory.create(email=\"one@email.com\")\n    user = f.UserFactory.create(email=\"two@email.com\")\n    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n    data = {\"email\": \"one@email.com\"}\n\n    client.login(user)\n    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n\n    assert response.status_code == 400\n    assert response.data['_error_message'] == 'Duplicated email'\n\n    user.refresh_from_db()\n    assert user.email == \"two@email.com\"\n\n\ndef test_update_user_with_invalid_email(client):\n    user = f.UserFactory.create(email=\"my@email.com\")\n    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n    data = {\"email\": \"my@email\"}\n\n    client.login(user)\n    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n\n    assert response.status_code == 400\n    assert response.data['_error_message'] == 'Invalid email'\n\n    user.refresh_from_db()\n    assert user.email == \"my@email.com\"\n\n\ndef test_update_user_with_unallowed_domain_email(client, settings):\n    settings.USER_EMAIL_ALLOWED_DOMAINS = ['email.com']\n    user = f.UserFactory.create(email=\"my@email.com\")\n    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n    data = {\"email\": \"my@invalid-email.com\"}\n\n    client.login(user)\n    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n\n    assert response.status_code == 400\n    assert response.data['_error_message'] == 'Invalid email'\n\n    user.refresh_from_db()\n    assert user.email == \"my@email.com\"\n\ndef test_update_user_with_allowed_domain_email(client, settings):\n    settings.USER_EMAIL_ALLOWED_DOMAINS = ['email.com']\n\n    user = f.UserFactory.create(email=\"old@email.com\")\n    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n    data = {\"email\": \"new@email.com\"}\n\n    client.login(user)\n    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n\n    assert response.status_code == 200\n\n    user.refresh_from_db()\n    assert user.email == \"old@email.com\"\n    assert user.email_token is not None\n    assert user.new_email == \"new@email.com\"\n\n\ndef test_update_user_with_valid_email(client):\n    user = f.UserFactory.create(email=\"old@email.com\")\n    url = reverse('users-detail', kwargs={\"pk\": user.pk})\n    data = {\"email\": \"new@email.com\"}\n\n    client.login(user)\n    response = client.patch(url, json.dumps(data), content_type=\"application/json\")\n\n    assert response.status_code == 200\n    user.refresh_from_db()\n    assert user.email == \"old@email.com\"\n    assert user.email_token is not None\n    assert user.new_email == \"new@email.com\"\n\n\ndef test_change_password_invalidates_password_recovery_token(client):\n    user = f.UserFactory.create()\n    user.set_password(\"current-password\")\n    user.token = \"recovery-token\"\n    user.save()\n\n    client.login(user)\n    url = reverse('users-change-password')\n    data = {\n        \"current_password\": \"current-password\",\n        \"password\": \"new-password\",\n    }\n\n    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n\n    assert response.status_code == 204\n    user.refresh_from_db()\n    assert user.check_password(\"new-password\")\n    assert user.token is None\n\n    recovery_url = reverse('users-change-password-from-recovery')\n    recovery_data = {\"token\": \"recovery-token\", \"password\": \"another-password\"}\n    response = client.post(recovery_url, json.dumps(recovery_data), content_type=\"application/json\")\n\n    assert response.status_code == 400\n    user.refresh_from_db()\n    assert user.check_password(\"new-password\")\n\n\n@pytest.mark.parametrize((\"password_length\", \"status_code\"), [(128, 204), (129, 400)])\ndef test_change_password_max_length(client, password_length, status_code):\n    user = f.UserFactory.create()\n    user.set_password(\"current-password\")\n    user.save()\n    client.login(user)\n\n    response = client.post(\n        reverse('users-change-password'),\n        json.dumps({\"current_password\": \"current-password\", \"password\": \"p\" * password_length}),\n        content_type=\"application/json\",\n    )\n\n    assert response.status_code == status_code\n    user.refresh_from_db()\n    assert user.check_password(\"p\" * password_length if status_code == 204 else \"current-password\")\n\n\n@pytest.mark.parametrize((\"password_length\", \"status_code\"), [(128, 204), (129, 400)])\ndef test_recovery_password_max_length(client, password_length, status_code):\n    user = f.UserFactory.create(token=\"recovery-token\")\n    user.set_password(\"current-password\")\n    user.save()\n\n    response = client.post(\n        reverse('users-change-password-from-recovery'),\n        json.dumps({\"token\": \"recovery-token\", \"password\": \"p\" * password_length}),\n        content_type=\"application/json\",\n    )\n\n    assert response.status_code == status_code\n    user.refresh_from_db()\n    assert user.check_password(\"p\" * password_length if status_code == 204 else \"current-password\")\n\n\ndef test_password_recovery_returns_200_for_unknown_username(client):\n    response = client.post(\n        reverse(\"users-password-recovery\"),\n        json.dumps({\"username\": \"unknown-user\"}),\n        content_type=\"application/json\",\n    )\n\n    assert response.status_code == 200\n    assert response.data == {\n        \"detail\": \"If an account exists for the given username or email, \"\n        \"you'll receive an email with a link to set a new password.\"\n    }\n    assert len(mail.outbox) == 0\n\n\ndef test_password_recovery_returns_200_for_unknown_email(client):\n    response = client.post(\n        reverse(\"users-password-recovery\"),\n        json.dumps({\"username\": \"unknown@email.com\"}),\n        content_type=\"application/json\",\n    )\n\n    assert response.status_code == 200\n    assert response.data == {\n        \"detail\": \"If an account exists for the given username or email, \"\n        \"you'll receive an email with a link to set a new password.\"\n    }\n    assert len(mail.outbox) == 0\n\n\ndef test_password_recovery_without_username_returns_400(client):\n    response = client.post(\n        reverse(\"users-password-recovery\"),\n        json.dumps({}),\n        content_type=\"application/json\",\n    )\n\n    assert response.status_code == 400\n\n\ndef test_validate_requested_email_change(client):\n    user = f.UserFactory.create(email=\"old@email.com\", email_token=\"change_email_token\", new_email=\"new@email.com\")\n    url = reverse('users-change-email')\n    data = {\"email_token\": \"change_email_token\"}\n\n    client.login(user)\n    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n\n    assert response.status_code == 204\n    user.refresh_from_db()\n    assert user.email_token is None\n    assert user.new_email is None\n    assert user.email == \"new@email.com\"\n\n\ndef test_validate_requested_email_change_invalidates_password_recovery_token(client):\n    user = f.UserFactory.create(\n        email=\"old@email.com\",\n        email_token=\"change_email_token\",\n        new_email=\"new@email.com\",\n        token=\"recovery-token\",\n    )\n    user.set_password(\"current-password\")\n    user.save()\n\n    client.login(user)\n    url = reverse('users-change-email')\n    data = {\"email_token\": \"change_email_token\"}\n\n    response = client.post(url, json.dumps(data), content_type=\"application/json\")\n\n    assert response.status_code == 204\n    user.refresh_from_db()\n    assert user.email == \"new@email.com\"\n    assert user.email_token is None\n    assert user.token is None\n\n    recovery_url = reverse('users-change-password-from-recovery')\n    recovery_data = {\"token\": \"recovery-token\", \"password\": \"new-password\"}\n    response = client.post(recovery_url, json.dumps(recovery_data), content_type=\"application/json\")\n\n    assert response.status_code == 400","numLines":340,"startLine":1,"totalLines":1301}},"tool_result_meta":[{"id":"toolu_01QzVEzhjeshz6rzyfhkTjei","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
