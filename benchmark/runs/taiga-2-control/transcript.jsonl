{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FoxXugNn9xD2GDsiJzZjES","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t# This Source Code Form is subject to the terms of the Mozilla Public\n3\t# License, v. 2.0. If a copy of the MPL was not distributed with this\n4\t# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n5\t#\n6\t# Copyright (c) 2021-present Kaleidos INC\n7\t\n8\timport uuid\n9\t\n10\tfrom django.apps import apps\n11\tfrom django.utils.translation import gettext as _\n12\tfrom django.core.validators import validate_email\n13\tfrom django.core.exceptions import ValidationError\n14\tfrom django.conf import settings\n15\t\n16\tfrom taiga.auth.exceptions import TokenError\n17\tfrom taiga.auth.tokens import CancelToken\n18\tfrom taiga.auth.settings import PASSWORD_MAX_LENGTH, api_settings as auth_settings\n19\tfrom taiga.base import exceptions as exc\n20\tfrom taiga.base import filters\n21\tfrom taiga.base import response\n22\tfrom taiga.base.utils.dicts import into_namedtuple\n23\tfrom taiga.base.decorators import list_route\n24\tfrom taiga.base.decorators import detail_route\n25\tfrom taiga.base.api.fields import validate_user_email_allowed_domains\n26\tfrom taiga.base.api.mixins import ArchivedByProjectMixin, BlockedByProjectMixin\n27\tfrom taiga.base.api.viewsets import ModelCrudViewSet\n28\tfrom taiga.base.api.utils import get_object_or_404\n29\tfrom taiga.base.filters import MembersFilterBackend\n30\tfrom taiga.base.mails import mail_builder\n31\tfrom taiga.users.services import get_user_by_username_or_email\n32\tfrom easy_thumbnails.source_generators import pil_image\n33\t\n34\tfrom . import models\n35\tfrom . import serializers\n36\tfrom . import validators\n37\tfrom . import permissions\n38\tfrom . import filters as user_filters\n39\tfrom . import services\n40\tfrom . import utils as user_utils\n41\tfrom .signals import user_cancel_account as user_cancel_account_signal\n42\tfrom .signals import user_change_email as user_change_email_signal\n43\tfrom .throttling import UserDetailRateThrottle, UserUpdateRateThrottle\n44\t\n45\tclass UsersViewSet(ModelCrudViewSet):\n46\t    permission_classes = (permissions.UserPermission,)\n47\t    admin_serializer_class = serializers.UserAdminSerializer\n48\t    serializer_class = serializers.UserSerializer\n49\t    admin_validator_class = validators.UserAdminValidator\n50\t    validator_class = validators.UserValidator\n51\t    filter_backends = (MembersFilterBackend,)\n52\t    throttle_classes = (UserDetailRateThrottle, UserUpdateRateThrottle)\n53\t    model = models.User\n54\t\n55\t    def get_serializer_class(self):\n56\t        if self.action in [\"partial_update\", \"update\", \"retrieve\", \"by_username\"]:\n57\t            user = self.object\n58\t            if self.request.user == user or self.request.user.is_superuser:\n59\t                return self.admin_serializer_class\n60\t\n61\t        return self.serializer_class\n62\t\n63\t    def get_validator_class(self):\n64\t        if self.action in [\"partial_update\", \"update\", \"retrieve\", \"by_username\"]:\n65\t            user = self.object\n66\t            if self.request.user == user or self.request.user.is_superuser:\n67\t                return self.admin_validator_class\n68\t\n69\t        return self.validator_class\n70\t\n71\t    def get_queryset(self):\n72\t        qs = super().get_queryset()\n73\t        qs = qs.prefetch_related(\"memberships\")\n74\t        qs = user_utils.attach_extra_info(qs, user=self.request.user)\n75\t        return qs\n76\t\n77\t    def create(self, *args, **kwargs):\n78\t        raise exc.NotSupported()\n79\t\n80\t    def list(self, request, *args, **kwargs):\n81\t        self.object_list = MembersFilterBackend().filter_queryset(request,\n82\t                                                                  self.get_queryset(),\n83\t                                                                  self)\n84\t\n85\t        page = self.paginate_queryset(self.object_list)\n86\t        if page is not None:\n87\t            serializer = self.get_pagination_serializer(page)\n88\t        else:\n89\t            serializer = self.get_serializer(self.object_list, many=True)\n90\t\n91\t        return response.Ok(serializer.data)\n92\t\n93\t    def retrieve(self, request, *args, **kwargs):\n94\t        self.object = get_object_or_404(self.get_queryset(), **kwargs)\n95\t        self.check_permissions(request, 'retrieve', self.object)\n96\t        serializer = self.get_serializer(self.object)\n97\t        return response.Ok(serializer.data)\n98\t\n99\t    # TODO: commit_on_success\n100\t    def partial_update(self, request, *args, **kwargs):\n101\t        \"\"\"\n102\t        We must detect if the user is trying to change his email so we can\n103\t        save that value and generate a token that allows him to validate it in\n104\t        the new email account\n105\t        \"\"\"\n106\t        user = self.get_object()\n107\t        self.check_permissions(request, \"update\", user)\n108\t\n109\t        new_email = request.DATA.pop('email', None)\n110\t        if new_email is not None:\n111\t            valid_new_email = True\n112\t            duplicated_email = models.User.objects.filter(email=new_email).exists()\n113\t\n114\t            try:\n115\t                validate_email(new_email)\n116\t                validate_user_email_allowed_domains(new_email)\n117\t            except ValidationError:\n118\t                valid_new_email = False\n119\t\n120\t            valid_new_email = valid_new_email and new_email != request.user.email\n121\t\n122\t            if duplicated_email:\n123\t                raise exc.WrongArguments(_(\"Duplicated email\"))\n124\t            elif not valid_new_email:\n125\t                raise exc.WrongArguments(_(\"Invalid email\"))\n126\t\n127\t            # We need to generate a token for the email\n128\t            request.user.email_token = str(uuid.uuid4())\n129\t            request.user.new_email = new_email\n130\t            request.user.save(update_fields=[\"email_token\", \"new_email\"])\n131\t            email = mail_builder.change_email(\n132\t                request.user.new_email,\n133\t                {\n134\t                    \"user\": request.user,\n135\t                    \"lang\": request.user.lang\n136\t                }\n137\t            )\n138\t            email.send()\n139\t\n140\t        return super().partial_update(request, *args, **kwargs)\n141\t\n142\t    def destroy(self, request, pk=None):\n143\t        user = self.get_object()\n144\t        self.check_permissions(request, \"destroy\", user)\n145\t        stream = request.stream\n146\t        request_data = stream is not None and stream.GET or None\n147\t        user_cancel_account_signal.send(sender=user.__class__, user=user, request_data=request_data)\n148\t        user.cancel()\n149\t        return response.NoContent()\n150\t\n151\t    @list_route(methods=[\"GET\"])\n152\t    def by_username(self, request, *args, **kwargs):\n153\t        username = request.QUERY_PARAMS.get(\"username\", None)\n154\t        return self.retrieve(request, username=username)\n155\t\n156\t    @list_route(methods=[\"POST\"])\n157\t    def password_recovery(self, request, pk=None):\n158\t        username_or_email = request.DATA.get('username', None)\n159\t\n160\t        self.check_permissions(request, \"password_recovery\", None)\n161\t\n162\t        if not username_or_email:\n163\t            raise exc.WrongArguments(_(\"Invalid username or email\"))\n164\t\n165\t        success_message = _(\n166\t            \"If an account exists for the given username or email, \"\n167\t            \"you'll receive an email with a link to set a new password.\"\n168\t        )\n169\t\n170\t        try:\n171\t            user = get_user_by_username_or_email(username_or_email)\n172\t        except exc.WrongArguments:\n173\t            # Do not reveal whether the account exists\n174\t            return response.Ok({\"detail\": success_message})\n175\t\n176\t        user.token = str(uuid.uuid4())\n177\t        user.save(update_fields=[\"token\"])\n178\t\n179\t        email = mail_builder.password_recovery(user, {\"user\": user})\n180\t        email.send()\n181\t\n182\t        return response.Ok({\"detail\": success_message})\n183\t\n184\t    @list_route(methods=[\"POST\"])\n185\t    def change_password_from_recovery(self, request, pk=None):\n186\t        \"\"\"\n187\t        Change password with token (from password recovery step).\n188\t        \"\"\"\n189\t\n190\t        self.check_permissions(request, \"change_password_from_recovery\", None)\n191\t\n192\t        validator = validators.RecoveryValidator(data=request.DATA, many=False)\n193\t        if not validator.is_valid():\n194\t            return response.BadRequest(validator.errors)\n195\t\n196\t        try:\n197\t            user = models.User.objects.get(token=validator.data[\"token\"])\n198\t        except models.User.DoesNotExist:\n199\t            raise exc.WrongArguments(_(\"Token is invalid\"))\n200\t\n201\t        user.set_password(validator.data[\"password\"])\n202\t        user.token = None\n203\t        user.save(update_fields=[\"password\", \"token\"])\n204\t\n205\t        return response.NoContent()\n206\t\n207\t    @list_route(methods=[\"POST\"])\n208\t    def change_password(self, request, pk=None):\n209\t        \"\"\"\n210\t        Change password to current logged user.\n211\t        \"\"\"\n212\t        self.check_permissions(request, \"change_password\", None)\n213\t\n214\t        current_password = request.DATA.get(\"current_password\")\n215\t        password = request.DATA.get(\"password\")\n216\t\n217\t        # NOTE: GitHub users have no password yet (request.user.password == '') so\n218\t        #       current_password can be None\n219\t        if not current_password and request.user.password:\n220\t            raise exc.WrongArguments(_(\"Current password parameter needed\"))\n221\t\n222\t        if not password:\n223\t            raise exc.WrongArguments(_(\"New password parameter needed\"))\n224\t\n225\t        if len(password) < 6:\n226\t            raise exc.WrongArguments(_(\"Invalid password length at least 6 characters needed\"))\n227\t\n228\t        if len(password) > PASSWORD_MAX_LENGTH:\n229\t            raise exc.WrongArguments(_(\"Invalid password length at most 128 characters allowed\"))\n230\t"}]},"parent_tool_use_id":null,"session_id":"4dbed559-4109-490c-a8e2-32272a58235f","uuid":"e1c153bc-e861-4324-bbc8-eca8f74b347f","timestamp":"2026-11-02T05:23:35.946Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-2-control/taiga/users/api.py","content":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nimport uuid\n\nfrom django.apps import apps\nfrom django.utils.translation import gettext as _\nfrom django.core.validators import validate_email\nfrom django.core.exceptions import ValidationError\nfrom django.conf import settings\n\nfrom taiga.auth.exceptions import TokenError\nfrom taiga.auth.tokens import CancelToken\nfrom taiga.auth.settings import PASSWORD_MAX_LENGTH, api_settings as auth_settings\nfrom taiga.base import exceptions as exc\nfrom taiga.base import filters\nfrom taiga.base import response\nfrom taiga.base.utils.dicts import into_namedtuple\nfrom taiga.base.decorators import list_route\nfrom taiga.base.decorators import detail_route\nfrom taiga.base.api.fields import validate_user_email_allowed_domains\nfrom taiga.base.api.mixins import ArchivedByProjectMixin, BlockedByProjectMixin\nfrom taiga.base.api.viewsets import ModelCrudViewSet\nfrom taiga.base.api.utils import get_object_or_404\nfrom taiga.base.filters import MembersFilterBackend\nfrom taiga.base.mails import mail_builder\nfrom taiga.users.services import get_user_by_username_or_email\nfrom easy_thumbnails.source_generators import pil_image\n\nfrom . import models\nfrom . import serializers\nfrom . import validators\nfrom . import permissions\nfrom . import filters as user_filters\nfrom . import services\nfrom . import utils as user_utils\nfrom .signals import user_cancel_account as user_cancel_account_signal\nfrom .signals import user_change_email as user_change_email_signal\nfrom .throttling import UserDetailRateThrottle, UserUpdateRateThrottle\n\nclass UsersViewSet(ModelCrudViewSet):\n    permission_classes = (permissions.UserPermission,)\n    admin_serializer_class = serializers.UserAdminSerializer\n    serializer_class = serializers.UserSerializer\n    admin_validator_class = validators.UserAdminValidator\n    validator_class = validators.UserValidator\n    filter_backends = (MembersFilterBackend,)\n    throttle_classes = (UserDetailRateThrottle, UserUpdateRateThrottle)\n    model = models.User\n\n    def get_serializer_class(self):\n        if self.action in [\"partial_update\", \"update\", \"retrieve\", \"by_username\"]:\n            user = self.object\n            if self.request.user == user or self.request.user.is_superuser:\n                return self.admin_serializer_class\n\n        return self.serializer_class\n\n    def get_validator_class(self):\n        if self.action in [\"partial_update\", \"update\", \"retrieve\", \"by_username\"]:\n            user = self.object\n            if self.request.user == user or self.request.user.is_superuser:\n                return self.admin_validator_class\n\n        return self.validator_class\n\n    def get_queryset(self):\n        qs = super().get_queryset()\n        qs = qs.prefetch_related(\"memberships\")\n        qs = user_utils.attach_extra_info(qs, user=self.request.user)\n        return qs\n\n    def create(self, *args, **kwargs):\n        raise exc.NotSupported()\n\n    def list(self, request, *args, **kwargs):\n        self.object_list = MembersFilterBackend().filter_queryset(request,\n                                                                  self.get_queryset(),\n                                                                  self)\n\n        page = self.paginate_queryset(self.object_list)\n        if page is not None:\n            serializer = self.get_pagination_serializer(page)\n        else:\n            serializer = self.get_serializer(self.object_list, many=True)\n\n        return response.Ok(serializer.data)\n\n    def retrieve(self, request, *args, **kwargs):\n        self.object = get_object_or_404(self.get_queryset(), **kwargs)\n        self.check_permissions(request, 'retrieve', self.object)\n        serializer = self.get_serializer(self.object)\n        return response.Ok(serializer.data)\n\n    # TODO: commit_on_success\n    def partial_update(self, request, *args, **kwargs):\n        \"\"\"\n        We must detect if the user is trying to change his email so we can\n        save that value and generate a token that allows him to validate it in\n        the new email account\n        \"\"\"\n        user = self.get_object()\n        self.check_permissions(request, \"update\", user)\n\n        new_email = request.DATA.pop('email', None)\n        if new_email is not None:\n            valid_new_email = True\n            duplicated_email = models.User.objects.filter(email=new_email).exists()\n\n            try:\n                validate_email(new_email)\n                validate_user_email_allowed_domains(new_email)\n            except ValidationError:\n                valid_new_email = False\n\n            valid_new_email = valid_new_email and new_email != request.user.email\n\n            if duplicated_email:\n                raise exc.WrongArguments(_(\"Duplicated email\"))\n            elif not valid_new_email:\n                raise exc.WrongArguments(_(\"Invalid email\"))\n\n            # We need to generate a token for the email\n            request.user.email_token = str(uuid.uuid4())\n            request.user.new_email = new_email\n            request.user.save(update_fields=[\"email_token\", \"new_email\"])\n            email = mail_builder.change_email(\n                request.user.new_email,\n                {\n                    \"user\": request.user,\n                    \"lang\": request.user.lang\n                }\n            )\n            email.send()\n\n        return super().partial_update(request, *args, **kwargs)\n\n    def destroy(self, request, pk=None):\n        user = self.get_object()\n        self.check_permissions(request, \"destroy\", user)\n        stream = request.stream\n        request_data = stream is not None and stream.GET or None\n        user_cancel_account_signal.send(sender=user.__class__, user=user, request_data=request_data)\n        user.cancel()\n        return response.NoContent()\n\n    @list_route(methods=[\"GET\"])\n    def by_username(self, request, *args, **kwargs):\n        username = request.QUERY_PARAMS.get(\"username\", None)\n        return self.retrieve(request, username=username)\n\n    @list_route(methods=[\"POST\"])\n    def password_recovery(self, request, pk=None):\n        username_or_email = request.DATA.get('username', None)\n\n        self.check_permissions(request, \"password_recovery\", None)\n\n        if not username_or_email:\n            raise exc.WrongArguments(_(\"Invalid username or email\"))\n\n        success_message = _(\n            \"If an account exists for the given username or email, \"\n            \"you'll receive an email with a link to set a new password.\"\n        )\n\n        try:\n            user = get_user_by_username_or_email(username_or_email)\n        except exc.WrongArguments:\n            # Do not reveal whether the account exists\n            return response.Ok({\"detail\": success_message})\n\n        user.token = str(uuid.uuid4())\n        user.save(update_fields=[\"token\"])\n\n        email = mail_builder.password_recovery(user, {\"user\": user})\n        email.send()\n\n        return response.Ok({\"detail\": success_message})\n\n    @list_route(methods=[\"POST\"])\n    def change_password_from_recovery(self, request, pk=None):\n        \"\"\"\n        Change password with token (from password recovery step).\n        \"\"\"\n\n        self.check_permissions(request, \"change_password_from_recovery\", None)\n\n        validator = validators.RecoveryValidator(data=request.DATA, many=False)\n        if not validator.is_valid():\n            return response.BadRequest(validator.errors)\n\n        try:\n            user = models.User.objects.get(token=validator.data[\"token\"])\n        except models.User.DoesNotExist:\n            raise exc.WrongArguments(_(\"Token is invalid\"))\n\n        user.set_password(validator.data[\"password\"])\n        user.token = None\n        user.save(update_fields=[\"password\", \"token\"])\n\n        return response.NoContent()\n\n    @list_route(methods=[\"POST\"])\n    def change_password(self, request, pk=None):\n        \"\"\"\n        Change password to current logged user.\n        \"\"\"\n        self.check_permissions(request, \"change_password\", None)\n\n        current_password = request.DATA.get(\"current_password\")\n        password = request.DATA.get(\"password\")\n\n        # NOTE: GitHub users have no password yet (request.user.password == '') so\n        #       current_password can be None\n        if not current_password and request.user.password:\n            raise exc.WrongArguments(_(\"Current password parameter needed\"))\n\n        if not password:\n            raise exc.WrongArguments(_(\"New password parameter needed\"))\n\n        if len(password) < 6:\n            raise exc.WrongArguments(_(\"Invalid password length at least 6 characters needed\"))\n\n        if len(password) > PASSWORD_MAX_LENGTH:\n            raise exc.WrongArguments(_(\"Invalid password length at most 128 characters allowed\"))\n","numLines":230,"startLine":1,"totalLines":490}},"tool_result_meta":[{"id":"toolu_01FoxXugNn9xD2GDsiJzZjES","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
