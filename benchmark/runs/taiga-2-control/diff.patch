+def _assert_recovery_token_rejected(client, token, token_expires_at):
+    user = f.UserFactory.create(token=token, token_expires_at=token_expires_at)
+    user.set_password("current-password")
+    user.save()
+
+    unknown_response = client.post(
+        reverse("users-change-password-from-recovery"),
+        json.dumps({"token": "unknown-token", "password": "new-password"}),
+        content_type="application/json",
+    )
+    response = client.post(
+        reverse("users-change-password-from-recovery"),
+        json.dumps({"token": token, "password": "new-password"}),
+        content_type="application/json",
+    )
+
+    assert response.status_code == 400
+    assert response.data == unknown_response.data
+    user.refresh_from_db()
+    assert user.check_password("current-password")
+    assert user.token == token
+    assert user.token_expires_at == token_expires_at
+
+
+def test_change_password_from_recovery_with_expired_token(client):
+    _assert_recovery_token_rejected(client, "recovery-token",
+                                    timezone.now() - datetime.timedelta(seconds=1))
+
+
+def test_change_password_from_recovery_with_legacy_token_without_expiration_date(client):
+    _assert_recovery_token_rejected(client, "recovery-token", None)
+
+
+def test_password_recovery_token_expires_after_configured_lifetime(client, settings):
