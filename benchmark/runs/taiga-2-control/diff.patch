+def test_password_recovery_sets_token_with_expiration_date(client, settings):
+    settings.PASSWORD_RECOVERY_TOKEN_LIFETIME = datetime.timedelta(minutes=30)
+    user = f.UserFactory.create(username="recovery-user")
+
+    before = timezone.now()
+    response = client.post(
+        reverse("users-password-recovery"),
+        json.dumps({"username": "recovery-user"}),
+        content_type="application/json",
+    )
+    after = timezone.now()
+
+    assert response.status_code == 200
+    assert len(mail.outbox) == 1
+    user.refresh_from_db()
+    assert user.token is not None
+    assert user.token in mail.outbox[0].body
+    assert before + datetime.timedelta(minutes=30) <= user.token_expires_at
+    assert user.token_expires_at <= after + datetime.timedelta(minutes=30)
+
+
+def test_password_recovery_default_token_lifetime_is_one_hour():
+    assert settings.PASSWORD_RECOVERY_TOKEN_LIFETIME == datetime.timedelta(hours=1)
+
+
+def test_password_recovery_requested_again_replaces_token_and_expiration_date(client):
+    old_expires_at = timezone.now() + datetime.timedelta(minutes=5)
+    user = f.UserFactory.create(username="recovery-user", token="old-recovery-token",
+                                token_expires_at=old_expires_at)
+
+    response = client.post(
+        reverse("users-password-recovery"),
+        json.dumps({"username": "recovery-user"}),
+        content_type="application/json",
+    )
+
+    assert response.status_code == 200
+    user.refresh_from_db()
+    assert user.token not in (None, "old-recovery-token")
+    assert user.token_expires_at > old_expires_at
+
+    response = client.post(
+        reverse("users-change-password-from-recovery"),
+        json.dumps({"token": "old-recovery-token", "password": "new-password"}),
+        content_type="application/json",
+    )
+    assert response.status_code == 400
+
+
