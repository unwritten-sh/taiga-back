{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RaW6KW3aeFe6YZnyL63T6E","type":"tool_result","content":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nfrom unittest import mock\nfrom django.urls import reverse\n\nfrom taiga.projects import services\nfrom taiga.base.utils import json\n\nfrom .. import factories as f\n\nimport pytest\npytestmark = pytest.mark.django_db\n\n\ndef test_get_members_from_bulk():\n    data = [{\"role_id\": \"1\", \"username\": \"member1@email.com\"},\n            {\"role_id\": \"1\", \"username\": \"member2@email.com\"}]\n    members = services.get_members_from_bulk(data, project_id=1)\n\n    assert len(members) == 2\n    assert members[0].email == \"member1@email.com\"\n    assert members[1].email == \"member2@email.com\"\n\n\ndef test_create_member_forbidden_for_unverified_user(client):\ndef test_api_create_bulk_members(client):\n    project = f.ProjectFactory()\n    john = f.UserFactory.create()\n    joseph = f.UserFactory.create()\n    other = f.UserFactory.create()\n    tester = f.RoleFactory(project=project, name=\"Tester\", permissions=[\"view_project\"])\n    gamer = f.RoleFactory(project=project, name=\"Gamer\", permissions=[\"view_project\"])\n    f.MembershipFactory(project=project, user=john, role=tester, is_admin=True)\n\n    # John and Other are members from another project\n    project2 = f.ProjectFactory()\n    f.MembershipFactory(project=project2, user=john, role=gamer, is_admin=True)\n    f.MembershipFactory(project=project2, user=other, role=gamer)\n\n    url = reverse(\"memberships-bulk-create\")\n\n    data = {\n        \"project_id\": project.id,\n        \"bulk_memberships\": [\n            {\"role_id\": gamer.pk, \"username\": joseph.email},\n            {\"role_id\": gamer.pk, \"username\": other.username},\n        ]\n    }\n    client.login(john)\n    response = client.json.post(url, json.dumps(data))\n\n    assert response.status_code == 200\n    response_user_ids = set([u[\"user\"] for u in response.data])\n    user_ids = {other.id, joseph.id}\n    assert(user_ids.issubset(response_user_ids))\n\n\n616:def test_api_create_membership(client):\n617-    membership = f.MembershipFactory(is_admin=True)\n618-    role = f.RoleFactory.create(project=membership.project)\n619-    user = f.UserFactory.create()\n620-\n621-    client.login(membership.user)\n622-    url = reverse(\"memberships-list\")\n623-    data = {\"role\": role.pk, \"project\": role.project.pk, \"username\": user.email}\n624-    response = client.json.post(url, json.dumps(data))\n625-\n626-    assert response.status_code == 201\n627-    assert response.data[\"user_email\"] == user.email\n628-\n629-\n630-def test_api_create_membership_with_unallowed_domain(client, settings):\n631-    settings.USER_EMAIL_ALLOWED_DOMAINS = ['email.com']\n632-\n633-    membership = f.MembershipFactory(is_admin=True)\n634-    role = f.RoleFactory.create(project=membership.project)\n635-\n636-    client.login(membership.user)\n637-    url = reverse(\"memberships-list\")\n638-    data = {\"role\": role.pk, \"project\": role.project.pk, \"username\": \"test@invalid-email.com\"}\n639-    response = client.json.post(url, json.dumps(data))\n640-\n641-    assert response.status_code == 400\ntaiga/routers.py:16:router.register(r\"locales\", LocalesViewSet, base_name=\"locales\")\ntaiga/routers.py:24:router.register(r\"auth\", AuthViewSet, base_name=\"auth\")\ntaiga/routers.py:25:router.register(r\"users\", UsersViewSet, base_name=\"users\")\ntaiga/routers.py:26:router.register(r\"roles\", RolesViewSet, base_name=\"roles\")\ntaiga/routers.py:32:router.register(r\"user-storage\", StorageEntriesViewSet, base_name=\"user-storage\")\ntaiga/routers.py:39:router.register(r\"notify-policies\", NotifyPolicyViewSet, base_name=\"notifications\")\ntaiga/routers.py:40:router.register(r\"web-notifications\", WebNotificationsViewSet, base_name=\"web-notifications\")\ntaiga/routers.py:41:router.register(r\"web-notifications/set-as-read\", WebNotificationsViewSet, base_name=\"web-notifications\")\ntaiga/routers.py:42:router.register(r\"web-notifications/(?P<resource_id>\\d+)/set-as-read\", WebNotificationsViewSet, base_name=\"web-notifications\")\ntaiga/routers.py:47:router.register(r\"user-project-settings\", UserProjectSettingsViewSet, base_name=\"user-project-settings\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"b2ff26cf-b232-4e69-ba05-b307a7ca6ab9","uuid":"9f7c0bbc-dfc5-4cc0-83a2-57be8f2ade6f","timestamp":"2026-11-01T23:52:49.396Z","tool_use_result":{"stdout":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nfrom unittest import mock\nfrom django.urls import reverse\n\nfrom taiga.projects import services\nfrom taiga.base.utils import json\n\nfrom .. import factories as f\n\nimport pytest\npytestmark = pytest.mark.django_db\n\n\ndef test_get_members_from_bulk():\n    data = [{\"role_id\": \"1\", \"username\": \"member1@email.com\"},\n            {\"role_id\": \"1\", \"username\": \"member2@email.com\"}]\n    members = services.get_members_from_bulk(data, project_id=1)\n\n    assert len(members) == 2\n    assert members[0].email == \"member1@email.com\"\n    assert members[1].email == \"member2@email.com\"\n\n\ndef test_create_member_forbidden_for_unverified_user(client):\ndef test_api_create_bulk_members(client):\n    project = f.ProjectFactory()\n    john = f.UserFactory.create()\n    joseph = f.UserFactory.create()\n    other = f.UserFactory.create()\n    tester = f.RoleFactory(project=project, name=\"Tester\", permissions=[\"v