+# Same validity period as project transfer tokens
+INVITATION_TOKEN_LIFETIME = datetime.timedelta(days=7)
+
+
+def generate_invitation_token():
+    """
+    Return a new invitation token and its expiration date, as a tuple
+    `(token, token_expires_at)`.
+
+    Every place that issues an invitation token must use this function,
+    so the token and its expiration date are always set together.
+    """
+    return str(uuid.uuid4()), timezone.now() + INVITATION_TOKEN_LIFETIME
+
+
+def set_invitation_token(membership):
+    """Issue a new invitation token (and expiration date) on a membership. Does not save it."""
+    membership.token, membership.token_expires_at = generate_invitation_token()
+    return membership
+
+
+@tx.atomic
+def resend_invitation(invitation):
+    """Rotate the invitation token, so older links stop working, and send the email again."""
+    if not invitation.user:
+        set_invitation_token(invitation)
+        invitation.save(update_fields=["token", "token_expires_at"])
+    send_invitation(invitation)
+
+
