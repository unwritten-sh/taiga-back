{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgdbyPjjaJxQY6R5TkTJh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RVhKzrf3bPH6fvqM5u3G3y","name":"Write","input":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-3-control/tests/integration/test_importers_github_inline_images.py","content":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nfrom unittest import mock\n\nimport pytest\n\nfrom django.contrib.contenttypes.models import ContentType\n\nfrom taiga.importers.github.importer import GithubImporter\nfrom taiga.projects.attachments.models import Attachment\nfrom taiga.projects.attachments.services import generate_refresh_fragment\nfrom taiga.projects.issues.models import Issue\nfrom taiga.projects.userstories.models import UserStory\n\nfrom .. import factories as f\n\n\npytestmark = pytest.mark.django_db\n\nURL_1 = \"https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111\"\nURL_2 = \"https://github.com/user-attachments/assets/22222222-2222-2222-2222-222222222222\"\nURL_3 = \"https://github.com/user-attachments/assets/33333333-3333-3333-3333-333333333333\"\nPNG = b\"\\x89PNG\\r\\n\\x1a\\nfake-image\"\n\n\ndef _signed(github_url):\n    return \"https://signed.invalid/{}.png?jwt=a&amp;x=1\".format(github_url.rsplit(\"/\", 1)[-1])\n\n\ndef _make_importer(downloads):\n    \"\"\"\n    `downloads` maps a GitHub URL to the (content, headers) the signed URL\n    returns, or to an exception to raise.\n    \"\"\"\n    importer = GithubImporter.__new__(GithubImporter)\n    importer._user = None\n    importer._import_closed_data = False\n    importer._client = mock.Mock()\n\n    def render_markdown(markdown, repository_full_name):\n        github_url = markdown[len(\"![image](\"):-1]\n        return '<p><a href=\"x\"><img src=\"{}\" alt=\"image\" style=\"max-width: 100%;\"></a></p>'.format(\n            _signed(github_url))\n\n    def download(url):\n        for github_url, result in downloads.items():\n            if _signed(github_url).replace(\"&amp;\", \"&\") == url:\n                if isinstance(result, Exception):\n                    raise result\n                return result\n        raise AssertionError(\"Unexpected download of {}\".format(url))\n\n    importer._client.render_markdown.side_effect = render_markdown\n    importer._client.download.side_effect = download\n    return importer\n\n\ndef _local_url(attachment):\n    return \"{}#{}\".format(attachment.attached_file.url, generate_refresh_fragment(attachment))\n\n\ndef test_import_inline_images_creates_attachments_and_rewrites_markdown():\n    us = f.UserStoryFactory.create()\n    importer = _make_importer({\n        URL_1: (PNG, {\"Content-Type\": \"image/png\",\n                      \"Content-Disposition\": 'attachment; filename=\"../dir/screenshot.png\"'}),\n        URL_2: (b\"jpeg-bytes\", {\"content-type\": \"image/jpeg; charset=binary\"}),\n    })\n    markdown = \"First ![a]({0})\\nAgain ![b]({0})\\n<img alt=\\\"x\\\" src=\\\"{1}\\\" />\".format(URL_1, URL_2)\n\n    result = importer._import_inline_images(markdown, us, \"owner/repo\", \"2020-01-02T03:04:05Z\")\n\n    # Each distinct URL is rendered and downloaded once.\n    assert importer._client.render_markdown.call_args_list == [\n        mock.call(\"![image]({})\".format(URL_1), \"owner/repo\"),\n        mock.call(\"![image]({})\".format(URL_2), \"owner/repo\"),\n    ]\n    assert importer._client.download.call_count == 2\n\n    attachments = list(Attachment.objects.order_by(\"id\"))\n    assert len(attachments) == 2\n    screenshot, jpeg = attachments\n\n    assert screenshot.name == \"screenshot.png\"\n    assert screenshot.size == len(PNG)\n    assert screenshot.owner == us.owner\n    assert screenshot.project == us.project\n    assert screenshot.content_type == ContentType.objects.get_for_model(UserStory)\n    assert screenshot.object_id == us.id\n    assert screenshot.is_deprecated is False\n    assert screenshot.created_date.year == 2020\n    assert screenshot.attached_file.read() == PNG\n\n    assert jpeg.name == \"github-attachment-22222222-2222-2222-2222-222222222222.jpg\"\n    assert jpeg.size == len(b\"jpeg-bytes\")\n\n    assert \"_taiga-refresh=userstory:{}\".format(screenshot.id) in _local_url(screenshot)\n    assert result == \"First ![a]({0})\\nAgain ![b]({0})\\n<img alt=\\\"x\\\" src=\\\"{1}\\\" />\".format(\n        _local_url(screenshot), _local_url(jpeg))\n    assert \"github.com\" not in result\n\n\ndef test_import_inline_images_keeps_link_of_failed_images():\n    us = f.UserStoryFactory.create()\n    importer = _make_importer({\n        URL_1: Exception(\"boom\"),\n        URL_2: (b\"<html>login</html>\", {\"Content-Type\": \"text/html\"}),\n        URL_3: (PNG, {\"Content-Type\": \"image/png\"}),\n    })\n    markdown = \"![a]({}) ![b]({}) ![c]({})\".format(URL_1, URL_2, URL_3)\n\n    with mock.patch(\"taiga.importers.github.importer.logger\") as logger:\n        result = importer._import_inline_images(markdown, us, \"owner/repo\", \"2020-01-02T03:04:05Z\")\n\n    assert logger.warning.call_count == 2\n    attachment = Attachment.objects.get()\n    assert attachment.name == \"github-attachment-33333333-3333-3333-3333-333333333333.png\"\n    assert result == \"![a]({}) ![b]({}) ![c]({})\".format(URL_1, URL_2, _local_url(attachment))\n\n\ndef test_import_inline_images_keeps_link_when_render_has_no_image():\n    us = f.UserStoryFactory.create()\n    importer = _make_importer({})\n    importer._client.render_markdown.side_effect = None\n    importer._client.render_markdown.return_value = \"<p>nothing</p>\"\n    markdown = \"![a]({})\".format(URL_1)\n\n    with mock.patch(\"taiga.importers.github.importer.logger\") as logger:\n        assert importer._import_inline_images(markdown, us, \"owner/repo\", \"2020-01-02T03:04:05Z\") == markdown\n\n    logger.warning.assert_called_once()\n    importer._client.download.assert_not_called()\n    assert not Attachment.objects.exists()\n\n\ndef test_import_inline_images_without_images_does_nothing():\n    us = f.UserStoryFactory.create()\n    importer = _make_importer({})\n\n    assert importer._import_inline_images(\"no images\", us, \"owner/repo\", \"2020-01-02T03:04:05Z\") == \"no images\"\n    assert importer._import_inline_images(\"\", us, \"owner/repo\", \"2020-01-02T03:04:05Z\") == \"\"\n    importer._client.render_markdown.assert_not_called()\n\n\ndef _github_issue(number, body):\n    return {\n        \"number\": number,\n        \"title\": \"Issue {}\".format(number),\n        \"body\": body,\n        \"state\": \"open\",\n        \"labels\": [],\n        \"assignee\": None,\n        \"assignees\": [],\n        \"milestone\": None,\n        \"user\": {\"id\": 1},\n        \"html_url\": \"https://github.invalid/owner/repo/issues/{}\".format(number),\n        \"created_at\": \"2020-01-02T03:04:05Z\",\n        \"updated_at\": \"2020-01-03T03:04:05Z\",\n    }\n\n\ndef _setup_import(project):\n    importer = _make_importer({\n        URL_1: (PNG, {\"Content-Type\": \"image/png\", \"Content-Disposition\": \"attachment; filename=shot.png\"}),\n        URL_2: Exception(\"expired\"),\n    })\n    issues = [\n        _github_issue(1, \"Image ![a]({}) and broken ![b]({})\".format(URL_1, URL_2)),\n        _github_issue(2, \"No images\"),\n    ]\n    importer._client.get.side_effect = lambda path, params=None: issues\n    return importer\n\n\ndef test_import_user_stories_rewrites_inline_images():\n    project = f.ProjectFactory.create()\n    f.UserStoryStatusFactory.create(project=project, slug=\"open\")\n    importer = _setup_import(project)\n\n    importer._import_user_stories_data(project, {\"full_name\": \"owner/repo\"}, {})\n\n    us = UserStory.objects.get(project=project, ref=1)\n    attachment = Attachment.objects.get()\n    assert attachment.object_id == us.id\n    assert attachment.content_type == ContentType.objects.get_for_model(UserStory)\n    assert us.description == \"Image ![a]({}) and broken ![b]({})\".format(_local_url(attachment), URL_2)\n    assert UserStory.objects.get(project=project, ref=2).description == \"No images\"\n    assert importer._client.render_markdown.call_args_list[0] == mock.call(\n        \"![image]({})\".format(URL_1), \"owner/repo\")\n\n\ndef test_import_issues_rewrites_inline_images():\n    project = f.ProjectFactory.create()\n    f.IssueStatusFactory.create(project=project, slug=\"open\")\n    project.default_severity = f.SeverityFactory.create(project=project)\n    project.default_priority = f.PriorityFactory.create(project=project)\n    project.default_issue_type = f.IssueTypeFactory.create(project=project)\n    project.save()\n    importer = _setup_import(project)\n\n    importer._import_issues_data(project, {\"full_name\": \"owner/repo\"}, {})\n\n    issue = Issue.objects.get(project=project, ref=1)\n    attachment = Attachment.objects.get()\n    assert attachment.object_id == issue.id\n    assert attachment.content_type == ContentType.objects.get_for_model(Issue)\n    assert \"_taiga-refresh=issue:{}\".format(attachment.id) in issue.description\n    assert issue.description == \"Image ![a]({}) and broken ![b]({})\".format(_local_url(attachment), URL_2)\n    assert Issue.objects.get(project=project, ref=2).description == \"No images\"\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1670,"cache_read_input_tokens":50309,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1670},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_