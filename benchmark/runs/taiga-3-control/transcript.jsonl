ders = CaseInsensitiveDict(headers or {})\n        content_type = (headers.get(\"Content-Type\") or \"\").split(\";\")[0].strip().lower()\n        if not content_type.startswith(\"image/\"):\n            raise ValueError(\"Unexpected content type: {!r}\".format(content_type))\n\n        asset_id = github_url.rstrip(\"/\").rsplit(\"/\", 1)[-1]\n        file_name = _get_attachment_file_name(headers, asset_id, content_type)\n\n        with transaction.atomic():\n            attachment = Attachment(\n                owner=obj.owner,\n                project=obj.project,\n                content_type=ContentType.objects.get_for_model(obj),\n                object_id=obj.id,\n                name=file_name,\n                size=len(content),\n                created_date=created_date,\n                is_deprecated=False,\n            )\n            attachment.attached_file.save(file_name, ContentFile(content), save=True)\n\n        return \"{}#{}\".format(attachment.attached_file.url, generate_refresh_fragment(attachment))\n\n    def import_project("},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1458,"cache_read_input_tokens":45173,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1458},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c1751cbe-4841-43ac-a3f5-f4881d3ba1cc","uuid":"2dedff4f-5e57-4f1c-bcb0-ea5285ba1827","timestamp":"2026-11-02T06:09:30.683Z","request_id":"req_011Cgdbw83MffsZRuZDyykk5","wire_tool_inputs":{"toolu_01FjNUcq9ZP4t5iCSd5Ndv3j":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-3-control/taiga/importers/github/importer.py","old_string":"        return default\n\n    def import_project(","new_string":"        return default\n\n    def _import_inline_images(self, markdown, obj, repository_full_name, created_date):\n        \"\"\"\n        Copy the GitHub inline images of `markdown` as attachments of `obj` and\n        return the markdown with the GitHub URLs replaced by the local ones.\n        An image that can't be imported keeps its original URL.\n        \"\"\"\n        for github_url in extract_github_inline_image_urls(markdown):\n            try:\n                local_url = self._import_inline_image(github_url, obj, repository_full_name, created_date)\n            except Exception:\n                logger.warning(\n                    \"Unable to import GitHub inline image %s for %s %s\",\n                    github_url, obj.__class__.__name__, obj.id, exc_info=True,\n                )\n                continue\n\n            # The lookahead avoids touching a longer URL that starts with this one.\n            markdown = re.sub(\n                re.escape(github_url) + r\"(?![0-9A-Za-z-])\",\n                lambda match: local_url,\n                markdown,\n            )\n        return markdown\n\n    def _import_inline_image(self, github_url, obj, repository_full_name, created_date):\n        html = self._client.render_markdown(\"![image]({})\".format(github_url), repository_full_name)\n        signed_url = extract_first_image_src(html)\n        if not signed_url:\n            raise ValueError(\"No image found in the rendered markdown\")\n\n        content, headers = self._client.download(signed_url)\n        headers = CaseInsensitiveDict(headers or {})\n        content_type = (headers.get(\"Content-Type\") or \"\").split(\";\")[0].strip().lower()\n        if not content_type.startswith(\"image/\"):\n            raise ValueError(\"Unexpected content type: {!r}\".format(content_type))\n\n        asset_id = github_url.rstrip(\"/\").rsplit(\"/\", 1)[-1]\n        file_name = _get_attachment_file_name(headers, asset_id, content_type)\n\n        with transaction.atomic():\n            attachment = Attachment(\n                owner=obj.owner,\n                project=obj.project,\n                content_type=ContentType.objects.get_for_model(obj),\n                object_id=obj.id,\n                name=file_name,\n                size=len(content),\n                created_date=created_date,\n                is_deprecated=False,\n            )\n            attachment.attached_file.save(file_name, ContentFile(content), save=True)\n\n        return \"{}#{}\".format(attachment.attached_file.url, generate_refresh_fragment(attachment))\n\n    def import_project("}}}
