{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U8nNPQ5pQnBTBqzUygg83p","type":"tool_result","content":"diff --git a/taiga/importers/github/importer.py b/taiga/importers/github/importer.py\nindex b8f92996..ea7cd52f 100644\n--- a/taiga/importers/github/importer.py\n+++ b/taiga/importers/github/importer.py\n@@ -6,11 +6,19 @@\n # Copyright (c) 2021-present Kaleidos INC\n \n import datetime\n+import logging\n+import mimetypes\n import re\n import requests\n+from email.message import Message\n+from html.parser import HTMLParser\n from urllib.parse import parse_qsl\n+from django.contrib.contenttypes.models import ContentType\n from django.core.files.base import ContentFile\n+from requests.structures import CaseInsensitiveDict\n \n+from taiga.projects.attachments.models import Attachment\n+from taiga.projects.attachments.services import generate_refresh_fragment\n from taiga.projects.models import Project, ProjectTemplate\n from taiga.projects.references.models import recalc_reference_counter\n from taiga.projects.userstories.models import UserStory\n@@ -32,6 +40,8 @@ from taiga.importers.exceptions import InvalidAuthResult, FailedRequest\n from taiga.importers import services as import_service\n \n \n+logger = logging.getLogger(__name__)\n+\n GITHUB_INLINE_IMAGE_RE = re.compile(\n     r\"!\\[[^\\]\\n]*\\]\\((?P<url>https://github\\.com/user-attachments/assets/\"\n     r\"[0-9a-fA-F-]{36})\\)\"\n@@ -50,6 +60,43 @@ def extract_github_inline_image_urls(markdown):\n     return list(dict.fromkeys(urls))\n \n \n+class _FirstImageSrcParser(HTMLParser):\n+    def __init__(self):\n+        super().__init__(convert_charrefs=True)\n+        self.src = None\n+\n+    def handle_starttag(self, tag, attrs):\n+        if self.src is None and tag == \"img\":\n+            src = dict(attrs).get(\"src\")\n+            if src:\n+                self.src = src\n+\n+    handle_startendtag = handle_starttag\n+\n+\n+def extract_first_image_src(html):\n+    parser = _FirstImageSrcParser()\n+    parser.feed(html or \"\")\n+    parser.close()\n+    return parser.src\n+\n+\n+def _get_attachment_file_name(headers, asset_id, content_type):\n+    disposition = headers.get(\"Content-Disposition\")\n+    if disposition:\n+        message = Message()\n+        message[\"Content-Disposition\"] = disposition\n+        file_name = message.get_filename()\n+        if file_name:\n+            # Keep the base name only (no client paths, no traversal).\n+            file_name = file_name.replace(\"\\\\\", \"/\").rsplit(\"/\", 1)[-1].strip()\n+            if file_name not in (\"\", \".\", \"..\"):\n+                return file_name\n+\n+    extension = mimetypes.guess_extension(content_type) or \"\"\n+    return \"github-attachment-{}{}\".format(asset_id, extension)\n+\n+\n class GithubClient:\n     def __init__(self, token):\n         self.api_url = \"https://api.github.com/{}\"\n@@ -163,6 +210,59 @@ class GithubImporter:\n \n         return default\n \n+    def _import_inline_images(self, markdown, obj, repository_full_name, created_date):\n+        \"\"\"\n+        Copy the GitHub inline images of `markdown` as attachments of `obj` and\n+        return the markdown with the GitHub URLs replaced by the local ones.\n+        An image that can't be imported keeps its original URL.\n+        \"\"\"\n+        for github_url in extract_github_inline_image_urls(markdown):\n+            try:\n+                local_url = self._import_inline_image(github_url, obj, repository_full_name, created_date)\n+            except Exception:\n+                logger.warning(\n+                    \"Unable to import GitHub inline image %s for %s %s\",\n+                    github_url, obj.__class__.__name__, obj.id, exc_info=True,\n+                )\n+                continue\n+\n+            # The lookahead avoids touching a longer URL that starts with this one.\n+            markdown = re.sub(\n+                re.escape(github_url) + r\"(?![0-9A-Za-z-])\",\n+  