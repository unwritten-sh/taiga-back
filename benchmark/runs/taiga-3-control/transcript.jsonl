{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RY2y9V2sYVrw3oobmJDBpc","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t# This Source Code Form is subject to the terms of the Mozilla Public\n3\t# License, v. 2.0. If a copy of the MPL was not distributed with this\n4\t# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n5\t#\n6\t# Copyright (c) 2021-present Kaleidos INC\n7\t\n8\timport datetime\n9\timport re\n10\timport requests\n11\tfrom urllib.parse import parse_qsl\n12\tfrom django.core.files.base import ContentFile\n13\t\n14\tfrom taiga.projects.models import Project, ProjectTemplate\n15\tfrom taiga.projects.references.models import recalc_reference_counter\n16\tfrom taiga.projects.userstories.models import UserStory\n17\tfrom taiga.projects.issues.models import Issue\n18\tfrom taiga.projects.milestones.models import Milestone\n19\tfrom taiga.projects.history.services import take_snapshot\n20\tfrom taiga.projects.history.services import (make_diff_from_dicts,\n21\t                                             make_diff_values,\n22\t                                             make_key_from_model_object,\n23\t                                             get_typename_for_model_class,\n24\t                                             FrozenDiff)\n25\tfrom taiga.projects.history.models import HistoryEntry\n26\tfrom taiga.projects.history.choices import HistoryType\n27\tfrom taiga.timeline.rebuilder import rebuild_timeline\n28\tfrom taiga.timeline.models import Timeline\n29\tfrom taiga.users.models import User, AuthData\n30\t\n31\tfrom taiga.importers.exceptions import InvalidAuthResult, FailedRequest\n32\tfrom taiga.importers import services as import_service\n33\t\n34\t\n35\tGITHUB_INLINE_IMAGE_RE = re.compile(\n36\t    r\"!\\[[^\\]\\n]*\\]\\((?P<url>https://github\\.com/user-attachments/assets/\"\n37\t    r\"[0-9a-fA-F-]{36})\\)\"\n38\t)\n39\tGITHUB_INLINE_IMAGE_HTML_RE = re.compile(\n40\t    r\"<img(?=[\\s/>])[^>]*?\\ssrc\\s*=\\s*[\\\"'](?P<url>https://github\\.com/\"\n41\t    r\"user-attachments/assets/[0-9a-fA-F-]{36})[\\\"'][^>]*>\",\n42\t    re.IGNORECASE,\n43\t)\n44\t\n45\t\n46\tdef extract_github_inline_image_urls(markdown):\n47\t    urls = []\n48\t    for pattern in (GITHUB_INLINE_IMAGE_RE, GITHUB_INLINE_IMAGE_HTML_RE):\n49\t        urls.extend(match.group(\"url\") for match in pattern.finditer(markdown or \"\"))\n50\t    return list(dict.fromkeys(urls))\n51\t\n52\t\n53\tclass GithubClient:\n54\t    def __init__(self, token):\n55\t        self.api_url = \"https://api.github.com/{}\"\n56\t        self.token = token\n57\t\n58\t    def get(self, uri_path, query_params=None):\n59\t        headers = {\n60\t            \"Content-Type\": \"application/json\",\n61\t            \"X-GitHub-Media-Type\": \"github.v3\"\n62\t        }\n63\t        if self.token:\n64\t            headers['Authorization'] = 'token {}'.format(self.token)\n65\t\n66\t        if query_params is None:\n67\t            query_params = {}\n68\t\n69\t        if uri_path[0] == '/':\n70\t            uri_path = uri_path[1:]\n71\t        url = self.api_url.format(uri_path)\n72\t\n73\t        response = requests.get(url, params=query_params, headers=headers)\n74\t\n75\t        if response.status_code == 401:\n76\t            raise Exception(\"Unauthorized: %s at %s\" % (response.text, url), response)\n77\t        if response.status_code != 200:\n78\t            raise Exception(\"Resource Unavailable: %s at %s\" % (response.text, url), response)\n79\t\n80\t        return response.json()\n81\t\n82\t    def render_markdown(self, markdown, repository_full_name):\n83\t        headers = {\n84\t            \"Accept\": \"text/html\",\n85\t            \"Content-Type\": \"application/json\",\n86\t            \"X-GitHub-Media-Type\": \"github.v3\",\n87\t        }\n88\t        if self.token:\n89\t            headers[\"Authorization\"] = \"token {}\".format(self.token)\n90\t\n91\t        response = requests.post(\n92\t            self.api_url.format(\"markdown\"),\n93\t            json={\n94\t                \"text\": markdown,\n95\t                \"mode\": \"gfm\",\n96\t                \"context\": repository_full_name,\n97\t            },\n98\t            headers=headers,\n99\t        )\n100\t        if response.status_code != 200:\n101\t            raise Exception(\"Markdown rendering unavailable: %s\" % response.status_code)\n102\t        return response.text\n103\t\n104\t    def download(self, url):\n105\t        response = requests.get(url)\n106\t        if response.status_code != 200:\n107\t            raise Exception(\"Attachment download unavailable: %s\" % response.status_code)\n108\t        return response.content, response.headers\n109\t\n110\t\n111\tclass GithubImporter:\n112\t    def __init__(self, user, token, import_closed_data=False):\n113\t        self._import_closed_data = import_closed_data\n114\t        self._user = user\n115\t        self._client = GithubClient(token)\n116\t        self._me = self._client.get(\"/user\")\n117\t\n118\t    def list_projects(self):\n119\t        projects = []\n120\t        page = 1\n121\t        while True:\n122\t            repos = self._client.get(\"/user/repos\", {\n123\t                \"sort\": \"full_name\",\n124\t                \"page\": page,\n125\t                \"per_page\": 100\n126\t            })\n127\t            page += 1\n128\t\n129\t            for repo in repos:\n130\t                projects.append({\n131\t                    \"id\": repo['full_name'],\n132\t                    \"name\": repo['full_name'],\n133\t                    \"description\": repo['description'],\n134\t                    \"is_private\": repo['private'],\n135\t                })\n136\t\n137\t            if len(repos) < 100:\n138\t                break\n139\t        return projects\n140\t\n141\t    def list_users(self, project_full_name):\n142\t        collaborators = self._client.get(\"/repos/{}/collaborators\".format(project_full_name))\n143\t        collaborators = [self._client.get(\"/users/{}\".format(u['login'])) for u in collaborators]\n144\t        return [{\"id\": u['id'],\n145\t                 \"username\": u['login'],\n146\t                 \"full_name\": u.get('name', u['login']),\n147\t                 \"avatar\": u.get('avatar_url', None),\n148\t                 \"detected_user\": self._get_user(u) } for u in collaborators]\n149\t\n150\t    def _get_user(self, user, default=None):\n151\t        if not user:\n152\t            return default\n153\t\n154\t        try:\n155\t            return AuthData.objects.get(key=\"github\", value=user['id']).user\n156\t        except AuthData.DoesNotExist:\n157\t            pass\n158\t\n159\t        try:\n160\t            return User.objects.get(email=user.get('email', \"not-valid\"))\n161\t        except User.DoesNotExist:\n162\t            pass\n163\t\n164\t        return default\n165\t\n166\t    def import_project(self, project_full_name, options={\"keep_external_reference\": False, \"template\": \"kanban\", \"type\": \"user_stories\"}):\n167\t        repo = self._client.get('/repos/{}'.format(project_full_name))\n168\t        project = self._import_project_data(repo, options)\n169\t        if options.get('type', None) == \"user_stories\":\n170\t            self._import_user_stories_data(project, repo, options)\n171\t        elif options.get('type', None) == \"issues\":\n172\t            self._import_issues_data(project, repo, options)\n173\t        self._import_comments(project, repo, options)\n174\t        self._import_history(project, repo, options)\n175\t        Timeline.objects.filter(project=project).delete()\n176\t        rebuild_timeline(None, None, project.id)\n177\t        recalc_reference_counter(project)\n178\t        return project\n179\t\n180\t    def _import_project_data(self, repo, options):\n181\t        users_bindings = options.get('users_bindings', {})\n182\t        project_template = ProjectTemplate.objects.get(slug=options['template'])\n183\t\n184\t        if options['type'] == \"user_stories\":\n185\t            project_template.us_statuses = []\n186\t            project_template.us_statuses.append({\n187\t                \"name\": \"Open\",\n188\t                \"slug\": \"open\",\n189\t                \"is_closed\": False,\n190\t                \"is_archived\": False,\n191\t                \"color\": \"#ff8a84\",\n192\t                \"wip_limit\": None,\n193\t                \"order\": 1,\n194\t            })\n195\t            project_template.us_statuses.append({\n196\t                \"name\": \"Closed\",\n197\t                \"slug\": \"closed\",\n198\t                \"is_closed\": True,\n199\t                \"is_archived\": False,\n200\t                \"color\": \"#669900\",\n201\t                \"wip_limit\": None,\n202\t                \"order\": 2,\n203\t            })\n204\t            project_template.default_options[\"us_status\"] = \"Open\"\n205\t        elif options['type'] == \"issues\":\n206\t            project_template.issue_statuses = []\n207\t            project_template.issue_statuses.append({\n208\t                \"name\": \"Open\",\n209\t                \"slug\": \"open\",\n210\t                \"is_closed\": False,\n211\t                \"color\": \"#ff8a84\",\n212\t                \"order\": 1,\n213\t            })\n214\t            project_template.issue_statuses.append({\n215\t                \"name\": \"Closed\",\n216\t                \"slug\": \"closed\",\n217\t                \"is_closed\": True,\n218\t                \"color\": \"#669900\",\n219\t                \"order\": 2,\n220\t            })\n221\t            project_template.default_options[\"issue_status\"] = \"Open\"\n222\t\n223\t        project_template.roles.append({\n224\t            \"name\": \"Github\",\n225\t            \"slug\": \"github\",\n226\t            \"computable\": False,\n227\t            \"permissions\": project_template.roles[0]['permissions'],\n228\t            \"order\": 70,\n229\t        })\n230\t\n231\t        tags_colors = []\n232\t        for label in self._client.get(\"/repos/{}/labels\".format(repo['full_name'])):\n233\t            name = label['name'].lower()\n234\t            color = \"#{}\".format(label['color'])\n235\t            tags_colors.append([name, color])\n236\t\n237\t        project = Project.objects.create(\n238\t            name=options.get('name', None) or repo['full_name'],\n239\t            description=options.get('description', None) or repo['description'],\n240\t            owner=self._user,\n241\t            tags_colors=tags_colors,\n242\t            creation_template=project_template,\n243\t            is_private=options.get('is_private', False),\n244\t        )\n245\t\n246\t        if 'organization' in repo and repo['organization'].get('avatar_url', None):\n247\t            data = requests.get(repo['organization']['avatar_url'])\n248\t            project.logo.save(\"logo.png\", ContentFile(data.content), save=True)\n249\t\n250\t        import_service.create_memberships(options.get('users_bindings', {}), project, self._user, \"github\")\n251\t\n252\t        for milestone in self._client.get(\"/repos/{}/milestones\".format(repo['full_name']), {\"state\": \"all\"}):\n253\t            taiga_milestone = Milestone.objects.create(\n254\t                name=milestone['title'],\n255\t                owner=users_bindings.get(milestone.get('creator', {}).get('id', None), self._user),\n256\t                project=project,\n257\t                estimated_start=milestone['created_at'][:10],\n258\t                estimated_finish=milestone['due_on'][:10] if milestone['due_on'] else datetime.date(datetime.MAXYEAR, 12, 31),\n259\t            )\n260\t            Milestone.objects.filter(id=taiga_milestone.id).update(\n261\t                created_date=milestone['created_at'],\n262\t                modified_date=milestone['updated_at'],\n263\t            )\n264\t        return project\n265\t\n266\t    def _import_user_stories_data(self, project, repo, options):\n267\t        users_bindings = options.get('users_bindings', {})\n268\t\n269\t        page = 1\n270\t        while True:\n271\t            issues = self._client.get(\"/repos/{}/issues\".format(repo['full_name']), {\n272\t                \"state\": \"all\",\n273\t                \"sort\": \"created\",\n274\t                \"direction\": \"asc\",\n275\t                \"page\": page,\n276\t                \"per_page\": 100\n277\t            })\n278\t            page += 1\n279\t            for issue in issues:\n280\t                tags = []\n281\t                for label in issue['labels']:\n282\t                    tags.append(label['name'].lower())\n283\t\n284\t                assigned_to = users_bindings.get(issue['assignee']['id'] if issue['assignee'] else None, None)\n285\t\n286\t                external_reference = None\n287\t                if options.get('keep_external_reference', False):\n288\t                    external_reference = [\"github\", issue['html_url']]\n289\t\n290\t                milestone = None\n291\t                if issue['milestone']:\n292\t                    try:\n293\t                        milestone = project.milestones.get(name=issue['milestone']['title'])\n294\t                    except Milestone.DoesNotExist:\n295\t                        milestone = None\n296\t\n297\t                us = UserStory.objects.create(\n298\t                    ref=issue['number'],\n299\t                    project=project,\n300\t                    owner=users_bindings.get(issue['user']['id'], self._user),\n301\t                    milestone=milestone,\n302\t                    assigned_to=assigned_to,\n303\t                    status=project.us_statuses.get(slug=issue['state']),\n304\t                    kanban_order=issue['number'],\n305\t                    sprint_order=issue['number'],\n306\t                    backlog_order=issue['number'],\n307\t                    subject=issue['title'],\n308\t                    description=issue.get(\"body\", \"\") or \"\",\n309\t                    tags=tags,\n310\t                    external_reference=external_reference,\n311\t                    modified_date=issue['updated_at'],\n312\t                    created_date=issue['created_at'],\n313\t                )\n314\t\n315\t                assignees = issue.get('assignees', [])\n316\t                if len(assignees) > 1:\n317\t                    for assignee in assignees:\n318\t                        if assignee['id'] != issue.get('assignee', {}).get('id', None):\n319\t                            assignee_user = users_bindings.get(assignee['id'], None)\n320\t                            if assignee_user is not None:\n321\t                                us.add_watcher(assignee_user)\n322\t\n323\t                UserStory.objects.filter(id=us.id).update(\n324\t                    ref=issue['number'],\n325\t                    modified_date=issue['updated_at'],\n326\t                    created_date=issue['created_at']\n327\t                )\n328\t\n329\t                take_snapshot(us, comment=\"\", user=None, delete=False)\n330\t\n331\t            if len(issues) < 100:\n332\t                break\n333\t\n334\t    def _import_issues_data(self, project, repo, options):\n335\t        users_bindings = options.get('users_bindings', {})\n336\t\n337\t        page = 1\n338\t        while True:\n339\t            issues = self._client.get(\"/repos/{}/issues\".format(repo['full_name']), {\n340\t                \"state\": \"all\",\n341\t                \"sort\": \"created\",\n342\t                \"direction\": \"asc\",\n343\t                \"page\": page,\n344\t                \"per_page\": 100\n345\t            })\n346\t            page += 1\n347\t            for issue in issues:\n348\t                tags = []\n349\t                for label in issue['labels']:\n350\t                    tags.append(label['name'].lower())\n351\t\n352\t                assigned_to = users_bindings.get(issue['assignee']['id'] if issue['assignee'] else None, None)\n353\t\n354\t                external_reference = None\n355\t                if options.get('keep_external_reference', False):\n356\t                    external_reference = [\"github\", issue['html_url']]\n357\t\n358\t                taiga_issue = Issue.objects.create(\n359\t                    ref=issue['number'],\n360\t                    project=project,\n361\t                    owner=users_bindings.get(issue['user']['id'], self._user),\n362\t                    assigned_to=assigned_to,\n363\t                    status=project.issue_statuses.get(slug=issue['state']),\n364\t                    subject=issue['title'],\n365\t                    description=issue.get('body', \"\") or \"\",\n366\t                    tags=tags,\n367\t                    external_reference=external_reference,\n368\t                    modified_date=issue['updated_at'],\n369\t                    created_date=issue['created_at'],\n370\t                )\n371\t\n372\t                assignees = issue.get('assignees', [])\n373\t                if len(assignees) > 1:\n374\t                    for assignee in assignees:\n375\t                        if assignee['id'] != issue.get('assignee', {}).get('id', None):\n376\t                            assignee_user = users_bindings.get(assignee['id'], None)\n377\t                            if assignee_user is not None:\n378\t                                taiga_issue.add_watcher(assignee_user)\n379\t\n380\t                Issue.objects.filter(id=taiga_issue.id).update(\n381\t                    ref=issue['number'],\n382\t                    modified_date=issue['updated_at'],\n383\t                    created_date=issue['created_at']\n384\t                )\n385\t\n386\t                take_snapshot(taiga_issue, comment=\"\", user=None, delete=False)\n387\t\n388\t            if len(issues) < 100:\n389\t                break\n390\t\n391\t    def _import_comments(self, project, repo, options):\n392\t        users_bindings = options.get('users_bindings', {})\n393\t\n394\t        page = 1\n395\t        while True:\n396\t            comments = self._client.get(\"/repos/{}/issues/comments\".format(repo['full_name']), {\n397\t                \"page\": page,\n398\t                \"per_page\": 100\n399\t            })\n400\t            page += 1"}]},"parent_tool_use_id":null,"session_id":"c1751cbe-4841-43ac-a3f5-f4881d3ba1cc","uuid":"eb284d99-e6e3-42e0-921b-75aea9cb5e12","timestamp":"2026-11-02T06:08:15.966Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-3-control/taiga/importers/github/importer.py","content":"# -*- coding: utf-8 -*-\n# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n#\n# Copyright (c) 2021-present Kaleidos INC\n\nimport datetime\nimport re\nimport requests\nfrom urllib.parse import parse_qsl\nfrom django.core.files.base import ContentFile\n\nfrom taiga.projects.models import Project, ProjectTemplate\nfrom taiga.projects.references.models import recalc_reference_counter\nfrom taiga.projects.userstories.models import UserStory\nfrom taiga.projects.issues.models import Issue\nfrom taiga.projects.milestones.models import Milestone\nfrom taiga.projects.history.services import take_snapshot\nfrom taiga.projects.history.services import (make_diff_from_dicts,\n                                             make_diff_values,\n                                             make_key_from_model_object,\n                                             get_typename_for_model_class,\n                                             FrozenDiff)\nfrom taiga.projects.history.models import HistoryEntry\nfrom taiga.projects.history.choices import HistoryType\nfrom taiga.timeline.rebuilder import rebuild_timeline\nfrom taiga.timeline.models import Timeline\nfrom taiga.users.models import User, AuthData\n\nfrom taiga.importers.exceptions import InvalidAuthResult, FailedRequest\nfrom taiga.importers import services as import_service\n\n\nGITHUB_INLINE_IMAGE_RE = re.compile(\n    r\"!\\[[^\\]\\n]*\\]\\((?P<url>https://github\\.com/user-attachments/assets/\"\n    r\"[0-9a-fA-F-]{36})\\)\"\n)\nGITHUB_INLINE_IMAGE_HTML_RE = re.compile(\n    r\"<img(?=[\\s/>])[^>]*?\\ssrc\\s*=\\s*[\\\"'](?P<url>https://github\\.com/\"\n    r\"user-attachments/assets/[0-9a-fA-F-]{36})[\\\"'][^>]*>\",\n    re.IGNORECASE,\n)\n\n\ndef extract_github_inline_image_urls(markdown):\n    urls = []\n    for pattern in (GITHUB_INLINE_IMAGE_RE, GITHUB_INLINE_IMAGE_HTML_RE):\n        urls.extend(match.group(\"url\") for match in pattern.finditer(markdown or \"\"))\n    return list(dict.fromkeys(urls))\n\n\nclass GithubClient:\n    def __init__(self, token):\n        self.api_url = \"https://api.github.com/{}\"\n        self.token = token\n\n    def get(self, uri_path, query_params=None):\n        headers = {\n            \"Content-Type\": \"application/json\",\n            \"X-GitHub-Media-Type\": \"github.v3\"\n        }\n        if self.token:\n            headers['Authorization'] = 'token {}'.format(self.token)\n\n        if query_params is None:\n            query_params = {}\n\n        if uri_path[0] == '/':\n            uri_path = uri_path[1:]\n        url = self.api_url.format(uri_path)\n\n        response = requests.get(url, params=query_params, headers=headers)\n\n        if response.status_code == 401:\n            raise Exception(\"Unauthorized: %s at %s\" % (response.text, url), response)\n        if response.status_code != 200:\n            raise Exception(\"Resource Unavailable: %s at %s\" % (response.text, url), response)\n\n        return response.json()\n\n    def render_markdown(self, markdown, repository_full_name):\n        headers = {\n            \"Accept\": \"text/html\",\n            \"Content-Type\": \"application/json\",\n            \"X-GitHub-Media-Type\": \"github.v3\",\n        }\n        if self.token:\n            headers[\"Authorization\"] = \"token {}\".format(self.token)\n\n        response = requests.post(\n            self.api_url.format(\"markdown\"),\n            json={\n                \"text\": markdown,\n                \"mode\": \"gfm\",\n                \"context\": repository_full_name,\n            },\n            headers=headers,\n        )\n        if response.status_code != 200:\n            raise Exception(\"Markdown rendering unavailable: %s\" % response.status_code)\n        return response.text\n\n    def download(self, url):\n        response = requests.get(url)\n        if response.status_code != 200:\n            raise Exception(\"Attachment download unavailable: %s\" % response.status_code)\n        return response.content, response.headers\n\n\nclass GithubImporter:\n    def __init__(self, user, token, import_closed_data=False):\n        self._import_closed_data = import_closed_data\n        self._user = user\n        self._client = GithubClient(token)\n        self._me = self._client.get(\"/user\")\n\n    def list_projects(self):\n        projects = []\n        page = 1\n        while True:\n            repos = self._client.get(\"/user/repos\", {\n                \"sort\": \"full_name\",\n                \"page\": page,\n                \"per_page\": 100\n            })\n            page += 1\n\n            for repo in repos:\n                projects.append({\n                    \"id\": repo['full_name'],\n                    \"name\": repo['full_name'],\n                    \"description\": repo['description'],\n                    \"is_private\": repo['private'],\n                })\n\n            if len(repos) < 100:\n                break\n        return projects\n\n    def list_users(self, project_full_name):\n        collaborators = self._client.get(\"/repos/{}/collaborators\".format(project_full_name))\n        collaborators = [self._client.get(\"/users/{}\".format(u['login'])) for u in collaborators]\n        return [{\"id\": u['id'],\n                 \"username\": u['login'],\n                 \"full_name\": u.get('name', u['login']),\n                 \"avatar\": u.get('avatar_url', None),\n                 \"detected_user\": self._get_user(u) } for u in collaborators]\n\n    def _get_user(self, user, default=None):\n        if not user:\n            return default\n\n        try:\n            return AuthData.objects.get(key=\"github\", value=user['id']).user\n        except AuthData.DoesNotExist:\n            pass\n\n        try:\n            return User.objects.get(email=user.get('email', \"not-valid\"))\n        except User.DoesNotExist:\n            pass\n\n        return default\n\n    def import_project(self, project_full_name, options={\"keep_external_reference\": False, \"template\": \"kanban\", \"type\": \"user_stories\"}):\n        repo = self._client.get('/repos/{}'.format(project_full_name))\n        project = self._import_project_data(repo, options)\n        if options.get('type', None) == \"user_stories\":\n            self._import_user_stories_data(project, repo, options)\n        elif options.get('type', None) == \"issues\":\n            self._import_issues_data(project, repo, options)\n        self._import_comments(project, repo, options)\n        self._import_history(project, repo, options)\n        Timeline.objects.filter(project=project).delete()\n        rebuild_timeline(None, None, project.id)\n        recalc_reference_counter(project)\n        return project\n\n    def _import_project_data(self, repo, options):\n        users_bindings = options.get('users_bindings', {})\n        project_template = ProjectTemplate.objects.get(slug=options['template'])\n\n        if options['type'] == \"user_stories\":\n            project_template.us_statuses = []\n            project_template.us_statuses.append({\n                \"name\": \"Open\",\n                \"slug\": \"open\",\n                \"is_closed\": False,\n                \"is_archived\": False,\n                \"color\": \"#ff8a84\",\n                \"wip_limit\": None,\n                \"order\": 1,\n            })\n            project_template.us_statuses.append({\n                \"name\": \"Closed\",\n                \"slug\": \"closed\",\n                \"is_closed\": True,\n                \"is_archived\": False,\n                \"color\": \"#669900\",\n                \"wip_limit\": None,\n                \"order\": 2,\n            })\n            project_template.default_options[\"us_status\"] = \"Open\"\n        elif options['type'] == \"issues\":\n            project_template.issue_statuses = []\n            project_template.issue_statuses.append({\n                \"name\": \"Open\",\n                \"slug\": \"open\",\n                \"is_closed\": False,\n                \"color\": \"#ff8a84\",\n                \"order\": 1,\n            })\n            project_template.issue_statuses.append({\n                \"name\": \"Closed\",\n                \"slug\": \"closed\",\n                \"is_closed\": True,\n                \"color\": \"#669900\",\n                \"order\": 2,\n            })\n            project_template.default_options[\"issue_status\"] = \"Open\"\n\n        project_template.roles.append({\n            \"name\": \"Github\",\n            \"slug\": \"github\",\n            \"computable\": False,\n            \"permissions\": project_template.roles[0]['permissions'],\n            \"order\": 70,\n        })\n\n        tags_colors = []\n        for label in self._client.get(\"/repos/{}/labels\".format(repo['full_name'])):\n            name = label['name'].lower()\n            color = \"#{}\".format(label['color'])\n            tags_colors.append([name, color])\n\n        project = Project.objects.create(\n            name=options.get('name', None) or repo['full_name'],\n            description=options.get('description', None) or repo['description'],\n            owner=self._user,\n            tags_colors=tags_colors,\n            creation_template=project_template,\n            is_private=options.get('is_private', False),\n        )\n\n        if 'organization' in repo and repo['organization'].get('avatar_url', None):\n            data = requests.get(repo['organization']['avatar_url'])\n            project.logo.save(\"logo.png\", ContentFile(data.content), save=True)\n\n        import_service.create_memberships(options.get('users_bindings', {}), project, self._user, \"github\")\n\n        for milestone in self._client.get(\"/repos/{}/milestones\".format(repo['full_name']), {\"state\": \"all\"}):\n            taiga_milestone = Milestone.objects.create(\n                name=milestone['title'],\n                owner=users_bindings.get(milestone.get('creator', {}).get('id', None), self._user),\n                project=project,\n                estimated_start=milestone['created_at'][:10],\n                estimated_finish=milestone['due_on'][:10] if milestone['due_on'] else datetime.date(datetime.MAXYEAR, 12, 31),\n            )\n            Milestone.objects.filter(id=taiga_milestone.id).update(\n                created_date=milestone['created_at'],\n                modified_date=milestone['updated_at'],\n            )\n        return project\n\n    def _import_user_stories_data(self, project, repo, options):\n        users_bindings = options.get('users_bindings', {})\n\n        page = 1\n        while True:\n            issues = self._client.get(\"/repos/{}/issues\".format(repo['full_name']), {\n                \"state\": \"all\",\n                \"sort\": \"created\",\n                \"direction\": \"asc\",\n                \"page\": page,\n                \"per_page\": 100\n            })\n            page += 1\n            for issue in issues:\n                tags = []\n                for label in issue['labels']:\n                    tags.append(label['name'].lower())\n\n                assigned_to = users_bindings.get(issue['assignee']['id'] if issue['assignee'] else None, None)\n\n                external_reference = None\n                if options.get('keep_external_reference', False):\n                    external_reference = [\"github\", issue['html_url']]\n\n                milestone = None\n                if issue['milestone']:\n                    try:\n                        milestone = project.milestones.get(name=issue['milestone']['title'])\n                    except Milestone.DoesNotExist:\n                        milestone = None\n\n                us = UserStory.objects.create(\n                    ref=issue['number'],\n                    project=project,\n                    owner=users_bindings.get(issue['user']['id'], self._user),\n                    milestone=milestone,\n                    assigned_to=assigned_to,\n                    status=project.us_statuses.get(slug=issue['state']),\n                    kanban_order=issue['number'],\n                    sprint_order=issue['number'],\n                    backlog_order=issue['number'],\n                    subject=issue['title'],\n                    description=issue.get(\"body\", \"\") or \"\",\n                    tags=tags,\n                    external_reference=external_reference,\n                    modified_date=issue['updated_at'],\n                    created_date=issue['created_at'],\n                )\n\n                assignees = issue.get('assignees', [])\n                if len(assignees) > 1:\n                    for assignee in assignees:\n                        if assignee['id'] != issue.get('assignee', {}).get('id', None):\n                            assignee_user = users_bindings.get(assignee['id'], None)\n                            if assignee_user is not None:\n                                us.add_watcher(assignee_user)\n\n                UserStory.objects.filter(id=us.id).update(\n                    ref=issue['number'],\n                    modified_date=issue['updated_at'],\n                    created_date=issue['created_at']\n                )\n\n                take_snapshot(us, comment=\"\", user=None, delete=False)\n\n            if len(issues) < 100:\n                break\n\n    def _import_issues_data(self, project, repo, options):\n        users_bindings = options.get('users_bindings', {})\n\n        page = 1\n        while True:\n            issues = self._client.get(\"/repos/{}/issues\".format(repo['full_name']), {\n                \"state\": \"all\",\n                \"sort\": \"created\",\n                \"direction\": \"asc\",\n                \"page\": page,\n                \"per_page\": 100\n            })\n            page += 1\n            for issue in issues:\n                tags = []\n                for label in issue['labels']:\n                    tags.append(label['name'].lower())\n\n                assigned_to = users_bindings.get(issue['assignee']['id'] if issue['assignee'] else None, None)\n\n                external_reference = None\n                if options.get('keep_external_reference', False):\n                    external_reference = [\"github\", issue['html_url']]\n\n                taiga_issue = Issue.objects.create(\n                    ref=issue['number'],\n                    project=project,\n                    owner=users_bindings.get(issue['user']['id'], self._user),\n                    assigned_to=assigned_to,\n                    status=project.issue_statuses.get(slug=issue['state']),\n                    subject=issue['title'],\n                    description=issue.get('body', \"\") or \"\",\n                    tags=tags,\n                    external_reference=external_reference,\n                    modified_date=issue['updated_at'],\n                    created_date=issue['created_at'],\n                )\n\n                assignees = issue.get('assignees', [])\n                if len(assignees) > 1:\n                    for assignee in assignees:\n                        if assignee['id'] != issue.get('assignee', {}).get('id', None):\n                            assignee_user = users_bindings.get(assignee['id'], None)\n                            if assignee_user is not None:\n                                taiga_issue.add_watcher(assignee_user)\n\n                Issue.objects.filter(id=taiga_issue.id).update(\n                    ref=issue['number'],\n                    modified_date=issue['updated_at'],\n                    created_date=issue['created_at']\n                )\n\n                take_snapshot(taiga_issue, comment=\"\", user=None, delete=False)\n\n            if len(issues) < 100:\n                break\n\n    def _import_comments(self, project, repo, options):\n        users_bindings = options.get('users_bindings', {})\n\n        page = 1\n        while True:\n            comments = self._client.get(\"/repos/{}/issues/comments\".format(repo['full_name']), {\n                \"page\": page,\n                \"per_page\": 100\n            })\n            page += 1","numLines":400,"startLine":1,"totalLines":663}},"tool_result_meta":[{"id":"toolu_01RY2y9V2sYVrw3oobmJDBpc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
