(project, {\"full_name\": \"owner/repo\"}, {})\n\n    us = UserStory.objects.get(project=project, ref=1)\n    attachment = Attachment.objects.get()\n    assert attachment.object_id == us.id\n    assert attachment.content_type == ContentType.objects.get_for_model(UserStory)\n    assert us.description == \"Image ![a]({}) and broken ![b]({})\".format(_local_url(attachment), URL_2)\n    assert UserStory.objects.get(project=project, ref=2).description == \"No images\"\n    assert importer._client.render_markdown.call_args_list[0] == mock.call(\n        \"![image]({})\".format(URL_1), \"owner/repo\")\n\n\ndef test_import_issues_rewrites_inline_images():\n    project = f.ProjectFactory.create()\n    f.IssueStatusFactory.create(project=project, slug=\"open\")\n    project.default_severity = f.SeverityFactory.create(project=project)\n    project.default_priority = f.PriorityFactory.create(project=project)\n    project.default_issue_type = f.IssueTypeFactory.create(project=project)\n    project.save()\n    importer = _setup_import(project)\n\n    importer._import_issues_data(project, {\"full_name\": \"owner/repo\"}, {})\n\n    issue = Issue.objects.get(project=project, ref=1)\n    attachment = Attachment.objects.get()\n    assert attachment.object_id == issue.id\n    assert attachment.content_type == ContentType.objects.get_for_model(Issue)\n    assert \"_taiga-refresh=issue:{}\".format(attachment.id) in issue.description\n    assert issue.description == \"Image ![a]({}) and broken ![b]({})\".format(_local_url(attachment), URL_2)\n    assert Issue.objects.get(project=project, ref=2).description == \"No images\"\n"}}}
