{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UUP2upeXDMp1TuJkH2ZWrB","type":"tool_result","content":"The file /Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-3-control/tests/unit/test_importers_github.py has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"c1751cbe-4841-43ac-a3f5-f4881d3ba1cc","uuid":"79d3b198-cd84-4b02-9142-ce9b823a2840","timestamp":"2026-11-02T06:10:52.311Z","tool_use_result":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/taiga/bench/trees/taiga-3-control/tests/unit/test_importers_github.py","oldString":"from taiga.importers.github.importer import (\n    GithubClient,\n    extract_github_inline_image_urls,\n)\n","newString":"from taiga.importers.github.importer import (\n    GithubClient,\n    _get_attachment_file_name,\n    extract_first_image_src,\n    extract_github_inline_image_urls,\n)\n\n\ndef test_extract_first_image_src_unescapes_the_signed_url():\n    html = (\n        '<p><a href=\"https://signed.invalid/a.png?jwt=1&amp;x=2\">'\n        '<img src=\"https://signed.invalid/a.png?jwt=1&amp;x=2\" alt=\"image\"></a>'\n        '<img src=\"https://signed.invalid/b.png\"></p>'\n    )\n\n    assert extract_first_image_src(html) == \"https://signed.invalid/a.png?jwt=1&x=2\"\n    assert extract_first_image_src(\"<p>no image</p>\") is None\n\n\n@pytest.mark.parametrize(\"headers, expected\", [\n    ({\"Content-Disposition\": 'attachment; filename=\"shot.png\"'}, \"shot.png\"),\n    ({\"Content-Disposition\": \"attachment; filename=../../etc/shot.png\"}, \"shot.png\"),\n    ({\"Content-Disposition\": \"attachment; filename=C:\\\\tmp\\\\shot.png\"}, \"shot.png\"),\n    ({\"Content-Disposition\": \"attachment; filename*=UTF-8''capture%20%C3%A9.png\"}, \"capture \\u00e9.png\"),\n    ({\"Content-Disposition\": \"inline\"}, \"github-attachment-asset-id.png\"),\n    ({\"Content-Disposition\": 'attachment; filename=\"..\"'}, \"github-attachment-asset-id.png\"),\n    ({}, \"github-attachment-asset-id.png\"),\n])\ndef test_get_attachment_file_name(headers, expected):\n    assert _get_attachment_file_name(headers, \"asset-id\", \"image/png\") == expected\n","originalFile":"# -*- coding: utf-8 -*-\n\nfrom unittest import mock\n\nimport pytest\n\nfrom taiga.importers.github.importer import (\n    GithubClient,\n    extract_github_inline_image_urls,\n)\n\n\ndef test_extract_github_inline_image_urls():\n    attachment_url = \"https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111\"\n    markdown = \"![image]({}) ![same]({})\".format(attachment_url, attachment_url)\n\n    assert extract_github_inline_image_urls(markdown) == [attachment_url]\n\n\n@pytest.mark.parametrize(\"markdown\", [\n    \"![image](https://images.invalid/image.png)\",\n    \"[issue](https://github.invalid/org/repo/issues/1)\",\n    \"![image](https://github.com/user-attachments/assets/not-a-uuid)\",\n    \"<img data-src=\\\"https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111\\\" src=\\\"https://images.invalid/image.png\\\">\",\n    \"<img-custom src=\\\"https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111\\\">\",\n])\ndef test_extract_github_inline_image_urls_ignores_unsupported_markdown(markdown):\n    assert extract_github_inline_image_urls(markdown) == []\n\n\ndef test_extract_github_inline_image_urls_from_html():\n    attachment_url = \"https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111\"\n    html = '<img width=\"305\" height=\"171\" alt=\"Image\" src=\"{}\" />'.format(attachment_url)\n\n    assert extract_github_inline_image_urls(html) == [attachment_url]\n\n\n@mock.patch(\"taiga.importers.github.importer.requests.post\")\ndef test_render_markdown_sends_context_and_authorization(post):\n    post.return_value = mock.Mock(status_code=200, text=\"<img src=\\\"signed-url\\\">\")\n    client = GithubClient(\"oauth-token\")\n    client.api_url = \"https://api.invalid/{}\"\n\n    rendered = client.render_markdown(\n        \"![image](https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111)\",\n        \"owner/repository\",\n    )\n\n    assert rendered == \"<img src=\\\"signed-url\\\">\"\n    post.assert_called_once_with(\n        \"https://api.invalid/markdown\",\n        json={\n            \"text\": \"![image](https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111)\",\n            \"mode\": \"gfm\",\n            \"context\": \"owner/repository\",\n        },\n        headers={\n            \"Accept\": \"text/html\",\n            \"Content-Type\": \"application/json\",\n            \"X-GitHub-Media-Type\": \"github.v3\",\n            \"Authorization\": \"token oauth-token\",\n        },\n    )\n\n\n@mock.patch(\"taiga.importers.github.importer.requests.get\")\ndef test_download_does_not_send_github_token(get):\n    get.return_value = mock.Mock(\n        status_code=200,\n        content=b\"image-bytes\",\n        headers={\"Content-Type\": \"image/png\"},\n    )\n    client = GithubClient(\"oauth-token\")\n\n    content, headers = client.download(\"https://signed.invalid/image.png?jwt=mock-token\")\n\n    assert content == b\"image-bytes\"\n    assert headers[\"Content-Type\"] == \"image/png\"\n    get.assert_called_once_with(\"https://signed.invalid/image.png?jwt=mock-token\")\n\n\n@pytest.mark.parametrize(\"method\", [\"render_markdown\", \"download\"])\ndef test_github_client_raises_for_unavailable_resource(method):\n    with mock.patch(\"taiga.importers.github.importer.requests.post\") as post, \\\n            mock.patch(\"taiga.importers.github.importer.requests.get\") as get:\n        post.return_value = mock.Mock(status_code=500, text=\"error\")\n        get.return_value = mock.Mock(status_code=404, text=\"error\")\n        client = GithubClient(\"oauth-token\")\n\n        with pytest.raises(Exception):\n            if method == \"render_markdown\":\n                client.render_markdown(\"![image](url)\", \"owner/repository\")\n            else:\n                client.download(\"https://signed.invalid/image.png?jwt=mock-token\")\n","structuredPatch":[{"oldStart":6,"oldLines":10,"newStart":6,"newLines":36,"lines":[" "," from taiga.importers.github.importer import (","     GithubClient,","+    _get_attachment_file_name,","+    extract_first_image_src,","     extract_github_inline_image_urls,"," )"," "," ","+def test_extract_first_image_src_unescapes_the_signed_url():","+    html = (","+        '<p><a href=\"https://signed.invalid/a.png?jwt=1&amp;x=2\">'","+        '<img src=\"https://signed.invalid/a.png?jwt=1&amp;x=2\" alt=\"image\"></a>'","+        '<img src=\"https://signed.invalid/b.png\"></p>'","+    )","+","+    assert extract_first_image_src(html) == \"https://signed.invalid/a.png?jwt=1&x=2\"","+    assert extract_first_image_src(\"<p>no image</p>\") is None","+","+","+@pytest.mark.parametrize(\"headers, expected\", [","+    ({\"Content-Disposition\": 'attachment; filename=\"shot.png\"'}, \"shot.png\"),","+    ({\"Content-Disposition\": \"attachment; filename=../../etc/shot.png\"}, \"shot.png\"),","+    ({\"Content-Disposition\": \"attachment; filename=C:\\\\tmp\\\\shot.png\"}, \"shot.png\"),","+    ({\"Content-Disposition\": \"attachment; filename*=UTF-8''capture%20%C3%A9.png\"}, \"capture \\u00e9.png\"),","+    ({\"Content-Disposition\": \"inline\"}, \"github-attachment-asset-id.png\"),","+    ({\"Content-Disposition\": 'attachment; filename=\"..\"'}, \"github-attachment-asset-id.png\"),","+    ({}, \"github-attachment-asset-id.png\"),","+])","+def test_get_attachment_file_name(headers, expected):","+    assert _get_attachment_file_name(headers, \"asset-id\", \"image/png\") == expected","+","+"," def test_extract_github_inline_image_urls():","     attachment_url = \"https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111\"","     markdown = \"![image]({}) ![same]({})\".format(attachment_url, attachment_url)"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01UUP2upeXDMp1TuJkH2ZWrB","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
