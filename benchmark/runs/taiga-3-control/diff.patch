+    def _import_inline_images(self, markdown, obj, repository_full_name, created_date):
+        """
+        Copy the GitHub inline images of `markdown` as attachments of `obj` and
+        return the markdown with the GitHub URLs replaced by the local ones.
+        An image that can't be imported keeps its original URL.
+        """
+        for github_url in extract_github_inline_image_urls(markdown):
+            try:
+                local_url = self._import_inline_image(github_url, obj, repository_full_name, created_date)
+            except Exception:
+                logger.warning(
+                    "Unable to import GitHub inline image %s for %s %s",
+                    github_url, obj.__class__.__name__, obj.id, exc_info=True,
+                )
+                continue
+
+            # The lookahead avoids touching a longer URL that starts with this one.
+            markdown = re.sub(
+                re.escape(github_url) + r"(?![0-9A-Za-z-])",
+                lambda match: local_url,
+                markdown,
+            )
+        return markdown
+
+    def _import_inline_image(self, github_url, obj, repository_full_name, created_date):
+        html = self._client.render_markdown("![image]({})".format(github_url), repository_full_name)
+        signed_url = extract_first_image_src(html)
+        if not signed_url:
+            raise ValueError("No image found in the rendered markdown")
+
+        content, headers = self._client.download(signed_url)
+        headers = CaseInsensitiveDict(headers or {})
+        content_type = (headers.get("Content-Type") or "").split(";")[0].strip().lower()
+        if not content_type.startswith("image/"):
+            raise ValueError("Unexpected content type: {!r}".format(content_type))
+
+        asset_id = github_url.rstrip("/").rsplit("/", 1)[-1]
+        file_name = _get_attachment_file_name(headers, asset_id, content_type)
+
+        attachment = Attachment(
+            owner=obj.owner,
+            project=obj.project,
+            content_type=ContentType.objects.get_for_model(obj),
+            object_id=obj.id,
+            name=file_name,
+            size=len(content),
+            created_date=created_date,
+            is_deprecated=False,
+        )
+        attachment.attached_file.save(file_name, ContentFile(content), save=True)
+
+        return "{}#{}".format(attachment.attached_file.url, generate_refresh_fragment(attachment))
+
