+def test_extract_first_image_src_unescapes_the_signed_url():
+    html = (
+        '<p><a href="https://signed.invalid/a.png?jwt=1&amp;x=2">'
+        '<img src="https://signed.invalid/a.png?jwt=1&amp;x=2" alt="image"></a>'
+        '<img src="https://signed.invalid/b.png"></p>'
+    )
+
+    assert extract_first_image_src(html) == "https://signed.invalid/a.png?jwt=1&x=2"
+    assert extract_first_image_src("<p>no image</p>") is None
+
