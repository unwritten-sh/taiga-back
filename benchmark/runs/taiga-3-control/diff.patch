+def _github_issue(number, body):
+    return {
+        "number": number,
+        "title": "Issue {}".format(number),
+        "body": body,
+        "state": "open",
+        "labels": [],
+        "assignee": None,
+        "assignees": [],
+        "milestone": None,
+        "user": {"id": 1},
+        "html_url": "https://github.invalid/owner/repo/issues/{}".format(number),
+        "created_at": "2020-01-02T03:04:05Z",
+        "updated_at": "2020-01-03T03:04:05Z",
+    }
+
+
+def _setup_import(project):
+    importer = _make_importer({
+        URL_1: (PNG, {"Content-Type": "image/png", "Content-Disposition": "attachment; filename=shot.png"}),
+        URL_2: Exception("expired"),
+    })
+    issues = [
+        _github_issue(1, "Image ![a]({}) and broken ![b]({})".format(URL_1, URL_2)),
+        _github_issue(2, "No images"),
+    ]
+    importer._client.get.side_effect = lambda path, params=None: issues
+    return importer
+
+
+def test_import_user_stories_rewrites_inline_images():
+    project = f.ProjectFactory.create()
+    f.UserStoryStatusFactory.create(project=project, name="Open")
+    importer = _setup_import(project)
+
+    importer._import_user_stories_data(project, {"full_name": "owner/repo"}, {})
+
+    us = UserStory.objects.get(project=project, ref=1)
+    attachment = Attachment.objects.get()
+    assert attachment.object_id == us.id
+    assert attachment.content_type == ContentType.objects.get_for_model(UserStory)
+    assert us.description == "Image ![a]({}) and broken ![b]({})".format(_local_url(attachment), URL_2)
+    assert UserStory.objects.get(project=project, ref=2).description == "No images"
+    assert importer._client.render_markdown.call_args_list[0] == mock.call(
+        "![image]({})".format(URL_1), "owner/repo")
+
+
+def test_import_issues_rewrites_inline_images():
+    project = f.ProjectFactory.create()
+    f.IssueStatusFactory.create(project=project, name="Open")
+    project.default_severity = f.SeverityFactory.create(project=project)
+    project.default_priority = f.PriorityFactory.create(project=project)
+    project.default_issue_type = f.IssueTypeFactory.create(project=project)
+    project.save()
+    importer = _setup_import(project)
+
+    importer._import_issues_data(project, {"full_name": "owner/repo"}, {})
+
+    issue = Issue.objects.get(project=project, ref=1)
+    attachment = Attachment.objects.get()
+    assert attachment.object_id == issue.id
+    assert attachment.content_type == ContentType.objects.get_for_model(Issue)
+    assert "_taiga-refresh=issue:{}".format(attachment.id) in issue.description
+    assert issue.description == "Image ![a]({}) and broken ![b]({})".format(_local_url(attachment), URL_2)
+    assert Issue.objects.get(project=project, ref=2).description == "No images"
