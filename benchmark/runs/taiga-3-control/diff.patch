+
+from unittest import mock
+
+import pytest
+
+from django.contrib.contenttypes.models import ContentType
+
+from taiga.importers.github.importer import GithubImporter
+from taiga.projects.attachments.models import Attachment
+from taiga.projects.attachments.services import generate_refresh_fragment
+from taiga.projects.issues.models import Issue
+from taiga.projects.userstories.models import UserStory
+
+from .. import factories as f
+
+
+pytestmark = pytest.mark.django_db
+
+URL_1 = "https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111"
+URL_2 = "https://github.com/user-attachments/assets/22222222-2222-2222-2222-222222222222"
+URL_3 = "https://github.com/user-attachments/assets/33333333-3333-3333-3333-333333333333"
+PNG = b"\x89PNG\r\n\x1a\nfake-image"
+
+
+def _signed(github_url):
+    return "https://signed.invalid/{}.png?jwt=a&amp;x=1".format(github_url.rsplit("/", 1)[-1])
+
+
+def _make_importer(downloads):
+    """
+    `downloads` maps a GitHub URL to the (content, headers) the signed URL
+    returns, or to an exception to raise.
+    """
+    importer = GithubImporter.__new__(GithubImporter)
+    importer._user = None
+    importer._import_closed_data = False
+    importer._client = mock.Mock()
+
+    def render_markdown(markdown, repository_full_name):
+        github_url = markdown[len("![image]("):-1]
+        return '<p><a href="x"><img src="{}" alt="image" style="max-width: 100%;"></a></p>'.format(
+            _signed(github_url))
+
+    def download(url):
+        for github_url, result in downloads.items():
+            if _signed(github_url).replace("&amp;", "&") == url:
+                if isinstance(result, Exception):
+                    raise result
+                return result
+        raise AssertionError("Unexpected download of {}".format(url))
+
+    importer._client.render_markdown.side_effect = render_markdown
+    importer._client.download.side_effect = download
+    return importer
+
+
+def _local_url(attachment):
+    return "{}#{}".format(attachment.attached_file.url, generate_refresh_fragment(attachment))
+
+
+def test_import_inline_images_creates_attachments_and_rewrites_markdown():
+    us = f.UserStoryFactory.create()
+    importer = _make_importer({
+        URL_1: (PNG, {"Content-Type": "image/png",
+                      "Content-Disposition": 'attachment; filename="../dir/screenshot.png"'}),
+        URL_2: (b"jpeg-bytes", {"content-type": "image/jpeg; charset=binary"}),
+    })
+    markdown = "First ![a]({0})\nAgain ![b]({0})\n<img alt=\"x\" src=\"{1}\" />".format(URL_1, URL_2)
+
+    result = importer._import_inline_images(markdown, us, "owner/repo", "2020-01-02T03:04:05Z")
+
+    # Each distinct URL is rendered and downloaded once.
+    assert importer._client.render_markdown.call_args_list == [
+        mock.call("![image]({})".format(URL_1), "owner/repo"),
+        mock.call("![image]({})".format(URL_2), "owner/repo"),
+    ]
+    assert importer._client.download.call_count == 2
+
+    attachments = list(Attachment.objects.order_by("id"))
+    assert len(attachments) == 2
+    screenshot, jpeg = attachments
+
+    assert screenshot.name == "screenshot.png"
+    assert screenshot.size == len(PNG)
+    assert screenshot.owner == us.owner
+    assert screenshot.project == us.project
+    assert screenshot.content_type == ContentType.objects.get_for_model(UserStory)
+    assert screenshot.object_id == us.id
+    assert screenshot.is_deprecated is False
+    assert screenshot.created_date.year == 2020
+    assert screenshot.attached_file.read() == PNG
+
+    assert jpeg.name == "github-attachment-22222222-2222-2222-2222-222222222222.jpg"
+    assert jpeg.size == len(b"jpeg-bytes")
+
+    assert "_taiga-refresh=userstory:{}".format(screenshot.id) in _local_url(screenshot)
+    assert result == "First ![a]({0})\nAgain ![b]({0})\n<img alt=\"x\" src=\"{1}\" />".format(
+        _local_url(screenshot), _local_url(jpeg))
+    assert "github.com" not in result
+
+
+def test_import_inline_images_keeps_link_of_failed_images():
+    us = f.UserStoryFactory.create()
+    importer = _make_importer({
+        URL_1: Exception("boom"),
+        URL_2: (b"<html>login</html>", {"Content-Type": "text/html"}),
+        URL_3: (PNG, {"Content-Type": "image/png"}),
+    })
+    markdown = "![a]({}) ![b]({}) ![c]({})".format(URL_1, URL_2, URL_3)
+
+    with mock.patch("taiga.importers.github.importer.logger") as logger:
+        result = importer._import_inline_images(markdown, us, "owner/repo", "2020-01-02T03:04:05Z")
+
+    assert logger.warning.call_count == 2
+    attachment = Attachment.objects.get()
+    assert attachment.name == "github-attachment-33333333-3333-3333-3333-333333333333.png"
+    assert result == "![a]({}) ![b]({}) ![c]({})".format(URL_1, URL_2, _local_url(attachment))
+
+
+def test_import_inline_images_keeps_link_when_render_has_no_image():
+    us = f.UserStoryFactory.create()
+    importer = _make_importer({})
+    importer._client.render_markdown.side_effect = None
+    importer._client.render_markdown.return_value = "<p>nothing</p>"
+    markdown = "![a]({})".format(URL_1)
+
+    with mock.patch("taiga.importers.github.importer.logger") as logger:
+        assert importer._import_inline_images(markdown, us, "owner/repo", "2020-01-02T03:04:05Z") == markdown
+
+    logger.warning.assert_called_once()
+    importer._client.download.assert_not_called()
+    assert not Attachment.objects.exists()
+
+
+def test_import_inline_images_without_images_does_nothing():
+    us = f.UserStoryFactory.create()
+    importer = _make_importer({})
+
+    assert importer._import_inline_images("no images", us, "owner/repo", "2020-01-02T03:04:05Z") == "no images"
+    assert importer._import_inline_images("", us, "owner/repo", "2020-01-02T03:04:05Z") == ""
+    importer._client.render_markdown.assert_not_called()
+
