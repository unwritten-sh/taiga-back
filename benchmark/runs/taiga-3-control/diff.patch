+class _FirstImageSrcParser(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.src = None
+
+    def handle_starttag(self, tag, attrs):
+        if self.src is None and tag == "img":
+            src = dict(attrs).get("src")
+            if src:
+                self.src = src
+
+    handle_startendtag = handle_starttag
+
+
+def extract_first_image_src(html):
+    parser = _FirstImageSrcParser()
+    parser.feed(html or "")
+    parser.close()
+    return parser.src
+
+
+def _get_attachment_file_name(headers, asset_id, content_type):
+    disposition = headers.get("Content-Disposition")
+    if disposition:
+        message = Message()
+        message["Content-Disposition"] = disposition
+        file_name = message.get_filename()
+        if file_name:
+            # Keep the base name only (no client paths, no traversal).
+            file_name = file_name.replace("\\", "/").rsplit("/", 1)[-1].strip()
+            if file_name not in ("", ".", ".."):
+                return file_name
+
+    extension = mimetypes.guess_extension(content_type) or ""
+    return "github-attachment-{}{}".format(asset_id, extension)
+
