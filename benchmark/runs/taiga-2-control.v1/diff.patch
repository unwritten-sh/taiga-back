+def test_password_recovery_sets_token_with_expiration(client, settings):
+    settings.PASSWORD_RECOVERY_TOKEN_LIFETIME = datetime.timedelta(minutes=30)
+    user = f.UserFactory.create(username="recovery-user")
+
+    before = timezone.now()
+    response = client.post(
+        reverse("users-password-recovery"),
+        json.dumps({"username": "recovery-user"}),
+        content_type="application/json",
+    )
+    after = timezone.now()
+
+    assert response.status_code == 200
+    user.refresh_from_db()
+    assert user.token
+    assert before + datetime.timedelta(minutes=30) <= user.token_expires_at
+    assert user.token_expires_at <= after + datetime.timedelta(minutes=30)
+
+
+def test_password_recovery_again_replaces_token_and_expiration(client):
+    user = f.UserFactory.create(username="recovery-user",
+                                token="old-token",
+                                token_expires_at=timezone.now() - datetime.timedelta(days=1))
+
+    response = client.post(
+        reverse("users-password-recovery"),
+        json.dumps({"username": "recovery-user"}),
+        content_type="application/json",
+    )
+
+    assert response.status_code == 200
+    user.refresh_from_db()
+    assert user.token != "old-token"
+    assert user.token_expires_at > timezone.now()
+
+
+def test_change_password_from_recovery_with_valid_token(client):
+    user = f.UserFactory.create(token="recovery-token",
+                                token_expires_at=timezone.now() + datetime.timedelta(minutes=5))
+    user.set_password("current-password")
+    user.save()
+
+    response = client.post(
+        reverse("users-change-password-from-recovery"),
+        json.dumps({"token": "recovery-token", "password": "new-password"}),
+        content_type="application/json",
+    )
+
+    assert response.status_code == 204
+    user.refresh_from_db()
+    assert user.check_password("new-password")
+    assert user.token is None
+    assert user.token_expires_at is None
+
+
+@pytest.mark.parametrize("token_expires_at", [
+    pytest.param(lambda: timezone.now() - datetime.timedelta(seconds=1), id="expired"),
+    pytest.param(lambda: None, id="legacy-without-expiration"),
+])
+def test_change_password_from_recovery_rejects_expired_or_legacy_token(client, token_expires_at):
+    expires_at = token_expires_at()
+    user = f.UserFactory.create(token="recovery-token", token_expires_at=expires_at)
+    user.set_password("current-password")
+    user.save()
+
+    unknown_response = client.post(
+        reverse("users-change-password-from-recovery"),
+        json.dumps({"token": "unknown-token", "password": "new-password"}),
+        content_type="application/json",
+    )
+    response = client.post(
+        reverse("users-change-password-from-recovery"),
+        json.dumps({"token": "recovery-token", "password": "new-password"}),
+        content_type="application/json",
+    )
+
+    assert response.status_code == 400
+    assert response.data == unknown_response.data
+    user.refresh_from_db()
+    assert user.check_password("current-password")
+    assert user.token == "recovery-token"
+    assert user.token_expires_at == expires_at
+
+
