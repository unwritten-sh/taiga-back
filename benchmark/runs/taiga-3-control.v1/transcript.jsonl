 \"image/png\",\n                           \"Content-Disposition\": 'attachment; filename=\"../dir/screenshot.png\"'}),\n        \"22222222-2222-2222-2222-222222222222\": (b\"jpeg\", {\"content-type\": \"image/jpeg; charset=binary\"}),\n    })\n    importer = _importer(client)\n    us = f.UserStoryFactory.create()\n    markdown = \"![a]({0})\\ntext ![b]({0}) <img src=\\\"{1}\\\" />\".format(IMAGE_1, IMAGE_2)\n\n    result = importer._import_inline_images(markdown, us, \"owner/repo\", CREATED_DATE)\n\n    attachments = list(Attachment.objects.filter(object_id=us.id).order_by(\"id\"))\n    assert len(attachments) == 2\n    first, second = attachments\n    assert first.name == \"screenshot.png\"\n    assert first.size == len(b\"png-bytes\")\n    assert first.owner == us.owner\n    assert first.project == us.project\n    assert first.content_object == us\n    assert first.is_deprecated is False\n    assert first.created_date.isoformat() == \"2026-01-02T03:04:05+00:00\"\n    assert first.attached_file.read() == b\"png-bytes\"\n    assert second.name == \"github-attachment-22222222-2222-2222-2222-222222222222.jpg\"\n\n    url_1 = \"{}#_taiga-refresh=userstory:{}\".format(first.attached_file.url, first.id)\n    url_2 = \"{}#_taiga-refresh=userstory:{}\".format(second.attached_file.url, second.id)\n    assert result == \"![a]({0})\\ntext ![b]({0}) <img src=\\\"{1}\\\" />\".format(url_1, url_2)\n    assert \"github.com\" not in result\n    # Each distinct URL is rendered and downloaded once\n    assert client.render_markdown.call_count == 2\n    client.render_markdown.assert_any_call(\"![image]({})\".format(IMAGE_1), \"owner/repo\")\n    assert client.download.call_count == 2\n\n\n@pytest.mark.django_db\n@pytest.mark.parametrize(\"failure\", [\n    Exception(\"download failed\"),\n    (b\"<html></html>\", {\"Content-Type\": \"text/html\"}),\n    (b\"no content type\", {}),\n])\ndef test_import_inline_images_keeps_link_of_failed_image(failure):\n    client = _client({\n        \"11111111-1111-1111-1111-111111111111\": failure,\n        \"22222222-2222-2222-2222-222222222222\": (b\"png\", {\"Content-Type\": \"image/png\"}),\n    })\n    importer = _importer(client)\n    issue = f.IssueFactory.create()\n    markdown = \"![a]({}) ![b]({})\".format(IMAGE_1, IMAGE_2)\n\n    with mock.patch(\"taiga.importers.github.importer.logger\") as logger:\n        result = importer._import_inline_images(markdown, issue, \"owner/repo\", CREATED_DATE)\n\n    attachment = Attachment.objects.get(object_id=issue.id)\n    assert attachment.name == \"github-attachment-22222222-2222-2222-2222-222222222222.png\"\n    assert result == \"![a]({}) ![b]({}#_taiga-refresh=issue:{})\".format(\n        IMAGE_1, attachment.attached_file.url, attachment.id)\n    assert logger.warning.call_count == 1\n\n\n@pytest.mark.django_db\ndef test_import_inline_images_keeps_link_when_rendered_html_has_no_image():\n    client = _client({})\n    client.render_markdown.side_effect = None\n    client.render_markdown.return_value = \"<p>nothing</p>\"\n    importer = _importer(client)\n    us = f.UserStoryFactory.create()\n    markdown = \"![a]({})\".format(IMAGE_1)\n\n    with mock.patch(\"taiga.importers.github.importer.logger\") as logger:\n        assert importer._import_inline_images(markdown, us, \"owner/repo\", CREATED_DATE) == markdown\n\n    assert logger.warning.call_count == 1\n    assert not client.download.called\n    assert not Attachment.objects.filter(object_id=us.id).exists()\n\n\ndef _github_issue(number, body):\n    return {\n        \"number\": number,\n        \"title\": \"Issue {}\".format(number),\n        \"body\": body,\n        \"state\": \"open\",\n        \"labels\": [],\n        \"assignee\": None,\n        \"assignees\": [],\n        \"milestone\": None,\n        \"user\": {\"id\": 1},\n        \"html_url\": \"https://github.invalid/owner/repo/issues/{}\".format(number),\n        \"created_at\": CREATED_DATE,\n        \"updated_at\": CREATED_DATE,\n    }\n\n\n@pytest.mark.django_db\n@pytest.mark.parametrize(\"import_type\", [\"user_stories\", \"issues\"])\ndef test_import_data_rewrites_inline_images_in_description(import_type):\n    client = _client({\n        \"11111111-1111-1111-1111-111111111111\": (b\"png\", {\"Content-Type\": \"image/png\"}),\n        \"22222222-2222-2222-2222-222222222222\": Exception(\"expired\"),\n    })\n    issues = [\n        _github_issue(1, \"See ![a]({})\".format(IMAGE_1)),\n        _github_issue(2, \"Broken ![b]({})\".format(IMAGE_2)),\n        _github_issue(3, None),\n    ]\n    client.get.side_effect = lambda path, params=None: issues if path.endswith(\"/issues\") else {}\n    importer = _importer(client)\n    project = f.ProjectFactory.create()\n    if import_type == \"user_stories\":\n        f.UserStoryStatusFactory.create(project=project, slug=\"open\")\n        importer._import_user_stories_data(project, {\"full_name\": \"owner/repo\"}, {})\n        objs = {us.ref: us for us in project.user_stories.all()}\n        typename = \"userstory\"\n    else:\n        f.IssueStatusFactory.create(project=project, slug=\"open\")\n        importer._import_issues_data(project, {\"full_name\": \"owner/repo\"}, {})\n        objs = {issue.ref: issue for issue in project.issues.all()}\n        typename = \"issue\"\n\n    attachment = Attachment.objects.get(object_id=objs[1].id, project=project)\n    assert objs[1].description == \"See ![a]({}#_taiga-refresh={}:{})\".format(\n        attachment.attached_file.url, typename, attachment.id)\n    assert objs[2].description == \"Broken ![b]({})\".format(IMAGE_2)\n    assert objs[3].description == \"\"\n    assert Attachment.objects.filter(project=project).count() == 1\nEOF\n.venv/bin/pytest tests/unit/test_importers_github.py --reuse-db -q 2>&1 | tail -20"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":893,"cache_read_input_tokens":41598,"