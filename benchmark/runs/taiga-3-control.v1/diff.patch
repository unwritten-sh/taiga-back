+    def _import_inline_images(self, markdown, obj, repository_full_name, created_date):
+        if not markdown:
+            return markdown
+
+        for github_url in extract_github_inline_image_urls(markdown):
+            try:
+                local_url = self._import_inline_image(github_url, obj, repository_full_name, created_date)
+            except Exception as e:
+                logger.warning("Unable to import GitHub inline image %s for %s %s: %s",
+                               github_url, obj._meta.model_name, obj.id, e)
+                continue
+            markdown = markdown.replace(github_url, local_url)
+
+        return markdown
+
+    def _import_inline_image(self, github_url, obj, repository_full_name, created_date):
+        html = self._client.render_markdown("![image]({})".format(github_url), repository_full_name)
+        signed_url = _first_img_src(html)
+        if not signed_url:
+            raise ValueError("no <img> found in rendered markdown")
+
+        content, headers = self._client.download(signed_url)
+
+        content_type = (_get_header(headers, "Content-Type") or "").split(";")[0].strip().lower()
+        if not content_type.startswith("image/"):
+            raise ValueError("unexpected content type {!r}".format(content_type))
+
+        name = _filename_from_content_disposition(_get_header(headers, "Content-Disposition"))
+        if not name:
+            asset_id = github_url.rstrip("/").rsplit("/", 1)[-1]
+            name = "github-attachment-{}{}".format(asset_id, mimetypes.guess_extension(content_type) or "")
+
+        attachment = Attachment(
+            owner=obj.owner,
+            project=obj.project,
+            content_type=ContentType.objects.get_for_model(obj),
+            object_id=obj.id,
+            name=name,
+            size=len(content),
+            created_date=created_date,
+            is_deprecated=False,
+        )
+        attachment.attached_file.save(name, ContentFile(content), save=True)
+
+        return "{}#{}".format(attachment.attached_file.url,
+                              attachments_services.generate_refresh_fragment(attachment))
+
