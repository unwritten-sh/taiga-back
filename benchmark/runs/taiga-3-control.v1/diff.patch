+class _FirstImageSrcParser(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.src = None
+
+    def handle_starttag(self, tag, attrs):
+        if self.src is None and tag == "img":
+            self.src = dict(attrs).get("src") or None
+
+    handle_startendtag = handle_starttag
+
+
+def _first_img_src(html):
+    parser = _FirstImageSrcParser()
+    parser.feed(html or "")
+    parser.close()
+    return parser.src
+
+
+def _get_header(headers, name):
+    for key, value in (headers or {}).items():
+        if key.lower() == name.lower():
+            return value
+    return None
+
+
+def _filename_from_content_disposition(value):
+    if not value:
+        return None
+    message = Message()
+    message["Content-Disposition"] = value
+    filename = message.get_filename()
+    if not filename:
+        return None
+    filename = os.path.basename(filename.replace("\\", "/")).strip()
+    if filename in ("", ".", ".."):
+        return None
+    return filename
+
