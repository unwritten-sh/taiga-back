+# Inline images import
+
+from taiga.importers.github.importer import GithubImporter  # noqa: E402
+from taiga.projects.attachments.models import Attachment  # noqa: E402
+
+from tests import factories as f  # noqa: E402
+
+
+IMAGE_1 = "https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111"
+IMAGE_2 = "https://github.com/user-attachments/assets/22222222-2222-2222-2222-222222222222"
+CREATED_DATE = "2026-01-02T03:04:05Z"
+
+
+def _importer(client):
+    with mock.patch("taiga.importers.github.importer.GithubClient") as GithubClientMock:
+        GithubClientMock.return_value = client
+        importer = GithubImporter(f.UserFactory.create(), "oauth-token")
+    return importer
+
+
+def _client(downloads):
+    """downloads maps the github url to (content, headers) or an Exception."""
+    client = mock.Mock()
+    client.get.return_value = {}
+
+    def render_markdown(markdown, repository_full_name):
+        url = markdown[len("![image]("):-1]
+        return '<p><a href="x"><img src="https://signed.invalid/{}?jwt=t" alt="image"></a></p>'.format(
+            url.rsplit("/", 1)[-1])
+
+    def download(url):
+        asset_id = url.split("/")[-1].split("?")[0]
+        result = downloads[asset_id]
+        if isinstance(result, Exception):
+            raise result
+        return result
+
+    client.render_markdown.side_effect = render_markdown
+    client.download.side_effect = download
+    return client
+
+
+@pytest.mark.django_db
+def test_import_inline_images_creates_attachments_and_rewrites_urls():
+    client = _client({
+        "11111111-1111-1111-1111-111111111111": (
+            b"png-bytes", {"Content-Type": "image/png",
+                           "Content-Disposition": 'attachment; filename="../dir/screenshot.png"'}),
+        "22222222-2222-2222-2222-222222222222": (b"jpeg", {"content-type": "image/jpeg; charset=binary"}),
+    })
+    importer = _importer(client)
+    us = f.UserStoryFactory.create()
+    markdown = "![a]({0})\ntext ![b]({0}) <img src=\"{1}\" />".format(IMAGE_1, IMAGE_2)
+
+    result = importer._import_inline_images(markdown, us, "owner/repo", CREATED_DATE)
+
+    attachments = list(Attachment.objects.filter(object_id=us.id).order_by("id"))
+    assert len(attachments) == 2
+    first, second = attachments
+    assert first.name == "screenshot.png"
+    assert first.size == len(b"png-bytes")
+    assert first.owner == us.owner
+    assert first.project == us.project
+    assert first.content_object == us
+    assert first.is_deprecated is False
+    assert first.created_date.isoformat() == "2026-01-02T03:04:05+00:00"
+    assert first.attached_file.read() == b"png-bytes"
+    assert second.name == "github-attachment-22222222-2222-2222-2222-222222222222.jpg"
+
+    url_1 = "{}#_taiga-refresh=userstory:{}".format(first.attached_file.url, first.id)
+    url_2 = "{}#_taiga-refresh=userstory:{}".format(second.attached_file.url, second.id)
+    assert result == "![a]({0})\ntext ![b]({0}) <img src=\"{1}\" />".format(url_1, url_2)
+    assert "github.com" not in result
+    # Each distinct URL is rendered and downloaded once
+    assert client.render_markdown.call_count == 2
+    client.render_markdown.assert_any_call("![image]({})".format(IMAGE_1), "owner/repo")
+    assert client.download.call_count == 2
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize("failure", [
+    Exception("download failed"),
+    (b"<html></html>", {"Content-Type": "text/html"}),
+    (b"no content type", {}),
+])
+def test_import_inline_images_keeps_link_of_failed_image(failure):
+    client = _client({
+        "11111111-1111-1111-1111-111111111111": failure,
+        "22222222-2222-2222-2222-222222222222": (b"png", {"Content-Type": "image/png"}),
+    })
+    importer = _importer(client)
+    issue = f.IssueFactory.create()
+    markdown = "![a]({}) ![b]({})".format(IMAGE_1, IMAGE_2)
+
+    with mock.patch("taiga.importers.github.importer.logger") as logger:
+        result = importer._import_inline_images(markdown, issue, "owner/repo", CREATED_DATE)
+
+    attachment = Attachment.objects.get(object_id=issue.id)
+    assert attachment.name == "github-attachment-22222222-2222-2222-2222-222222222222.png"
+    assert result == "![a]({}) ![b]({}#_taiga-refresh=issue:{})".format(
+        IMAGE_1, attachment.attached_file.url, attachment.id)
+    assert logger.warning.call_count == 1
+
+
+@pytest.mark.django_db
+def test_import_inline_images_keeps_link_when_rendered_html_has_no_image():
