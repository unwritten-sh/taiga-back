+def _github_issue(number, body):
+    return {
+        "number": number,
+        "title": "Issue {}".format(number),
+        "body": body,
+        "state": "open",
+        "labels": [],
+        "assignee": None,
+        "assignees": [],
+        "milestone": None,
+        "user": {"id": 1},
+        "html_url": "https://github.invalid/owner/repo/issues/{}".format(number),
+        "created_at": CREATED_DATE,
+        "updated_at": CREATED_DATE,
+    }
+
