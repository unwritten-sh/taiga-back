+@pytest.mark.django_db
+@pytest.mark.parametrize("import_type", ["user_stories", "issues"])
+def test_import_data_rewrites_inline_images_in_description(import_type):
+    client = _client({
+        "11111111-1111-1111-1111-111111111111": (b"png", {"Content-Type": "image/png"}),
+        "22222222-2222-2222-2222-222222222222": Exception("expired"),
+    })
+    issues = [
+        _github_issue(1, "See ![a]({})".format(IMAGE_1)),
+        _github_issue(2, "Broken ![b]({})".format(IMAGE_2)),
+        _github_issue(3, None),
+    ]
+    client.get.side_effect = lambda path, params=None: issues if path.endswith("/issues") else {}
+    importer = _importer(client)
+    project = f.ProjectFactory.create()
+    if import_type == "user_stories":
+        f.UserStoryStatusFactory.create(project=project, name="Open")
+        importer._import_user_stories_data(project, {"full_name": "owner/repo"}, {})
+        objs = {us.ref: us for us in project.user_stories.all()}
+        typename = "userstory"
+    else:
+        f.IssueStatusFactory.create(project=project, name="Open")
+        importer._import_issues_data(project, {"full_name": "owner/repo"}, {})
+        objs = {issue.ref: issue for issue in project.issues.all()}
+        typename = "issue"
+
+    attachment = Attachment.objects.get(object_id=objs[1].id, project=project)
+    assert objs[1].description == "See ![a]({}#_taiga-refresh={}:{})".format(
+        attachment.attached_file.url, typename, attachment.id)
+    assert objs[2].description == "Broken ![b]({})".format(IMAGE_2)
+    assert objs[3].description == ""
+    assert Attachment.objects.filter(project=project).count() == 1
